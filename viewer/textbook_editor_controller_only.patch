+# frozen_string_literal: true
+
+# Textbook lesson authoring UI.
+#
+# This is intentionally file-backed (YAML) so you can iterate quickly without DB migrations.
+# Later, if you want, lessons can be moved into the database while keeping the same block schema.
+#
+class TextbookEditorController < ApplicationController
+  layout "application"
+
+  # GET /textbook/editor
+  def index
+    @lessons = Textbook::LessonStore.all.sort_by { |l| l["title"].to_s }
+  end
+
+  # GET /textbook/editor/new
+  def new
+    @lesson = {
+      "schema_version" => 1,
+      "title" => "",
+      "slug" => "",
+      "summary" => "",
+      "blocks" => []
+    }
+    render :edit
+  end
+
+  # GET /textbook/editor/:slug/edit
+  def edit
+    @lesson = Textbook::LessonStore.find!(params[:slug])
+  end
+
+  # POST /textbook/editor
+  def create
+    lesson = lesson_from_params
+    Textbook::LessonStore.write!(lesson)
+    redirect_to textbook_editor_path, notice: "Lesson created."
+  rescue StandardError => e
+    @lesson = lesson
+    flash.now[:alert] = "Could not create lesson: #{e.message}"
+    render :edit, status: :unprocessable_entity
+  end
+
+  # PATCH /textbook/editor/:slug
+  def update
+    lesson = lesson_from_params
+    lesson["slug"] = params[:slug] if lesson["slug"].blank?
+    Textbook::LessonStore.write!(lesson)
+    redirect_to edit_textbook_lesson_path(lesson["slug"]), notice: "Lesson saved."
+  rescue StandardError => e
+    @lesson = lesson
+    flash.now[:alert] = "Could not save lesson: #{e.message}"
+    render :edit, status: :unprocessable_entity
+  end
+
+  # POST /textbook/editor/preview
+  # Renders the lesson using the normal textbook show template, without saving.
+  def preview
+    @lesson = lesson_from_params
+    # Reuse the normal renderer (TextbookController#show view expects @lesson).
+    render template: "textbook/show", layout: "application"
+  rescue StandardError => e
+    @lesson = lesson_from_params rescue {}
+    flash.now[:alert] = "Could not preview lesson: #{e.message}"
+    render :edit, status: :unprocessable_entity
+  end
+
+  private
+
+  # Build the canonical lesson hash from form params.
+  #
+  # Params shape:
+  # lesson[title], lesson[slug], lesson[summary]
+  # lesson[blocks][0][type], ...
+  #
+  def lesson_from_params
+    raw = params.require(:lesson).permit(
+      :schema_version, :title, :slug, :summary,
+      blocks: [
+        :type, :title, :prompt, :text, :text_ref,
+        :show_profile_picker,
+        { profiles: [:format, :parse] },
+        :grid_tsv,
+        { cards: [:title, :body] },
+        :min, :max, :profile, :parse_profile
+      ]
+    ).to_h
+
+    raw["schema_version"] = (raw["schema_version"].presence || 1).to_i
+    raw["title"] = raw["title"].to_s
+    raw["slug"] = raw["slug"].to_s
+    raw["summary"] = raw["summary"].to_s
+
+    raw["blocks"] = Array(raw["blocks"]).map do |b|
+      b = b.to_h
+      b["type"] = b["type"].to_s
+      b
+    end
+
+    raw
+  end
+end
diff --git a/app/views/textbook_editor/index.html.erb b/app/views/textbook_editor/index.html.erb
