@@ -0,0 +1,54 @@
+<div class="tb-editor">
+  <h1>Textbook editor</h1>
+
+  <p class="tb-muted">
+    Create and edit textbook lessons. Lessons are stored as YAML under <code>config/textbook/lessons/</code>.
+  </p>
+
+  <p>
+    <%= link_to "New lesson", new_textbook_lesson_path, class: "tb-btn" %>
+    <%= link_to "Back to textbook", textbook_path, class: "tb-btn tb-btn-secondary" %>
+  </p>
+
+  <% if @lessons.blank? %>
+    <p>No lessons found.</p>
+  <% else %>
+    <table class="tb-table">
+      <thead>
+        <tr>
+          <th>Title</th>
+          <th>Slug</th>
+          <th></th>
+        </tr>
+      </thead>
+      <tbody>
+        <% @lessons.each do |lesson| %>
+          <tr>
+            <td><%= lesson["title"] %></td>
+            <td><code><%= lesson["slug"] %></code></td>
+            <td style="white-space:nowrap">
+              <%= link_to "Edit", edit_textbook_lesson_path(lesson["slug"]), class: "tb-btn tb-btn-small" %>
+              <%= link_to "View", textbook_lesson_path(lesson["slug"]), class: "tb-btn tb-btn-small tb-btn-secondary" %>
+            </td>
+          </tr>
+        <% end %>
+      </tbody>
+    </table>
+  <% end %>
+</div>
diff --git a/app/views/textbook_editor/edit.html.erb b/app/views/textbook_editor/edit.html.erb
new file mode 100644
index 0000000..b83beed
--- /dev/null
+++ b/app/views/textbook_editor/edit.html.erb
@@ -0,0 +1,186 @@
+<div class="tb-editor">
+  <h1><%= @lesson["slug"].present? ? "Edit lesson" : "New lesson" %></h1>
+
+  <% if flash[:alert].present? %>
+    <div class="tb-alert"><%= flash[:alert] %></div>
+  <% end %>
+
+  <%= form_with url: (@lesson["slug"].present? ? update_textbook_lesson_path(@lesson["slug"]) : create_textbook_lesson_path),
+                method: (@lesson["slug"].present? ? :patch : :post),
+                scope: :lesson,
+                local: true do |f| %>
+
+    <%= f.hidden_field :schema_version, value: (@lesson["schema_version"] || 1) %>
+
+    <div class="tb-form-row">
+      <%= f.label :title, "Title", class: "tb-label" %>
+      <%= f.text_field :title, value: @lesson["title"], class: "tb-input" %>
+    </div>
+
+    <div class="tb-form-row">
+      <%= f.label :slug, "Slug", class: "tb-label" %>
+      <%= f.text_field :slug, value: @lesson["slug"], class: "tb-input", placeholder: "zhouli_numbers" %>
+      <div class="tb-muted">Used in the URL: <code>/textbook/&lt;slug&gt;</code></div>
+    </div>
+
+    <div class="tb-form-row">
+      <%= f.label :summary, "Summary", class: "tb-label" %>
+      <%= f.text_area :summary, value: @lesson["summary"], class: "tb-input", rows: 3 %>
+    </div>
+
+    <h2>Blocks</h2>
+    <p class="tb-muted">
+      This editor is intentionally minimal. Add blocks by editing YAML if needed for now; the block builder UI comes next.
+    </p>
+
+    <div class="tb-form-row">
+      <%= f.submit "Save lesson", class: "tb-btn" %>
+      <%= button_to "Preview (no save)", preview_textbook_lesson_path, params: { lesson: @lesson }, method: :post, class: "tb-btn tb-btn-secondary" %>
+      <%= link_to "Back", textbook_editor_path, class: "tb-btn tb-btn-secondary" %>
+    </div>
+  <% end %>
+</div>
