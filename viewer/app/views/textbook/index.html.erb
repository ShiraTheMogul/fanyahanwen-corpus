<% content_for :head do %>
  <%= stylesheet_link_tag "textbook", "data-turbo-track": "reload" %>
<% end %>

<div class="tb-page">
  <div class="tb-header">
    <h1>Textbook</h1>
    <% if !Rails.env.production? || ENV["ENABLE_TEXTBOOK_EDITOR"].to_s == "1" %>
      <div class="tb-actions">
        <%= link_to "Author lessons", textbook_editor_path, class: "tb-btn" %>
      </div>
    <% end %>
  </div>

  <div class="tb-lesson-list">
    <% @lessons.each do |l| %>
      <div class="tb-lesson-card">
        <h2><%= link_to l["title"].presence || l["slug"], textbook_lesson_path(slug: l["slug"]) %></h2>
        <% if l["summary"].present? %>
          <p class="tb-muted"><%= l["summary"] %></p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
