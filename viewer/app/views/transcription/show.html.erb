<%= stylesheet_link_tag "transcription", "data-turbo-track": "reload" %>

<div class="transcription-page"
     data-controller="transcription"
     data-transcription-variants-value="<%= json_escape(@variant_equivalents.to_json) %>"
     style="--transcription-past:#b4232c; --transcription-future:#245aa5;">
  <h1>Transcription practice</h1>

  <p>
    Type the highlighted character using your normal browser/system input method. In “Your input method” mode the site does not decide whether a character is supported: that is entirely up to your browser, operating system, and IME.
    Cangjie 5 and Wubi86 are optional dictionary-backed code helpers. Punctuation and spacing are stripped from the exercise entirely.
  </p>

  <div class="transcription-stage" data-transcription-target="stage">
    <div class="transcription-focus-viewport">
      <div class="transcription-focus-track" data-transcription-target="track"></div>
    </div>

    <div class="transcription-full-text" data-transcription-target="fullText" hidden></div>
  </div>

  <div class="transcription-input-row">
    <label for="transcription-input">Input</label>
    <input id="transcription-input"
           type="text"
           autocomplete="off"
           autocapitalize="off"
           spellcheck="false"
           data-transcription-target="input"
           data-action="compositionstart->transcription#compositionStart compositionend->transcription#compositionEnd input->transcription#input keydown->transcription#keydown">

    <select aria-label="Input method"
            data-transcription-target="inputMethod"
            data-action="change->transcription#inputMethodChanged">
      <option value="native">Your input method</option>
      <% if @rime_schemas.any? %>
        <optgroup label="Optional code helpers (RIME dictionary data)">
          <% @rime_schemas.each do |schema| %>
            <option value="rime-data:<%= schema.fetch("schema_id") %>"><%= schema.fetch("label") %> code helper</option>
          <% end %>
        </optgroup>
      <% end %>
    </select>

    <label class="transcription-rime-options" data-transcription-target="rimeOptions" hidden>
      <input type="checkbox"
             data-transcription-target="showCandidates"
             data-action="change->transcription#revealCandidatesChanged">
      Reveal candidates
    </label>

    <button type="button" data-transcription-target="skipButton" data-action="transcription#skip">Skip (-10)</button>
    <span data-transcription-target="score"></span>
  </div>

  <div class="transcription-candidates" data-transcription-target="candidates" aria-live="polite"></div>
  <p class="transcription-status" data-transcription-target="status" aria-live="polite"></p>

  <section class="transcription-report" data-transcription-target="report" hidden>
    <h2>Learning report</h2>
    <div data-transcription-target="reportBody"></div>
    <button type="button" data-action="transcription#practiceDifficult">Practice difficult characters</button>
    <button type="button" data-action="transcription#restart">Try again</button>
  </section>

  <details class="transcription-setup">
    <summary>Exercise settings</summary>

    <label for="transcription-title">Text name</label>
    <input id="transcription-title" type="text" value="<%= @title %>" data-transcription-target="title">

    <label for="transcription-source">Text</label>
    <textarea id="transcription-source" rows="5" data-transcription-target="source"><%= @text %></textarea>

    <div class="transcription-settings-grid">
      <label>
        Presentation
        <select data-transcription-target="viewMode" data-action="transcription#settingsChanged">
          <option value="focus">Focus scrolling</option>
          <option value="full">Full text</option>
        </select>
      </label>

      <label>
        Direction
        <select data-transcription-target="direction" data-action="transcription#settingsChanged">
          <option value="horizontal">Horizontal</option>
          <option value="vertical">Vertical</option>
        </select>
      </label>

      <label>
        Visible characters
        <input type="number" min="1" max="40" value="7" data-transcription-target="windowSize" data-action="input->transcription#settingsChanged">
      </label>

      <label>
        Variants
        <select data-transcription-target="variantMode" data-action="transcription#restart">
          <option value="canonical">Canonical corpus / variant text</option>
          <option value="accept">Accept variants</option>
          <option value="scramble">Variant Scramble</option>
        </select>
      </label>
    </div>

    <fieldset>
      <legend>Challenge</legend>
      <label><input type="checkbox" data-transcription-target="hard" data-action="transcription#restart"> Hard Mode — no skip</label>
      <label><input type="checkbox" data-transcription-target="zen" data-action="transcription#settingsChanged"> Zen 禪 Mode — hide live score</label>
    </fieldset>

    <fieldset>
      <legend>Visual accommodation</legend>
      <label>Past <input type="color" value="#b4232c" data-transcription-target="pastColor" data-action="input->transcription#settingsChanged"></label>
      <label>Future <input type="color" value="#245aa5" data-transcription-target="futureColor" data-action="input->transcription#settingsChanged"></label>
      <label><input type="checkbox" checked data-transcription-target="fade" data-action="transcription#settingsChanged"> Fade past/future text</label>
    </fieldset>

    <button type="button" data-action="transcription#start">Apply settings / restart</button>
  </details>
</div>
