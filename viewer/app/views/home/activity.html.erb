<h1><%= t("home.activity.title") %></h1>

<p><%= t("home.activity.introduction") %></p>

<nav class="corpus-activity-tabs" aria-label="<%= t("home.activity.tabs_aria") %>">
  <%= link_to t("home.activity.latest_texts"),
              corpus_activity_href(kind: "latest_texts"),
              class: ["corpus-activity-tab", ("is-active" if @activity_kind == "latest_texts")] %>
  <%= link_to t("home.activity.recent_changes"),
              corpus_activity_href(kind: "recent_changes"),
              class: ["corpus-activity-tab", ("is-active" if @activity_kind == "recent_changes")] %>
</nav>

<% if @activity_kind == "latest_texts" %>
  <h2><%= t("home.activity.latest_heading") %></h2>
  <p class="corpus-activity-explanation"><%= t("home.activity.latest_explanation") %></p>
<% else %>
  <h2><%= t("home.activity.recent_heading") %></h2>
  <p class="corpus-activity-explanation"><%= t("home.activity.recent_explanation_html") %></p>
<% end %>

<p class="corpus-activity-total"><%= t("home.activity.entry_count", count: @activity_feed["total"]) %></p>

<% if @activity_feed["items"].empty? %>
  <p><%= t("home.activity.empty") %></p>
<% else %>
  <ol class="corpus-activity-audit-list" start="<%= ((@activity_feed["page"] - 1) * @activity_feed["page_size"]) + 1 %>">
    <% @activity_feed["items"].each do |item| %>
      <li>
        <div class="corpus-activity-audit-heading">
          <% if @activity_kind == "latest_texts" %>
            <%= link_to item["title"], corpus_activity_viewer_path(item["path"]), class: "corpus-activity-title" %>
            <span><%= t("home.activity.file_count", count: item["file_count"]) %></span>
          <% else %>
            <%= link_to item["title"], corpus_activity_viewer_path(item["path"]), class: "corpus-activity-title" %>
            <span><%= t("home.activity.in_work_html", work: link_to(item["work_title"], corpus_activity_viewer_path(item["work_path"]))) %></span>
          <% end %>
        </div>

        <div class="corpus-activity-audit-meta">
          <% context = corpus_activity_context(item) %>
          <% if context.present? %><span><%= context %></span><% end %>
          <span><%= corpus_activity_time(item["changed_at"]) %></span>
          <% if @activity_kind == "recent_changes" %>
            <span><%= number_to_human_size(item["size"]) %></span>
            <code><%= item["display_path"] %></code>
          <% else %>
            <code><%= item["path"] %></code>
          <% end %>
        </div>
      </li>
    <% end %>
  </ol>
<% end %>

<% total_pages = @activity_feed["total_pages"].to_i %>
<% current_page = @activity_feed["page"].to_i %>
<% if total_pages > 1 %>
  <nav class="corpus-activity-pagination" aria-label="<%= t("home.activity.pagination_aria") %>">
    <% if current_page > 1 %>
      <%= link_to t("home.activity.previous"), corpus_activity_href(kind: @activity_kind, page: current_page - 1), rel: "prev" %>
    <% else %>
      <span aria-disabled="true"><%= t("home.activity.previous") %></span>
    <% end %>

    <span><%= t("home.activity.page_of", page: number_with_delimiter(current_page), pages: number_with_delimiter(total_pages)) %></span>

    <% if current_page < total_pages %>
      <%= link_to t("home.activity.next"), corpus_activity_href(kind: @activity_kind, page: current_page + 1), rel: "next" %>
    <% else %>
      <span aria-disabled="true"><%= t("home.activity.next") %></span>
    <% end %>
  </nav>
<% end %>
