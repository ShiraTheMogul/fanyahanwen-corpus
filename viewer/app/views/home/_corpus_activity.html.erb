<% if @corpus_activity&.available? %>
  <% latest_feed = @corpus_activity_summary.dig("feeds", "latest_texts") || {} %>
  <% recent_feed = @corpus_activity_summary.dig("feeds", "recent_changes") || {} %>
  <% activity_id_prefix = local_assigns.fetch(:activity_id_prefix, "corpus-activity") %>
  <% activity_variant = local_assigns[:activity_variant].to_s %>
  <% activity_classes = ["corpus-activity-home"] %>
  <% activity_classes << "corpus-activity-home--browser" if activity_variant == "browser" %>
  <% latest_heading_id = "#{activity_id_prefix}-latest-texts-heading" %>
  <% recent_heading_id = "#{activity_id_prefix}-recent-changes-heading" %>

  <section class="<%= activity_classes.join(" ") %>" aria-label="<%= t("home.corpus_activity.aria_label") %>">
    <div class="corpus-activity-columns">
      <section class="corpus-activity-panel" aria-labelledby="<%= latest_heading_id %>">
        <div class="corpus-activity-panel-heading">
          <h3 id="<%= latest_heading_id %>"><%= t("home.corpus_activity.latest_texts") %></h3>
          <%= link_to t("home.corpus_activity.all_text_folders"), corpus_activity_href(kind: "latest_texts") %>
        </div>

        <div class="corpus-activity-flow" role="list">
          <% Array(latest_feed["items"]).each do |item| %>
            <span class="corpus-activity-flow-item" role="listitem">
              <%= link_to item["title"], corpus_activity_viewer_path(item["path"]), class: "corpus-activity-title" %>
              <% if item["file_count"].to_i > 1 %>
                <span class="corpus-activity-count">(<%= pluralize(item["file_count"], "file") %>)</span>
              <% end %>
            </span>
          <% end %>
        </div>
      </section>

      <section class="corpus-activity-panel" aria-labelledby="<%= recent_heading_id %>">
        <div class="corpus-activity-panel-heading">
          <h3 id="<%= recent_heading_id %>"><%= t("home.corpus_activity.recent_changes") %></h3>
          <%= link_to t("home.corpus_activity.all_changed_files"), corpus_activity_href(kind: "recent_changes") %>
        </div>

        <div class="corpus-activity-flow" role="list">
          <% Array(recent_feed["items"]).each do |item| %>
            <span class="corpus-activity-flow-item" role="listitem">
              <%= link_to item["title"], corpus_activity_viewer_path(item["path"]), class: "corpus-activity-title" %>
              <% if item["work_title"].present? && item["work_title"] != item["title"] %>
                <span class="corpus-activity-work">(<%= link_to item["work_title"], corpus_activity_viewer_path(item["work_path"]) %>)</span>
              <% end %>
            </span>
          <% end %>
        </div>
      </section>
    </div>

    <div class="corpus-activity-heading-row">
      <%= link_to t("home.corpus_activity.browse_all"), corpus_activity_href(kind: "recent_changes"), class: "corpus-activity-all-link" %>
    </div>
  </section>
<% end %>
