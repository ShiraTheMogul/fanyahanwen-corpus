<h1>Guangyun 廣韻</h1>

<p>
  This page is a sanity-check for the Guangyun importer. It displays what is stored in
  <code>character_properties</code> for source <code>Guangyun (Siku)</code>. There are <strong><%= @counts[:total_rows] %></strong> rows in the database with <strong><%= @counts[:characters_with_payloads] %></strong> characters. It will become a proper browser eventually.
</p>

<p>
  This is currently really scuffed and will get better eventually. 
</p>

<%= form_with url: dictionary_guangyun_path, method: :get, local: true do |f| %>
  <label for="query">Character / Codepoint</label>
  <%= f.text_field :query, value: @query, id: "query", size: 40 %>
  <%= f.submit "Lookup" %>
<% end %>

<hr>

<% if @codepoint.nil? %>
  <p>Enter a character (e.g. 王) or a codepoint (e.g. U+738B) to inspect its Guangyun rows.</p>
<% else %>
  <h2><%= @codepoint.chr %> (<%= "U+%04X" % @codepoint.codepoint %>, id=<%= @codepoint.id %>)</h2>

  <% if @entries.empty? %>
    <p>No Guangyun rows for this character.</p>
  <% else %>
    <table class="dictionary-table">
      <thead>
        <tr>
          <th>Fanqie</th>
          <th>Definition</th>
          <th>Raw payload</th>
        </tr>
      </thead>
      <tbody>
        <% @entries.each do |row| %>
          <tr>
            <td class="cell-fanqie"><%= row[:fanqie].presence || "—" %></td>
            <td class="cell-definition"><%= row[:definition].presence || "—" %></td>
            <td class="cell-raw"><%= row[:raw_payload].presence || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <p>
      Tip: if you see <code>切</code> inside the <em>definition</em> column for a row, that row probably did not split correctly.
    </p>
  <% end %>
<% end %>
