<h1>
  <% if show_han_ornament? %><%= t("fun.xuanji.name_han") %> <% end %><%= translated_interface_label("fun.xuanji.name", ornament_key: "fun.xuanji.name_han") %>
</h1>

<p><%= t("fun.xuanji.description") %></p>

<div class="xuanji-toolbar">
  <div class="xuanji-variant">
    <strong><%= t("fun.xuanji.variant") %>:</strong>
    <%= link_to t("fun.xuanji.traditional"), xuanji_path(variant: "trad"), class: (@variant == "trad" ? "active" : "") %>
    <%= link_to t("fun.xuanji.simplified"), xuanji_path(variant: "simp"), class: (@variant == "simp" ? "active" : "") %>
  </div>
</div>

<%#
  The simplified grid is DERIVED from the traditional one at display time, with
  OpenCC t2s, one cell at a time. If libopencc is not reachable the conversion
  returns its input unchanged, and the "simplified" grid would silently be the
  traditional one — a failure that looks like a data problem for weeks. So the
  controller detects it and this says so.
%>
<% if @simplification_unavailable %>
  <p class="xuanji-warning">
    <%= t("fun.xuanji.errors.simplification_unavailable",
          default: "Simplified conversion is unavailable here, so this is the " \
                   "traditional grid. OpenCC (libopencc) could not be reached.") %>
  </p>
<% end %>

<div
  data-controller="xuanji"
  data-xuanji-variant-value="<%= @variant %>"
  data-xuanji-cells-value='<%= raw @cells_json %>'
  data-xuanji-width-value="<%= @grid.width %>"
  data-xuanji-height-value="<%= @grid.height %>"
