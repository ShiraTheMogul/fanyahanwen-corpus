<h1>
  <% if show_han_ornament? %><%= t("fun.xuanji.name_han") %> <% end %><%= translated_interface_label("fun.xuanji.name", ornament_key: "fun.xuanji.name_han") %>
</h1>

<p><%= t("fun.xuanji.description") %></p>

<div class="xuanji-toolbar">
  <div class="xuanji-variant">
    <strong><%= t("fun.xuanji.variant") %>:</strong>
    <%= link_to t("fun.xuanji.traditional"), xuanji_path(variant: "trad"), class: (@variant == "trad" ? "active" : "") %>
    <%= link_to t("fun.xuanji.simplified"), xuanji_path(variant: "simp"), class: (@variant == "simp" ? "active" : "") %>
  </div>
</div>

<div
  data-controller="xuanji"
  data-xuanji-variant-value="<%= @variant %>"
  data-xuanji-cells-value='<%= raw @cells_json %>'
  data-xuanji-width-value="<%= @grid.width %>"
  data-xuanji-height-value="<%= @grid.height %>"
>
  <%= render "rightbar" %>

  <div class="xuanji-controls">
    <% rules = [
      [t("fun.xuanji.rules.manual"), "manual"],
      [t("fun.xuanji.rules.rows_lr"), "rows_lr"],
      [t("fun.xuanji.rules.rows_rl"), "rows_rl"],
      [t("fun.xuanji.rules.cols_tb"), "cols_tb"],
      [t("fun.xuanji.rules.cols_bt"), "cols_bt"],
      [t("fun.xuanji.rules.snake_rows"), "snake_rows"],
      [t("fun.xuanji.rules.snake_cols"), "snake_cols"],
      [t("fun.xuanji.rules.kang_perimeter"), "kang_perimeter"],
      [t("fun.xuanji.rules.kang_boundary"), "kang_boundary"]
    ] %>

    <label>
      <%= t("fun.xuanji.controls.rule") %>
      <%= select_tag :rule,
            options_for_select(rules, @initial_rule || "rows_lr"),
            data: { xuanji_target: "rule", action: "change->xuanji#ruleChanged" } %>
    </label>

    <label>
      <%= t("fun.xuanji.controls.line_length") %>
      <input type="number" min="1" max="29" value="<%= @initial_line_len || 7 %>" data-xuanji-target="lineLen" data-action="input->xuanji#ruleChanged">
    </label>

    <label>
      <%= t("fun.xuanji.controls.speed_ms") %>
      <input type="number" min="10" max="2000" value="<%= @initial_speed || 40 %>" data-xuanji-target="speed">
    </label>

    <label>
      <%= t("fun.xuanji.controls.couplets_comma") %>
      <input type="checkbox" data-xuanji-target="coupletComma" data-action="change->xuanji#ruleChanged">
    </label>

    <label>
      <%= t("fun.xuanji.controls.show_phoneticization") %>
      <input type="checkbox" data-xuanji-target="showPhon" data-action="change->xuanji#phonSettingsChanged">
    </label>

    <label>
      <%= t("fun.xuanji.controls.reading_system") %>
      <select data-xuanji-target="readingSystem" data-action="change->xuanji#phonSettingsChanged">
        <option value="mandarin"><%= t("fun.xuanji.readings.mandarin") %></option>
        <option value="cantonese"><%= t("fun.xuanji.readings.cantonese") %></option>
        <option value="tang"><%= t("fun.xuanji.readings.tang") %></option>
        <option value="fanqie"><%= t("fun.xuanji.readings.fanqie") %></option>
      </select>
    </label>

    <button type="button" data-action="xuanji#play" data-xuanji-target="playBtn"><%= t("fun.actions.play") %></button>
    <button type="button" data-action="xuanji#pause"><%= t("fun.actions.pause") %></button>
    <button type="button" data-action="xuanji#step"><%= t("fun.actions.step") %></button>
    <button type="button" data-action="xuanji#reset"><%= t("fun.actions.reset") %></button>
    <button type="button" data-action="xuanji#clearManual" data-xuanji-target="clearManualBtn"><%= t("fun.xuanji.controls.clear_manual") %></button>
  </div>

  <div class="xuanji-main">
    <div class="xuanji-gridwrap">
      <% cell_size = 22 %>
      <% pad = 10 %>
      <% w = pad*2 + cell_size*@grid.width %>
      <% h = pad*2 + cell_size*@grid.height %>

      <svg
        class="xuanji-svg"
        viewBox="0 0 <%= w %> <%= h %>"
        width="<%= w %>"
        height="<%= h %>"
        aria-label="<%= t("fun.xuanji.grid_aria") %>"
        data-action="pointerdown->xuanji#pointerDown pointermove->xuanji#pointerMove pointerup->xuanji#pointerUp pointercancel->xuanji#pointerUp"
      >
        <% indexed = @grid.xuanji_cells.index_by { |c| [c.x, c.y] } %>
        <% @grid.height.times do |y| %>
          <% @grid.width.times do |x| %>
            <% c = indexed.fetch([x,y]) %>
            <% canonical_color =
              case c.color
              when "red", "maroon" then "red"
              when "black" then "black"
              when "blue", "navy", "teal" then "blue"
              when "yellow", "olive" then "yellow"
              when "purple" then "purple"
              else nil
              end
            %>
            <% fill = canonical_color ? "var(--xuanji-#{canonical_color})" : "#333333" %>
            <% rx = pad + x*cell_size %>
            <% ry = pad + y*cell_size %>

            <g class="xuanji-cell" data-x="<%= x %>" data-y="<%= y %>">
              <rect class="xuanji-rect" id="xuanji-rect-<%= x %>-<%= y %>" x="<%= rx %>" y="<%= ry %>" width="<%= cell_size %>" height="<%= cell_size %>" />
              <text class="xuanji-text" id="xuanji-text-<%= x %>-<%= y %>" x="<%= rx + cell_size*0.5 %>" y="<%= ry + cell_size*0.75 %>" text-anchor="middle" fill="<%= fill %>"><%= c.char %></text>
            </g>
          <% end %>
        <% end %>
      </svg>
    </div>

    <div class="xuanji-output">
      <h2><%= t("fun.xuanji.extracted_text") %></h2>
      <div class="corpus-reader" data-controller="corpus-reader" data-corpus-reader-target="viewbox">
        <pre data-xuanji-target="output" data-corpus-reader-target="content"></pre>
      </div>
    </div>
  </div>
</div>
