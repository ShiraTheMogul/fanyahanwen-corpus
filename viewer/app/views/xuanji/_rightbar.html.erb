<% content_for :rightbar do %>
  <details class="rightbar-section rightbar-group" open data-controller="xuanji-rightbar">
    <summary class="rightbar-summary"><strong><%= t("fun.xuanji.rightbar.title") %></strong></summary>

    <div class="rightbar-row">
      <label for="xj_strip"><%= t("fun.xuanji.rightbar.remove_punctuation") %></label>
      <input id="xj_strip" type="checkbox"
             data-xuanji-rightbar-target="strip"
             data-action="change->xuanji-rightbar#change">
    </div>

    <p class="rightbar-note"><%= t("fun.xuanji.rightbar.note") %></p>
  </details>

  <%= render "shared/view_options_rightbar" %>
<% end %>
