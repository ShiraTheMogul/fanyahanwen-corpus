<% content_for :title, t("dictionary.kangxi.title") %>

<% content_for :rightbar do %>
  <h3><%= t("view_options.heading") %></h3>
  <%= render "shared/view_options_rightbar" %>
<% end %>

<h1><%= t("dictionary.kangxi.title") %></h1>

<p>
  <%= t("dictionary.kangxi.browse_intro_html", field: tag.code("kRSUnicode")) %>
</p>

<p>
  <%= t("dictionary.kangxi.history_html") %>
</p>

<p>
  <%= t("dictionary.kangxi.comparison") %>
</p>

<div class="kangxi-radicals-grid">
  <% @radicals.each do |r| %>
    <%= link_to "/dictionary/radicals/#{r.number}",
      class: "kangxi-radical-card",
      data: { turbo: false, turbo_prefetch: false } do %>

      <div class="kx-glyph"><%= r.radical %></div>
      <div class="kx-num"><%= r.number %></div>

    <% end %>
  <% end %>
</div>

<style>
  .kangxi-radicals-grid{
    display:grid;
    grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));
    gap: 10px;
    margin-top: 14px;
  }
  .kangxi-radical-card{
    display:flex;
    flex-direction: column;
    align-items:center;
    justify-content:center;
    padding: 10px 8px 8px 8px;
    border: 1px solid rgba(0,0,0,0.18);
    border-radius: 12px;
    text-decoration:none;
    min-height: 74px;
  }
  .kx-glyph{
    font-size: 1.9rem;
    line-height: 1;
  }
  .kx-num{
    margin-top: 6px;
    font-size: 0.85rem;
    opacity: 0.65;
    font-variant-numeric: tabular-nums;
  }
</style>
