<% content_for :title, t("dictionary.shuowen.title") %>

<% content_for :rightbar do %>
  <h3><%= t("view_options.heading") %></h3>
  <%= render "shared/view_options_rightbar" %>
<% end %>

<h1>
  <%= t("dictionary.shuowen.heading_html",
        link: link_to(t("dictionary.shuowen.shuowen_jiezi"), "/corpus_viewer/中國漢文/clean/東漢/說文解字/")) %>
</h1>

<p>
  <%= t("dictionary.shuowen.intro_html",
        text_link: link_to(t("dictionary.shuowen.text_itself"), "/corpus_viewer/中國漢文/clean/東漢/說文解字/")) %>
</p>
<p>
  蓋文字者，經藝之本，王政之始。前人所以垂後，後人所以識古。故曰：“本立而道生。”知天下之至賾而不可亂也。
</p>
<p>
  <%= t("dictionary.shuowen.preface_translation_html") %>
</p>
<p>
  <%= t("dictionary.shuowen.historical_caution_html") %>
</p>
<p>
  <%= t("dictionary.shuowen.comparison") %>
</p>

<div class="sw-grid">
  <% @components.each do |c| %>
    <%= link_to "/dictionary/shuowen/#{c.number}",
      class: "sw-card",
      data: { turbo: false, turbo_prefetch: false } do %>
      <div class="sw-glyph"><%= c.glyph %></div>
      <div class="sw-num"><%= c.number %></div>
    <% end %>
  <% end %>
</div>

<style>
  .sw-grid{
    display:grid;
    grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));
    gap: 10px;
    margin-top: 14px;
  }
  .sw-card{
    display:flex;
    flex-direction: column;
    align-items:center;
    justify-content:center;
    padding: 10px 8px 8px 8px;
    border: 1px solid rgba(0,0,0,0.18);
    border-radius: 12px;
    text-decoration:none;
    min-height: 74px;
  }
  .sw-glyph{
    font-size: 1.9rem;
    line-height: 1;
  }
  .sw-num{
    margin-top: 6px;
    font-size: 0.85rem;
    opacity: 0.65;
    font-variant-numeric: tabular-nums;
  }
</style>
