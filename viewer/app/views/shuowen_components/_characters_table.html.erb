<%# Locals: component:, characters:, defs:, total:, page:, per:, def_source: %>

<div style="display:flex; gap: 12px; align-items:center; flex-wrap:wrap; margin: 6px 0 12px 0;">
  <% if page > 1 %>
    <%= link_to t("dictionary.common.previous"),
      "/dictionary/shuowen/#{component.number}/chars?def=#{def_source}&page=#{page - 1}&per=#{per}",
      data: { turbo_frame: "shuowen_chars" } %>
  <% end %>

  <% if (page * per) < total %>
    <%= link_to t("dictionary.common.next"),
      "/dictionary/shuowen/#{component.number}/chars?def=#{def_source}&page=#{page + 1}&per=#{per}",
      data: { turbo_frame: "shuowen_chars" } %>
  <% end %>

  <span style="opacity:0.75;">
    <%= t("dictionary.common.per") %>
    <%= link_to "50",  "/dictionary/shuowen/#{component.number}/chars?def=#{def_source}&page=#{page}&per=50",  data: { turbo_frame: "shuowen_chars" } %> |
    <%= link_to "100", "/dictionary/shuowen/#{component.number}/chars?def=#{def_source}&page=#{page}&per=100", data: { turbo_frame: "shuowen_chars" } %> |
    <%= link_to "200", "/dictionary/shuowen/#{component.number}/chars?def=#{def_source}&page=#{page}&per=200", data: { turbo_frame: "shuowen_chars" } %>
  </span>
</div>

<table style="width:100%; border-collapse: collapse;">
  <thead>
    <tr>
      <th style="text-align:left; padding: 6px 4px; border-bottom: 1px solid rgba(0,0,0,0.15);"><%= t("dictionary.common.glyph") %></th>
      <th style="text-align:left; padding: 6px 4px; border-bottom: 1px solid rgba(0,0,0,0.15);">
        <%= def_source == "shuowen" ? t("dictionary.common.shuowen_entry") : t("dictionary.common.unihan_definition") %>
      </th>
    </tr>
  </thead>
  <tbody>
    <% characters.each do |ch| %>
      <tr>
        <td style="padding: 10px 4px; vertical-align: top; width: 110px;">
          <div style="font-size: 2.2rem; line-height: 1.1;">
            <%= link_to ch.chr,
              character_path("U+#{ch.codepoint.to_s(16).upcase.rjust(4, "0")}"),
              data: { turbo: false } %>
          </div>
          <div style="opacity:0.7; font-size: 0.85rem;">
            U+<%= ch.codepoint.to_s(16).upcase.rjust(4, "0") %>
          </div>
        </td>
        <td style="padding: 10px 4px; vertical-align: top;">
          <%= (defs[ch.id].presence || "—") %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
