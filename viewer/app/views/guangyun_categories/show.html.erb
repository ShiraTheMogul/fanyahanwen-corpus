<% content_for :title, "Guangyun #{@category}" %>

<% content_for :rightbar do %>
  <h3>View options</h3>
  <%= render "shared/view_options_rightbar" %>
<% end %>

<h1>Guangyun: <%= @category %></h1>

<% unless @category_rows_exist %>
  <div style="padding:10px 12px; border:1px solid rgba(0,0,0,0.18); border-radius:10px; background: rgba(255,240,200,0.35); margin: 10px 0 14px 0;">
    <strong>No Guangyun category rows found for this value.</strong>
    This usually means the importer did not generate <code>guangyun_category</code> rows.
  </div>
<% end %>

<turbo-frame id="guangyun_chars" src="<%= dictionary_guangyun_category_chars_path(category: @route_key, page: @page, per: @per) %>">
  <div style="padding: 10px 0; opacity: 0.75;">
    Loading characters…
  </div>
</turbo-frame>

<p style="margin-top: 18px;">
  <%= link_to "Back to Guangyun categories", dictionary_guangyun_path, data: { turbo: false } %>
</p>
