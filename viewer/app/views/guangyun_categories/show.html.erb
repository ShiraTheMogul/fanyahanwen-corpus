<% content_for :title, t("dictionary.guangyun.page_title", category: @category) %>

<% content_for :rightbar do %>
  <h3><%= t("view_options.heading") %></h3>
  <%= render "shared/view_options_rightbar" %>
<% end %>

<h1>
  <%= t("dictionary.guangyun.category_heading", category: @category) %>
</h1>

<% unless @category_rows_exist %>
  <div style="padding:10px 12px; border:1px solid rgba(0,0,0,0.18); border-radius:10px; background: rgba(255,240,200,0.35); margin: 10px 0 14px 0;">
    <%= t("dictionary.guangyun.category_rows_missing_html", field: tag.code("guangyun_category")) %>
  </div>
<% end %>

<div style="display:flex; gap: 24px; align-items:flex-start; flex-wrap:wrap;">
  <div style="min-width: 280px; max-width: 420px;">

    <% if @rime_char.present? %>
      <script src="https://cdn.jsdelivr.net/npm/hanzi-writer@3.7.0/dist/hanzi-writer.min.js"></script>
      <div id="hanzi-writer-target" style="margin: 4px 0 14px 0;"></div>
      <script>
        (function(){
          try {
            var ch = "<%= j @rime_char.to_s %>".trim();
            if (!ch) return;
            HanziWriter.create('hanzi-writer-target', ch, { width: 140, height: 140, padding: 6 }).loopCharacterAnimation();
          } catch(e) {}
        })();
      </script>
    <% end %>

    <h2><%= t("dictionary.guangyun.about_rime") %></h2>

    <p><strong><%= t("dictionary.common.tone") %></strong> <%= @tone.presence || "—" %></p>
    <p><strong><%= t("dictionary.common.rime") %></strong> <%= [@rime_number, @rime_name].compact.join(". ").presence || "—" %></p>

    <% if @rime_char.present? %>


    <h3><%= t("dictionary.guangyun.character_information") %></h3>

    <% if @example_char %>
		<p><strong><%= t("dictionary.common.character") %>:</strong>
		<%= link_to @example_char.chr,
			character_path("U+#{@example_char.codepoint.to_s(16).upcase.rjust(4, "0")}"),
			data: { turbo: false } %>
		(<%= "U+%04X" % @example_char.codepoint %>)
		</p>
	  
		<% seal_family = HanFonts.family_for(:chongxi_seal) %>
		<p><strong><%= t("dictionary.common.chongxi_seal") %></strong>
			<span style='font-size:2.2rem; font-family:"<%= seal_family %>", serif;'>
			<%= @rime_char %>
		</span>
		</p>
	<% end %>

      <p><strong><%= t("dictionary.guangyun.bs2014_mc") %>:</strong>
        <% vals = Array(@example_bs2014).map(&:strip).reject(&:blank?) %>
        <%= vals.any? ? safe_join(vals.uniq.map { |v| h(v) }, tag.br) : "—" %>
      </p>

      <p><strong><%= t("dictionary.guangyun.stimson_ktang") %>:</strong>
        <% vals = Array(@example_ktang).map(&:strip).reject(&:blank?) %>
        <%= vals.any? ? safe_join(vals.uniq.map { |v| h(v) }, tag.br) : "—" %>
      </p>

      <p><strong><%= t("dictionary.common.mandarin") %>:</strong>
        <% vals = Array(@example_man).map(&:strip).reject(&:blank?) %>
        <%= vals.any? ? safe_join(vals.uniq.map { |v| h(v) }, tag.br) : "—" %>
      </p>
      <p><strong><%= t("dictionary.common.japanese") %>:</strong>
        <% vals = Array(@example_jpn).map(&:strip).reject(&:blank?) %>
        <%= vals.any? ? safe_join(vals.uniq.map { |v| h(v) }, tag.br) : "—" %>
      </p>
      <p><strong><%= t("dictionary.common.korean") %>:</strong>
        <% vals = Array(@example_kor).map(&:strip).reject(&:blank?) %>
        <%= vals.any? ? safe_join(vals.uniq.map { |v| h(v) }, tag.br) : "—" %>
      </p>
      <p><strong><%= t("dictionary.common.vietnamese") %>:</strong>
        <% vals = Array(@example_vie).map(&:strip).reject(&:blank?) %>
        <%= vals.any? ? safe_join(vals.uniq.map { |v| h(v) }, tag.br) : "—" %>
      </p>

    <% else %>
      <p>—</p>
    <% end %>

    <p style="margin-top: 18px;">
      <%= link_to t("dictionary.guangyun.back"), dictionary_guangyun_path, data: { turbo: false } %>
    </p>
  </div>

  <div style="flex:1; min-width: 520px;">
    <h2><%= t("dictionary.common.characters") %></h2>

    <div style="margin: 6px 0 10px 0;">
      <span style="opacity:0.85;"><%= t("dictionary.common.definition_source") %></span>
      <% cur = (params[:def].presence || "guangyun").to_s %>
      <%= link_to t("dictionary.common.guangyun"), dictionary_guangyun_category_path(category: @route_key, def: "guangyun"), data: { turbo: false }, style: (cur=="guangyun" ? "font-weight:700;" : "") %>
      <span style="opacity:0.5;">|</span>
      <%= link_to t("dictionary.common.unihan"), dictionary_guangyun_category_path(category: @route_key, def: "unihan"), data: { turbo: false }, style: (cur=="unihan" ? "font-weight:700;" : "") %>
    </div>

    <turbo-frame id="guangyun_chars" src="<%= dictionary_guangyun_category_chars_path(category: @route_key, page: @page, per: @per, def: params[:def]) %>">
      <div style="padding: 10px 0; opacity: 0.75;">
        <%= t("dictionary.common.loading_characters") %>
      </div>
    </turbo-frame>
  </div>
</div>
