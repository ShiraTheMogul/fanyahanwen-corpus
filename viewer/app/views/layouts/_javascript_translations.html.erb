<%
  source_catalogue = I18n.with_locale(InterfaceLocales::SOURCE) do
    I18n.t("javascript", default: {})
  end
  localized_catalogue = I18n.t("javascript", default: {})
  javascript_catalogue = source_catalogue.to_h.deep_merge(localized_catalogue.to_h)
  javascript_payload = {
    locale: I18n.locale.to_s,
    translations: javascript_catalogue
  }
%>
<script type="application/json" id="interface-translations"><%= raw(json_escape(javascript_payload.to_json)) %></script>
