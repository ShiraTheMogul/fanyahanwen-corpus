<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= t("site.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= render "layouts/social_meta" %>
	<%= favicon_link_tag 'favicon.ico', type: 'image/png' %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "rightbar", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "corpusviewer", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "corpus_activity", "data-turbo-track": "reload" if controller_name.in?(%w[home corpus_viewer]) %>
    <%= stylesheet_link_tag "textbook", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "xiangqi", "data-turbo-track": "reload" if controller_name == "xiangqi" %>

    <%= render "layouts/dynamic_fonts" %>
	<%= render "layouts/xiangqi_fonts" if controller_name == "xiangqi" %>

    <%= javascript_importmap_tags %>
  </head>


	  <% _han_font_key = (session[:han_font].presence || HanFonts.default_key).to_s.strip.downcase.tr(" ", "_") %>
  <% _han_scope = (session[:han_font_scope].presence || :all).to_s.strip.downcase.tr(" ", "_") %>
  <% _han_scope = %w[all headwords].include?(_han_scope) ? _han_scope : "all" %>
  <% _han_warn = session.key?(:han_font_warn_missing) ? (session[:han_font_warn_missing] == true) : true %>
	  <% _han_family = HanFonts.family_for(_han_font_key) %>
	  <% _han_stack = HanFonts.stack_for(_han_font_key) %>

		  <body
		    data-controller="han-font-bootstrap rightbar-layout"
	    class="han-font-scope-<%= _han_scope %>"
	    data-han-font-key="<%= _han_font_key %>"
	    data-han-font-family="<%= _han_family %>"
	    data-han-font-primary="<%= _han_family %>"
	    data-han-font-stack="<%= _han_stack %>"
	    data-han-font-warn-missing="<%= _han_warn ? "1" : "0" %>">
    <header class="site-header">
      <div class="site-header-inner">
        <div class="site-header-left">
                    <div class="site-title">
            <%= link_to(root_path,
                        class: "site-title-link",
                        aria: { label: t("site.title_aria") }) do %>
              <span class="site-title-part site-title-part--region">泛亞</span><span class="site-title-part site-title-part--language">漢文</span><span class="site-title-part site-title-part--corpus">語料庫</span>
            <% end %>
          </div>
          <nav class="site-nav" aria-label="<%= t("site.navigation.aria_label") %>">
            <%= link_to t("site.navigation.corpus_viewer"), corpus_viewer_path, class: "site-nav-link" %>
			<%= link_to t("site.navigation.corpus_search"), corpus_search_path, class: "site-nav-link" %>
			<%= link_to t("site.navigation.dictionary"), characters_path, class: "site-nav-link" %>
			<%= link_to t("site.navigation.tools"), tools_path, class: "site-nav-link" %>
			<%= link_to t("site.navigation.tickets"), ticket_access_path, class: "site-nav-link" %>
			<%= link_to t("site.navigation.fun"), fun_path, class: "site-nav-link" %>
          </nav>
        </div>

        <div class="site-header-center">
          <%= form_with url: characters_path, method: :get, local: true, class: "site-search" do %>
            <label class="sr-only" for="query"><%= t("site.search.label") %></label>
            <%= text_field_tag :query, params[:query], placeholder: t("site.search.placeholder"), class: "site-search-input" %>
            <%= submit_tag t("site.search.submit"), class: "site-search-submit" %>
          <% end %>
        </div>

	        <div class="site-header-right">
              <% next_locale = I18n.locale == :lzh ? :en : :lzh %>
              <% next_locale_name = t("site.locale_switch.languages.#{next_locale}") %>
              <%= button_to next_locale_name,
                            preferences_path,
                            method: :post,
                            params: { locale: next_locale, return_to: request.fullpath },
                            class: "rightbar-toggle",
                            form: { class: "site-locale-switch" },
                            aria: { label: t("site.locale_switch.aria_label", language: next_locale_name) } %>

	          <%# Only show the options toggle when a rightbar is actually present on the page. %>
	          <% if content_for?(:rightbar) %>
	            <button
	              type="button"
	              class="rightbar-toggle"
	              data-action="rightbar-layout#toggle"
	              aria-label="<%= t("site.options.toggle_aria") %>"
	            >
	              <%= t("site.options.button") %>
	            </button>
	          <% end %>

	          <span class="lunar-date"><%= lunar_today_string %></span>
	        </div>

	      </div>
	    </header>

	    <div class="page-shell <%= content_for?(:rightbar) ? "has-rightbar" : "no-rightbar" %>">
      <main class="maincol"
        data-controller="han-tooltip"
        data-action="click->han-tooltip#click dblclick->han-tooltip#dblclick">
        <%= yield %>
      </main>

	      <% if content_for?(:rightbar) %>
	        <aside class="rightbar site-rightbar" aria-label="<%= t("site.options.panel_aria") %>">
	          <div class="rightbar-section">
	            <%= yield :rightbar %>
	          </div>
	        </aside>
	      <% end %>
    </div>
	
	<%= render "shared/site_footer" %>
  </body>
</html>
