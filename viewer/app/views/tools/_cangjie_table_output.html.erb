<%= turbo_frame_tag "cangjie_out" do %>
  <% if message.present? %>
    <p><em><%= h(message) %></em></p>
  <% end %>

  <div style="overflow:auto; max-width: 100%;">
    <table class="cj-table">
      <thead>
        <tr>
          <th>Char</th>
          <th>Codepoint</th>
          <th>Cangjie</th>
          <th>HKCards</th>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |r| %>
          <tr>
            <td class="cj-char"><%= h(r[:char]) %></td>
            <td class="cj-cp">U+<%= r[:codepoint].to_i.to_s(16).upcase %></td>
            <td class="cj-code">
              <% if r[:codes].empty? %>
                <em>—</em>
              <% else %>
                <%= h(r[:codes].map { |c| "#{c[:han]} (#{c[:latin]})" }.join(" / ")) %>
              <% end %>
            </td>
            <td class="cj-img">
              <img class="cjimg cjimg-small"
                   src="https://www.hkcards.com/img/cj/<%= h(r[:char]) %>.png"
                   alt="HKCards Cangjie decomposition"
                   loading="lazy"
                   onerror="this.outerHTML='<em>—</em>'">
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
