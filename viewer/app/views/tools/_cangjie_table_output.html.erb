<%= turbo_frame_tag "cangjie_out" do %>
  <% if message.present? %>
    <p><em><%= h(message) %></em></p>
  <% end %>

  <div style="overflow:auto; max-width: 100%;">
    <table class="cj-table">
      <thead>
        <tr>
          <th><%= t("tools.common.character") %></th>
          <th><%= t("tools.common.codepoint") %></th>
          <th><%= t("tools.character_extractor.columns.cangjie") %></th>
          <th><%= t("tools.character_extractor.columns.hkcards") %></th>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |row| %>
          <tr>
            <td class="cj-char"><%= h(row[:char]) %></td>
            <td class="cj-cp">U+<%= row[:codepoint].to_i.to_s(16).upcase %></td>
            <td class="cj-code">
              <% if row[:codes].empty? %>
                <em>—</em>
              <% else %>
                <%= h(row[:codes].map { |code| "#{code[:han]} (#{code[:latin]})" }.join(" / ")) %>
              <% end %>
            </td>
            <td class="cj-img">
              <img class="cjimg cjimg-small"
                   src="https://www.hkcards.com/img/cj/<%= h(row[:char]) %>.png"
                   alt="<%= t("tools.character_extractor.messages.hkcards_alt") %>"
                   loading="lazy"
                   onerror="this.outerHTML='<em>—</em>'">
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
