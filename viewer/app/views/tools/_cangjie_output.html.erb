<%= turbo_frame_tag "cangjie_out" do %>
  <% if message.present? %>
    <p><em><%= h(message) %></em></p>
  <% end %>

  <% if char.present? %>
    <p><strong><%= h(char) %></strong> (U+<%= codepoint.to_i.to_s(16).upcase %>)</p>

    <div class="imgwrap cj-card">
      <img class="cjimg cjimg-small"
           src="https://www.hkcards.com/img/cj/<%= h(char) %>.png"
           alt="<%= t("tools.character_extractor.messages.hkcards_alt") %>"
           loading="lazy"
           onerror="this.outerHTML='<em><%= j t("tools.character_extractor.messages.no_hkcards") %></em>'">
    </div>
  <% end %>

  <pre class="tool-output"><%= h(lines.join("\n")) %></pre>
<% end %>
