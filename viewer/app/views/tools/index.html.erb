<h1><%= t("tools.title") %></h1>

<p><%= t("tools.intro") %></p>

<%
  scheme_label = lambda do |key|
    key.to_sym == :original ? t("tools.phonetic.original") : key.to_s.tr("_", " ")
  end
  mandarin_opts = ([:original] + Phoneticization::Converters::MANDARIN_SCHEMES.keys).map { |key| [scheme_label.call(key), key] }
  cantonese_opts = ([:original] + Phoneticization::Converters::CANTONESE_SCHEMES.keys).map { |key| [scheme_label.call(key), key] }
  extractor_options = @extractor_options || ToolsController::EXTRACTOR_OPTIONS.map { |key, value| [t(key), value] }
  enrichable_field_options = @enrichable_field_options || ToolsController::ENRICHABLE_FIELD_OPTIONS.transform_values { |key| t(key) }
%>

<h2><%= t("tools.phonetic.mandarin.title") %></h2>
<p><%= t("tools.phonetic.mandarin.description_html", link: link_to("pinyin-rb", "https://github.com/dohliam/pinyin-rb")) %></p>

<%= form_with url: tools_phonetic_mandarin_path, method: :post, data: { turbo_frame: "mandarin_out" } do %>
  <label><%= t("tools.common.from") %><%= t("tools.common.label_separator") %> <%= select_tag :from, options_for_select(mandarin_opts, :pinyin_numbers) %></label>
  <label style="margin-left:1em;"><%= t("tools.common.to") %><%= t("tools.common.label_separator") %> <%= select_tag :to, options_for_select(mandarin_opts, :pinyin_diacritics) %></label>
  <textarea name="input" rows="4" style="width:100%;" placeholder="<%= t("tools.phonetic.mandarin.placeholder") %>"></textarea>
  <button type="submit"><%= t("tools.common.convert") %></button>
<% end %>
<%= turbo_frame_tag "mandarin_out" do %><pre class="tool-output"></pre><% end %>

<h2><%= t("tools.phonetic.cantonese.title") %></h2>
<%= form_with url: tools_phonetic_cantonese_path, method: :post, data: { turbo_frame: "cantonese_out" } do %>
  <label><%= t("tools.common.from") %><%= t("tools.common.label_separator") %> <%= select_tag :from, options_for_select(cantonese_opts, :jyutping) %></label>
  <label style="margin-left:1em;"><%= t("tools.common.to") %><%= t("tools.common.label_separator") %> <%= select_tag :to, options_for_select(cantonese_opts, :ipa) %></label>
  <textarea name="input" rows="4" style="width:100%;" placeholder="<%= t("tools.phonetic.cantonese.placeholder") %>"></textarea>
  <button type="submit"><%= t("tools.common.convert") %></button>
<% end %>
<%= turbo_frame_tag "cantonese_out" do %><pre class="tool-output"></pre><% end %>

<h2><%= t("tools.character_extractor.title") %></h2>

<p><%= t("tools.character_extractor.description") %></p>
<p><%= t("tools.character_extractor.flashcard_help") %></p>

<%= form_with url: tools_cangjie_path, method: :post, data: { turbo_frame: "cangjie_out" } do %>
  <p>
    <label><%= t("tools.common.extract") %><%= t("tools.common.label_separator") %>
