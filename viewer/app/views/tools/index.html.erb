<h2><%= t("tools.anki.title") %></h2>
<p><%= t("tools.anki.description") %></p>

<%= form_with url: tools_cangjie_path, method: :post, data: { turbo_frame: "anki_enrich_out" }, html: { data: { anki_enrich_form: true } } do %>
  <%= hidden_field_tag :mode, "anki_enrich" %>

  <p>
    <label><%= t("tools.anki.source_field") %><%= t("tools.common.label_separator") %>
      <%= number_field_tag :source_field, 4, min: 1, step: 1, data: { anki_source_field: true } %>
    </label>

    <label style="margin-left: 1em;"><%= t("tools.anki.target_field") %><%= t("tools.common.label_separator") %>
      <%= number_field_tag :target_field, 10, min: 1, step: 1, data: { anki_target_field: true } %>
    </label>
  </p>

  <p>
    <label><input type="radio" name="append_mode" value="append" checked> <%= t("tools.anki.append_mode") %></label>
    <label style="margin-left: 1em;"><input type="radio" name="append_mode" value="replace"> <%= t("tools.anki.replace_mode") %></label>
  </p>

  <p>
    <label><%= t("tools.anki.preview_rows") %><%= t("tools.common.label_separator") %>
      <%= select_tag :preview_limit, options_for_select([[5,5],[10,10],[25,25],[50,50],[100,100]], 10) %>
    </label>
    <label style="margin-left: 1em;"><%= t("tools.anki.preview_start") %><%= t("tools.common.label_separator") %>
      <%= number_field_tag :preview_start, 1, min: 1, step: 1 %>
    </label>
    <label style="margin-left: 1em;"><%= t("tools.anki.preview_mode") %><%= t("tools.common.label_separator") %>
      <%= select_tag :preview_mode, options_for_select([[t("tools.anki.changed_only"), "changed_only"], [t("tools.anki.full_rows"), "full_rows"]], "changed_only") %>
    </label>
  </p>

  <p><strong><%= t("tools.anki.data_to_append") %></strong></p>
  <div>
    <% enrichable_field_options.each do |field, label_text| %>
      <label style="display: inline-block; min-width: 15em; margin-right: 1em; margin-bottom: 0.35em;">
        <input type="checkbox" name="enrich_fields[]" value="<%= field %>" <%= "checked" if field == "kangxi_gloss" %>>
        <%= label_text %>
      </label>
    <% end %>
  </div>

  <p>
    <textarea name="input" rows="12" style="width: 100%;" placeholder="<%= t("tools.anki.input_placeholder") %>" data-anki-input="true"></textarea>
  </p>

  <div data-anki-live-summary style="margin-bottom: 0.75em;"></div>
  <div data-anki-first-row-preview style="margin-bottom: 0.75em;"></div>

  <p><button type="submit"><%= t("tools.anki.enrich_deck") %></button></p>
<% end %>

<%
  anki_live_messages = {
    detected_fields: t("tools.anki.live.detected_fields"),
    highest_metadata_field: t("tools.anki.live.highest_metadata_field"),
    note_rows: t("tools.anki.live.note_rows"),
    metadata_help: t("tools.anki.live.metadata_help"),
    paste_to_preview: t("tools.anki.live.paste_to_preview"),
    automatic_preview: t("tools.anki.live.automatic_preview"),
    preview_help: t("tools.anki.live.preview_help"),
    field: t("tools.anki.live.field"),
    first_row_value: t("tools.anki.live.first_row_value"),
    label_separator: t("tools.common.label_separator")
  }
%>
<script>
(function() {
  var messages = <%= raw(json_escape(anki_live_messages.to_json)) %>;

  function escapeHtml(str) {
    return String(str || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function truncateText(str, max) {
    str = String(str || "");
    return str.length > max ? str.slice(0, max - 1) + "…" : str;
  }

  function analyseAnkiText(raw) {
    var text = String(raw || "").replace(/\r\n/g, "\n").replace(/\r/g, "\n");
    var lines = text.split("\n");
    var noteRows = [];
    var maxFields = 0;
    var metadataMax = 0;
    var metaRegex = /^#(?:guid|notetype|deck|tags)\s+column:(\d+)/i;

    lines.forEach(function(line) {
      if (!line) { return; }
      if (line.charAt(0) === '#') {
        var match = line.match(metaRegex);
        if (match) { metadataMax = Math.max(metadataMax, parseInt(match[1], 10) || 0); }
        return;
      }
      var cols = line.split("\t");
      noteRows.push(cols);
      maxFields = Math.max(maxFields, cols.length);
    });

    maxFields = Math.max(maxFields, metadataMax);
    var firstRow = noteRows.length > 0 ? noteRows[0].slice() : null;
    if (firstRow && firstRow.length < maxFields) {
      while (firstRow.length < maxFields) { firstRow.push(""); }
    }

    return {
      noteCount: noteRows.length,
      maxFields: maxFields,
      metadataMax: metadataMax,
      firstRow: firstRow
    };
  }

  function bindAnkiForm() {
    var form = document.querySelector('[data-anki_enrich_form], [data-anki-enrich-form]');
    if (!form) { return; }
    var input = form.querySelector('[data-anki-input]');
    var sourceField = form.querySelector('[data-anki-source-field]');
    var targetField = form.querySelector('[data-anki-target-field]');
    var summaryBox = form.querySelector('[data-anki-live-summary]');
    var previewBox = form.querySelector('[data-anki-first-row-preview]');
    if (!input || !sourceField || !targetField || !summaryBox || !previewBox) { return; }

    function render() {
      var info = analyseAnkiText(input.value);
      var maxFields = info.maxFields || 1;
      sourceField.max = maxFields;
      targetField.max = maxFields;

      if (parseInt(sourceField.value || '0', 10) > maxFields) { sourceField.value = maxFields; }
      if (parseInt(targetField.value || '0', 10) > maxFields) { targetField.value = maxFields; }

      summaryBox.innerHTML = '<p><strong>' + escapeHtml(messages.detected_fields) + escapeHtml(messages.label_separator) + '</strong> ' + maxFields +
        ' · <strong>' + escapeHtml(messages.highest_metadata_field) + escapeHtml(messages.label_separator) + '</strong> ' + (info.metadataMax || 0) +
        ' · <strong>' + escapeHtml(messages.note_rows) + escapeHtml(messages.label_separator) + '</strong> ' + (info.noteCount || 0) + '</p>' +
        '<p style="margin-top:0.35em;"><em>' + escapeHtml(messages.metadata_help) + '</em></p>';

      if (!info.firstRow) {
        previewBox.innerHTML = '<p><em>' + escapeHtml(messages.paste_to_preview) + '</em></p>';
        return;
      }

      var srcIndex = Math.max((parseInt(sourceField.value || '1', 10) || 1) - 1, 0);
      var tgtIndex = Math.max((parseInt(targetField.value || '1', 10) || 1) - 1, 0);
      var fields = info.firstRow;
      var rowsHtml = '';
      for (var i = 0; i < fields.length; i++) {
        var style = '';
        if (i === srcIndex) { style += 'background:#f8f8f8;'; }
        if (i === tgtIndex) { style += (style ? ' ' : '') + 'background:#eef7ee;'; }
        rowsHtml += '<tr>' +
          '<td style="border-bottom:1px solid #eee; padding:0.35em; width:5em;">' + (i + 1) + '</td>' +
          '<td style="border-bottom:1px solid #eee; padding:0.35em; ' + style + ' white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word;">' +
          escapeHtml(truncateText(fields[i], 200) || '—') + '</td>' +
          '</tr>';
      }

      previewBox.innerHTML = '<p><strong>' + escapeHtml(messages.automatic_preview) + '</strong></p>' +
        '<p><em>' + escapeHtml(messages.preview_help) + '</em></p>' +
        '<div style="overflow-x:auto;">' +
        '<table style="width:100%; border-collapse:collapse; table-layout:fixed;">' +
        '<thead><tr><th style="text-align:left; border-bottom:1px solid #ccc; padding:0.35em; width:5em;">' + escapeHtml(messages.field) + '</th><th style="text-align:left; border-bottom:1px solid #ccc; padding:0.35em;">' + escapeHtml(messages.first_row_value) + '</th></tr></thead>' +
        '<tbody>' + rowsHtml + '</tbody></table></div>';
    }

    input.addEventListener('input', render);
    sourceField.addEventListener('input', render);
    targetField.addEventListener('input', render);
    render();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindAnkiForm);
  } else {
    bindAnkiForm();
  }
  document.addEventListener('turbo:load', bindAnkiForm);
})();
</script>

<%= turbo_frame_tag "anki_enrich_out" do %>
  <pre class="tool-output"></pre>
<% end %>

