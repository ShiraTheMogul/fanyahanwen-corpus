<%= turbo_frame_tag "anki_enrich_out" do %>
  <% if message.present? %>
    <p><em><%= h(message) %></em></p>
  <% else %>
    <p>
      Updated <strong><%= updated_count %></strong> of <strong><%= note_count %></strong> note rows.
      Target field: <strong><%= target_field_number %></strong>.
      Source field: <strong><%= source_field_number %></strong>.
      Mode: <strong><%= h(append_mode) %></strong>.
    </p>

    <p>
      Detected fields per note: <strong><%= detected_field_count || 0 %></strong>.
      Highest metadata field marker: <strong><%= metadata_max_field || 0 %></strong>.
      Non-empty target fields before enrichment: <strong><%= target_nonempty_count %></strong>.
      Changed rows where the target already had content: <strong><%= changed_with_existing_target_count %></strong>.
      Skipped rows: <strong><%= skipped_count %></strong>.
    </p>

    <% if sample_html.present? %>
      <details open>
        <summary>Preview of inserted HTML</summary>
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 1em; margin-top: 0.75em;">
          <div>
            <p><strong>Raw HTML</strong></p>
            <pre class="tool-output" style="white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word;"><%= h(sample_html) %></pre>
          </div>
          <div>
            <p><strong>Rendered HTML</strong></p>
            <div style="border:1px solid #ccc; padding:0.75em; min-height:8em; overflow-wrap:anywhere; word-break:break-word;">
              <%= sample_html.html_safe %>
            </div>
          </div>
        </div>
      </details>
    <% end %>

    <h3>Preview table</h3>
    <p>
      Showing up to <strong><%= preview_limit %></strong> rows starting at preview row <strong><%= preview_start %></strong> in
      <strong><%= preview_mode == "full_rows" ? "full rows" : "changed rows only" %></strong> mode.
      Click a field preview to inspect the full content below.
    </p>

    <% if preview_rows.present? %>
      <% initial_row = preview_rows.first %>
      <div data-anki-preview-root>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; margin-bottom: 1em; table-layout: fixed;">
            <thead>
              <tr>
                <th style="text-align:left; border-bottom:1px solid #ccc; padding:0.35em; width:4.5em;">Row</th>
                <th style="text-align:left; border-bottom:1px solid #ccc; padding:0.35em; width:12em;">GUID</th>
                <th style="text-align:left; border-bottom:1px solid #ccc; padding:0.35em; background:#f8f8f8;">Source field <%= source_field_number %></th>
                <th style="text-align:left; border-bottom:1px solid #ccc; padding:0.35em;">Target before</th>
                <th style="text-align:left; border-bottom:1px solid #ccc; padding:0.35em; background:#eef7ee;">Target after</th>
                <th style="text-align:left; border-bottom:1px solid #ccc; padding:0.35em; width:14em;">Status</th>
              </tr>
            </thead>
            <tbody>
              <% preview_rows.each do |row| %>
                <% row_style = if row[:status].start_with?("replace")
                                 "background:#fff4e5;"
                               elsif row[:status].start_with?("append")
                                 "background:#f3fbf3;"
                               else
                                 ""
                               end %>
                <tr style="<%= row_style %>">
                  <td style="vertical-align:top; border-bottom:1px solid #eee; padding:0.35em;"><%= row[:row_number] %></td>
                  <td style="vertical-align:top; border-bottom:1px solid #eee; padding:0.35em; overflow-wrap:anywhere; word-break:break-word;"><%= h(row[:guid].presence || "—") %></td>
                  <% [
                       ["Source field #{source_field_number}", row[:source_before], "#f8f8f8"],
                       ["Target field #{target_field_number} before", row[:target_before], ""],
                       ["Target field #{target_field_number} after", row[:target_after], "#eef7ee"]
                     ].each do |label_text, field_text, bg| %>
                    <td style="vertical-align:top; border-bottom:1px solid #eee; padding:0.35em; background:<%= bg %>; overflow-wrap:anywhere; word-break:break-word;">
                      <button type="button"
                              style="display:block; width:100%; text-align:left; border:0; background:transparent; padding:0; cursor:pointer; white-space:normal; overflow-wrap:anywhere; word-break:break-word;"
                              onclick="(function(btn){var box=btn.closest('[data-anki-preview-root]'); box.querySelector('[data-detail-label]').textContent=btn.dataset.label; box.querySelector('[data-detail-raw]').textContent=btn.dataset.raw; box.querySelector('[data-detail-rendered]').innerHTML=btn.dataset.rendered; })(this)"
                              data-label="Row <%= row[:row_number] %> · <%= label_text %>"
                              data-raw="<%= h(field_text) %>"
                              data-rendered="<%= h(field_text) %>">
                        <span style="display:block; white-space:normal; overflow-wrap:anywhere; word-break:break-word;"><%= h(truncate(field_text.to_s, length: 160)) %></span>
                      </button>
                    </td>
                  <% end %>
                  <td style="vertical-align:top; border-bottom:1px solid #eee; padding:0.35em; overflow-wrap:anywhere; word-break:break-word;"><%= h(row[:status]) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <h4>Clicked field detail</h4>
        <p data-detail-label>Row <%= initial_row[:row_number] %> · Target field <%= target_field_number %> after</p>
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 1em; align-items:start;">
          <div style="min-width:0;">
            <p><strong>Raw field content</strong></p>
            <pre data-detail-raw class="tool-output" style="white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word;"><%= h(initial_row[:target_after]) %></pre>
          </div>
          <div style="min-width:0;">
            <p><strong>Rendered field content</strong></p>
            <div data-detail-rendered style="border:1px solid #ccc; padding:0.75em; min-height:8em; white-space: normal; overflow-wrap:anywhere; word-break:break-word;"><%= initial_row[:target_after].to_s.html_safe %></div>
          </div>
        </div>
      </div>
    <% else %>
      <p><em>No preview rows matched the current preview settings.</em></p>
    <% end %>

    <p>
      <button type="button"
              onclick="(function(btn){ var ta = btn.parentElement.parentElement.querySelector('textarea[data-download-source]'); var blob = new Blob([ta.value], {type: 'text/plain;charset=utf-8'}); var url = URL.createObjectURL(blob); var a = document.createElement('a'); a.href = url; a.download = 'anki_enriched.txt'; document.body.appendChild(a); a.click(); document.body.removeChild(a); setTimeout(function(){ URL.revokeObjectURL(url); }, 1000); })(this)">
        Download enriched TXT
      </button>
    </p>

    <textarea data-download-source rows="18" style="width: 100%;"><%= output_text %></textarea>
  <% end %>
<% end %>
