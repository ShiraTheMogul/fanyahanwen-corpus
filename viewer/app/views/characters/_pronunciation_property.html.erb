<%# Locals: prop, bs_mc_detail_by_source %>
<li class="pronun-item">
  <strong><%= FieldLens.label_for(prop.field) %></strong>:
  <% displayed_value = romanise_unihan_value(prop.field, prop.value) %>
  <% value_annotation = PronunciationRegistry.value_annotation_for(prop.field, displayed_value) %>
  <% if value_annotation %>
    <%= view_text(value_annotation[:base]) %><abbr title="<%= h(value_annotation[:label]) %>"><%= view_text(value_annotation[:annotation]) %></abbr>
  <% else %>
    <%= view_text(displayed_value) %>
  <% end %>

  <% if prop.field == "bs2014_mc" %>
    <% details = bs_mc_detail_by_source[prop.source] || [] %>
    <% if details.any? %>
      <span class="pronun-tooltip"
            title="<%= h(details.join(" / ")) %>">ⓘ</span>
    <% end %>
  <% end %>

  <em>(<%= render_source(prop.source) %>)</em>
</li>
