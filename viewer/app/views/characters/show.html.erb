<% if @character.nil? %>
  <h1><%= t("dictionary.character.not_found") %></h1>
  <p><%= t("dictionary.character.not_in_database", identifier: params[:id]) %></p>

  <p><%= t("dictionary.character.try_another") %></p>

  <%= form_with url: characters_path, method: :get, local: true do %>
    <label for="query"><%= t("dictionary.character_or_codepoint") %>:</label>
    <%= text_field_tag :query %>
    <%= submit_tag t("dictionary.submit") %>
  <% end %>

	<% else %>
	<%= render "rightbar" %>

  <div class="char-header">
    <h1 class="char-glyph" data-controller="font-guard" data-font-guard-char-value="<%= view_text(@character.chr) %>"><%= character_glyph_with_ruby(view_text(@character.chr)) %></h1>

    <div id="hw-wrap" class="hw-wrap">
      <div id="hanzi-writer" class="hanzi-writer-box"></div>
      <div id="hw-fallback" class="hw-fallback">
        <em><%= t("dictionary.character.stroke_unavailable") %></em>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/hanzi-writer@3/dist/hanzi-writer.min.js"></script>
  <script>
    (function () {
      var ch = "<%= @character.chr %>";
      var targetId = "hanzi-writer";
      var fallbackEl = document.getElementById("hw-fallback");
      var messages = <%= raw json_escape({
        libraryFailed: t("dictionary.character.stroke_library_failed"),
        noData: t("dictionary.character.no_stroke_data")
      }.to_json) %>;

      function showFallback(msg) {
        fallbackEl.innerHTML = "<em>" + msg + "</em>";
        fallbackEl.style.display = "block";
      }

      function hideFallback() {
        fallbackEl.style.display = "none";
      }

      // Failsafe: library didn't load :( (CSP/offline/etc.)
      if (typeof HanziWriter === "undefined") {
        showFallback(messages.libraryFailed);
        return;
      }

      try {
        var writer = HanziWriter.create(targetId, ch, {
          width: 140,
          height: 140,
          padding: 8
        });

        hideFallback();

        // Stroke demo - we have the character and font, so this is all we want it for.
        writer.loopCharacterAnimation();
      } catch (e) {
        // Failsafe 2: library loaded, but no stroke data / unsupported char
        showFallback(messages.noData);
      }
    })();
  </script>

  <p>
    <%= t("dictionary.character.codepoint") %>
    U+<%= @character.codepoint.to_s(16).upcase.rjust(4, "0") %>
    (<%= @character.codepoint %>)
	<% block = UnicodeRanges.han_block_label(@character.codepoint) %>
	<% if block %>
		<span class="unicode-block-badge" title="<%= t("dictionary.character.unicode_block") %>"><%= block %></span>
	<% end %>

  </p>

  <% ids_deconstructions = FieldLens.ids_deconstructions_for(@character) %>
  <% if ids_deconstructions.any? %>
    <section class="character-ids-deconstructions">
      <h2><%= t("dictionary.character.ideographic_description_sequence_deconstructions") %></h2>
      <ul>
        <% ids_deconstructions.each do |deconstruction| %>
          <li>
            <code><%= view_text(deconstruction[:expression]) %></code>
            <% if deconstruction[:levels].any? || deconstruction[:sources].any? %>
              <small>
                <%= ([deconstruction[:sources].join(" / ").presence, deconstruction[:levels].map(&:upcase).join(" / ").presence].compact).join(" · ") %>
              </small>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @base_character.present? %>
    <h2><%= t("dictionary.character.base_character") %></h2>
    <p>
      <%= link_to "#{@base_character.chr} (U+#{@base_character.codepoint.to_s(16).upcase})",
                  character_path("U+#{@base_character.codepoint.to_s(16).upcase}") %>
    </p>
  <% end %>

  <%#
    Variants
    - @variants (computed links: VariantMapping + CC-CEDICT partner + kCompatibilityVariant)
    - Unihan semantic variant fields are folded into THIS list so they don't clutter Properties.

    Formatting goal:
    - Each entry starts with the variant kind (bold)
    - The simplified glyph (when present) is bolded inside the link text
  %>

  <% unihan_variant_props = [] %>
  <% grouped = @grouped_properties %>
  <% prop_lists =
       if grouped.respond_to?(:values)
         grouped.values
       elsif grouped.is_a?(Array)
         grouped.map { |pair| pair.is_a?(Array) ? pair[1] : nil }.compact
       else
         []
       end %>

  <% prop_lists.flatten.each do |p| %>
    <% next unless p.respond_to?(:field) && p.respond_to?(:source) && p.respond_to?(:value) %>
    <% next unless p.source.to_s == "Unihan_Variants" %>
    <% next unless ["kSemanticVariant", "kSpecializedSemanticVariant"].include?(p.field.to_s) %>
    <% unihan_variant_props << p %>
  <% end %>

  <% parse_variant_cps = lambda do |raw|
       s = raw.to_s
       cps = []
       s.scan(/U\+[0-9A-Fa-f]{4,6}/).each { |u| cps << u.delete_prefix("U+").to_i(16) }
       if cps.empty?
         s.each_char { |ch| cps << ch.ord if ch.match?(/\p{Han}/) }
       end
       cps.uniq
     end %>

  <% unihan_variant_entries = [] %>
  <% unihan_variant_props.each do |p| %>
    <% kind_key = (p.field.to_s == "kSemanticVariant") ? "dictionary.character.variant_kinds.semantic" : "dictionary.character.variant_kinds.specialised_semantic" %>
    <% parse_variant_cps.call(p.value).each do |cp| %>
      <% unihan_variant_entries << { codepoint: cp, kind_key: kind_key, source: p.source.to_s } %>
    <% end %>
  <% end %>

  <% if @variants.present? || unihan_variant_entries.any? %>
    <h2><%= t("dictionary.character.variants") %></h2>
    <ul>
      <% (@variants || []).each do |v| %>
        <% hex = (v[:hex].presence rescue nil) || v[:codepoint].to_i.to_s(16).upcase %>
        <% glyph = (v[:glyph].presence rescue nil) || v[:label].to_s.each_char.first %>
        <% rest = v[:label].to_s.sub(/^#{Regexp.escape(glyph)}\s*/, "") %>
        <li>
          <% variant_kind_key = {
               "Semantic variant" => "dictionary.character.variant_kinds.semantic",
               "Specialised semantic variant" => "dictionary.character.variant_kinds.specialised_semantic",
               "Simplified variant" => "dictionary.character.variant_kinds.simplified",
               "Traditional variant" => "dictionary.character.variant_kinds.traditional",
               "Variant" => "dictionary.character.variant_kinds.generic"
             }[v[:kind].to_s] %>
          <strong><%= variant_kind_key ? t(variant_kind_key) : v[:kind] %></strong>:
          <%= link_to character_path("U+#{hex}") do %>
            <% if v[:kind].to_s == "Simplified variant" %>
              <strong><%= view_text(glyph) %></strong> <%= view_text(rest) %>
            <% else %>
              <%= view_text(v[:label]) %>
            <% end %>
          <% end %>
          <% if v[:has_own_entry] %>
            <span class="variant-note"><%= t("dictionary.character.has_own_definition") %></span>
          <% end %>
          <em>(<%= v[:source].presence || "MOE 異典收字清單" %>)</em>
        </li>
      <% end %>

      <% unihan_variant_entries.each do |e| %>
        <% hex = e[:codepoint].to_i.to_s(16).upcase %>
        <% glyph = begin
                     [e[:codepoint].to_i].pack("U")
                   rescue StandardError
                     nil
                   end %>
        <li>
          <strong><%= t(e[:kind_key]) %></strong>:
          <%= link_to character_path("U+#{hex}") do %>
            <%= view_text(glyph.present? ? "#{glyph} (U+#{hex})" : "U+#{hex}") %>
          <% end %>
          <em>(<%= e[:source] %>)</em>
        </li>
      <% end %>
    </ul>
  <% end %>

  <h2><%= t("dictionary.character.definitions") %></h2>

  <% if @cedict_defs.present? %>
    <h3>CC-CEDICT</h3>
    <% if @cedict_defs_inherited && @cedict_defs_from.present? %>
      <p>
        <%= t("dictionary.character.inherited_definition_html",
              source: t("dictionary.character.sources.cedict_definitions"),
              character_link: link_to("#{@cedict_defs_from.chr} (U+#{@cedict_defs_from.codepoint.to_s(16).upcase})",
                                      character_path("U+#{@cedict_defs_from.codepoint.to_s(16).upcase}"))) %>
      </p>
    <% end %>
    <ol>
      <% @cedict_defs.each do |d| %>
        <li><%= view_text(d) %></li>
      <% end %>
    </ol>
  <% end %>

  <% if @unihan_definition.present? %>
    <h3><%= t("dictionary.common.unihan_definition") %></h3>
    <% if @unihan_definition_inherited && @unihan_definition_from.present? %>
      <p>
        <%= t("dictionary.character.inherited_definition_html",
              source: t("dictionary.character.sources.unihan_definition"),
              character_link: link_to("#{@unihan_definition_from.chr} (U+#{@unihan_definition_from.codepoint.to_s(16).upcase})",
                                      character_path("U+#{@unihan_definition_from.codepoint.to_s(16).upcase}"))) %>
      </p>
    <% end %>
    <div class="unihan-def">
      <%= simple_format(h(view_text(@unihan_definition))) %>
      <%# File: app/views/characters/show.html.erb
          h(...) escapes HTML to keep dictionary text from being interpreted as markup. %>
    </div>
  <% end %>

    <% if @shuowen_entry.present? %>
    <h3><%= t("dictionary.character.shuowen_jiezi") %></h3>
    <% if @shuowen_entry_inherited && @shuowen_entry_from.present? %>
      <p>
        <%= t("dictionary.character.inherited_definition_html",
              source: t("dictionary.character.sources.shuowen_text"),
              character_link: link_to("#{@shuowen_entry_from.chr} (U+#{@shuowen_entry_from.codepoint.to_s(16).upcase})",
                                      character_path("U+#{@shuowen_entry_from.codepoint.to_s(16).upcase}"))) %>
      </p>
    <% end %>

    <% if @shuowen_category.present? %>
      <p><strong><%= t("dictionary.character.radical_or_component") %></strong> <%= view_text(@shuowen_category) %></p>
    <% end %>

    <div class="shuowen">
      <%= simple_format(h(view_text(@shuowen_entry))) %>
    </div>
  <% end %>

<% if @kangxi_text.present? %>
    <h3><%= t("dictionary.character.kangxi_dictionary") %></h3>

    <% if @kangxi_rsunicode_display.present? %>
      <p><strong><%= t("dictionary.character.radical_or_component") %></strong>
        <% if @kangxi_rsunicode_tooltip.present? %>
          <span title="<%= @kangxi_rsunicode_tooltip %>"><%= view_text(@kangxi_rsunicode_display) %></span>
        <% else %>
          <%= view_text(@kangxi_rsunicode_display) %>
        <% end %>
      </p>
    <% end %>
    <% if @kangxi_text_inherited && @kangxi_text_from.present? %>
      <p>
        <%= t("dictionary.character.inherited_definition_html",
              source: t("dictionary.character.sources.kangxi_text"),
              character_link: link_to("#{@kangxi_text_from.chr} (U+#{@kangxi_text_from.codepoint.to_s(16).upcase})",
                                      character_path("U+#{@kangxi_text_from.codepoint.to_s(16).upcase}"))) %>
      </p>
    <% end %>
    <div class="kangxi">
      <%= simple_format(h(view_text(FieldLens.format_kangxi(@kangxi_text)))) %>
    </div>
  <% end %>

    <% if @guangyun_payload_raw.present? %>
    <h3><%= t("dictionary.character.guangyun_heading") %></h3>

    <p><strong><%= t("dictionary.character.radical_or_component") %></strong> <%= view_text(@guangyun_category) %></p>

    <div class="guangyun">
      <%= simple_format(h(view_text(@guangyun_payload_raw))) %>
    </div>
  <% end %>

  <% if @variant_definition_blocks.present? %>
    <details class="variant-defs">
      <summary>
        <%= t("dictionary.character.variant_specific_definitions", count: @variant_definition_blocks.length) %>
      </summary>

      <% @variant_definition_blocks.each do |blk| %>
        <% cc = blk[:character] %>
        <h4>
          <%= link_to "#{cc.chr} (U+#{cc.codepoint.to_s(16).upcase})",
                      character_path("U+#{cc.codepoint.to_s(16).upcase}") %>
        </h4>

        <% if blk[:cedict_defs].present? %>
          <h5>CC-CEDICT</h5>
          <ol>
            <% blk[:cedict_defs].each do |d| %>
              <li><%= view_text(d) %></li>
            <% end %>
          </ol>
        <% end %>

        <% if blk[:unihan_definition].present? %>
          <h5><%= t("dictionary.common.unihan_definition") %></h5>
          <div class="unihan-def">
            <%= simple_format(h(view_text(blk[:unihan_definition]))) %>
          </div>
        <% end %>

        <% if blk[:kangxi_text].present? %>
          <h5><%= t("dictionary.character.kangxi_dictionary") %></h5>
          <div class="kangxi">
            <%= simple_format(h(view_text(FieldLens.format_kangxi(blk[:kangxi_text])))) %>
          </div>
        <% end %>
      <% end %>
    </details>
  <% end %>

  <h2><%= t("dictionary.character.properties") %></h2>
  <% hkcards_image_rendered = false %>
  <% FieldLens.with_character_data(@grouped_properties, @character).each do |group_name, props| %>
    
<% property_group_key = {
     "Strokes & radicals" => "dictionary.character.property_groups.strokes_radicals",
     "Pronunciation" => "dictionary.character.property_groups.pronunciation",
     "Input" => "dictionary.character.property_groups.input",
     "Education notes" => "dictionary.character.property_groups.education_notes",
     "Dictionary indices" => "dictionary.character.property_groups.dictionary_indices",
     "Encodings & mappings" => "dictionary.character.property_groups.encodings_mappings",
     "Ideographic Research Group (IRG) sources" => "dictionary.character.property_groups.irg_sources",
     "Other" => "dictionary.character.property_groups.other"
   }[group_name.to_s] %>
<h3><%= property_group_key ? t(property_group_key) : group_name %></h3>

<% if group_name == "Pronunciation" %>
  <%= render partial: "pronunciation_sections", locals: { props: (props || []), character: @character } %>
<% else %>
  <ul>
    <% (props || []).each do |prop| %>
      <%# These variant fields are shown in the top "Variants" section instead (see above). %>
      <% next if prop.source.to_s == "Unihan_Variants" && ["kSemanticVariant", "kSpecializedSemanticVariant"].include?(prop.field.to_s) %>
      <li>
        <strong><%= FieldLens.label_for(prop.field) %></strong>:
        <% display_text, tooltip = FieldLens.display_value_and_tooltip(
             prop.field,
             romanise_unihan_value(prop.field, prop.value),
             context: :property_list
           ) %>
        <% if tooltip.present? %>
          <span title="<%= tooltip %>"><%= view_text(display_text) %></span>
        <% else %>
          <%= view_text(display_text) %>
        <% end %>

        <% if ["kCangjie", "rime_cangjie5"].include?(prop.field) %>
          <span class="cj-shapes">(<%= CangjieKeymap.latin_to_han(prop.value) %>)</span>
        <% end %>

        <% if prop.field == "kCangjie" %>
          <% unless hkcards_image_rendered %>
            <div class="imgwrap cj-card">
              <img class="cjimg cjimg-small"
                   src="https://www.hkcards.com/img/cj/<%= @character.chr %>.png"
                   alt="<%= t("dictionary.character.cangjie_decomposition") %>"
                   loading="lazy"
                   onerror="this.outerHTML='<em><%= j t("dictionary.character.no_hkcards_decomposition") %></em>'">
            </div>
            <% hkcards_image_rendered = true %>
          <% end %>
        <% end %>

        <em>(<%= prop.source %>)</em>
      </li>
    <% end %>
  </ul>
<% end %>
  <% end %>

  <p><a href="/home/index"><%= t("dictionary.character.return_home") %></a></p>
<% end %>