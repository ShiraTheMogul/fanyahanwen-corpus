<h1>
  <% if show_han_ornament? %><%= t("dictionary.title_han") %> <% end %><%= translated_interface_label("dictionary.title", ornament_key: "dictionary.title_han") %>
</h1>

<p><%= t("dictionary.search_prompt") %></p>

<%= form_with url: characters_path, method: :get, local: true do %>
  <label for="query"><%= t("dictionary.character_or_codepoint") %>:</label>
  <%= text_field_tag :query %>
  <%= submit_tag t("dictionary.submit") %>
<% end %>

<hr>

<%= render "dictionary_catalogue/styles" %>

<h2><%= t("dictionary.catalogue.heading", default: "Historical dictionaries") %></h2>

<p>
  <%= t(
    "dictionary.catalogue.character_landing_intro",
    default: "Browse the imported dictionaries as complete historical works. Kangxi radicals, Shuowen components, and Guangyun tone-and-rhyme browsing remain available from their dictionary cards."
  ) %>
</p>

<%= render "dictionary_catalogue/work_cards", works: @dictionary_works, specialized_links: true %>

<p class="dictionary-catalogue-more-link">
  <%= link_to t("dictionary.catalogue.open_full_catalogue", default: "Open the full historical-dictionary catalogue"), dictionary_catalogue_path, data: { turbo: false } %>
</p>
