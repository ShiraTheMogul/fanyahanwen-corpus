<% memberships = ChengyuData::CharacterMemberships.new(@character) %>
<% rows = memberships.rows %>

<% if rows.any? %>
  <%= stylesheet_link_tag "chengyu_games", "data-turbo-track": "reload" %>
  <section class="chengyu-character-memberships">
    <h3>成語 Chengyu</h3>
    <p class="muted">
      This character appears in <%= number_with_delimiter(memberships.count) %> imported Chengyu <%= memberships.count == 1 ? "family" : "families" %>.
    </p>

    <ol class="chengyu-character-memberships__list">
      <% rows.each do |row| %>
        <li>
          <span class="chengyu-character-memberships__word"><%= view_text(row.chengyu.display_form) %></span>
          <% if row.matching_form.present? && row.matching_form.form_text != row.chengyu.display_form %>
            <span class="chengyu-character-memberships__variant">Contains this character in the attested form <%= view_text(row.matching_form.form_text) %>.</span>
          <% end %>

          <% if row.languages.any? %>
            <span>
              <% row.languages.first(5).each do |tag| %>
                <% label = ChengyuData::EntryPresenter::LANGUAGE_LABELS.fetch(tag.to_s, tag.to_s) %>
                <span class="chengyu-language-badge"><%= label %></span>
              <% end %>
            </span>
          <% end %>

          <% if row.sense.present? %>
            <span class="chengyu-character-memberships__sense"><%= view_text(row.sense.plain_definition) %></span>
          <% end %>

          <span class="chengyu-character-memberships__study-links">
            <%= link_to "Search corpus", row.corpus_search_url, target: "_blank", rel: "noopener" %>
            <% row.corpus_contexts.each do |context| %>
              <%= link_to "Source context — #{context[:label]}", context[:url], target: "_blank", rel: "noopener" %>
            <% end %>
          </span>

          <% if row.sources.any? %>
            <span class="chengyu-character-memberships__sources">
              <% row.sources.each do |source| %>
                <% next if source.url.blank? %>
                <%= link_to source.site_label, source.url, target: "_blank", rel: "noopener" %>
              <% end %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>
