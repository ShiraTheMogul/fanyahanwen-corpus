<div class="pronun-sections" data-controller="pronunciation-sections">
  <% all_props = (props || []) %>

  <%# Collect B&S MC analysis strings for tooltip use (we don't show this as its own row). %>
  <% bs_mc_detail_by_source =
       all_props
         .select { |p| p.field == "bs2014_mc_detail" }
         .group_by(&:source)
         .transform_values { |arr| arr.map(&:value).compact.map(&:to_s).map(&:strip).reject(&:empty?).uniq } %>

  <% FieldLens.pronunciation_sections(all_props).each do |sec| %>
    <% next if sec[:count].to_i.zero? %>

    <details class="pronun-section"
             data-pref-key="pronun_v2_sec_<%= sec[:key] %>"
             data-default-open="<%= sec[:default_open] ? "1" : "0" %>">
      <summary title="<%= t("dictionary.pronunciation.expand_or_collapse", label: sec[:label]) %>">
        <span class="pronun-section-title"><%= sec[:label] %></span>
        <span class="pronun-section-count"><%= sec[:count] %></span>
      </summary>

      <% if sec[:props].present? %>
        <ul class="pronun-section-list">
          <% sec[:props].each do |prop| %>
            <% next if prop.field == "bs2014_mc_detail" %>
            <%= render partial: "pronunciation_property",
                       locals: { prop: prop, bs_mc_detail_by_source: bs_mc_detail_by_source } %>
          <% end %>
        </ul>
      <% end %>

      <% Array(sec[:varieties]).each do |variety| %>
        <details class="pronun-variety"
                 data-pref-key="pronun_v2_variety_<%= sec[:key] %>_<%= variety[:key] %>"
                 data-default-open="0">
          <summary title="<%= t("dictionary.pronunciation.expand_or_collapse", label: variety[:label]) %>">
            <span class="pronun-section-title"><%= variety[:label] %></span>
            <span class="pronun-section-count"><%= variety[:props].length %></span>
          </summary>

          <% if variety[:location].present? || variety[:references].present? %>
            <div class="pronun-variety-meta">
              <% if variety[:location].present? %>
                <p><strong><%= t("dictionary.pronunciation.location") %></strong> <%= variety[:location] %></p>
              <% end %>

              <% if variety[:references].present? %>
                <details class="pronun-variety-references">
                  <summary title="<%= t("dictionary.pronunciation.expand_or_collapse_references") %>">
                    <span><%= t("dictionary.pronunciation.references") %></span>
                    <span class="pronun-reference-count"><%= variety[:references].length %></span>
                  </summary>
                  <ol>
                    <% variety[:references].each do |reference| %>
                      <li>
                        <% if reference[:label].present? %>
                          <span class="pronun-reference-label"><%= reference[:label] %>:</span>
                        <% end %>
                        <% if reference[:url].present? %>
                          <%= link_to reference[:citation], reference[:url], target: "_blank", rel: "noopener" %>
                        <% else %>
                          <%= reference[:citation] %>
                        <% end %>
                        <% if reference[:license].present? %>
                          <% if reference[:license_url].present? %>
                            (<%= link_to reference[:license], reference[:license_url], target: "_blank", rel: "noopener" %>)
                          <% else %>
                            (<%= reference[:license] %>)
                          <% end %>
                        <% end %>
                      </li>
                    <% end %>
                  </ol>
                </details>
              <% end %>
            </div>
          <% end %>

          <ul class="pronun-section-list">
            <% variety[:props].each do |prop| %>
              <%= render partial: "pronunciation_property",
                         locals: { prop: prop, bs_mc_detail_by_source: bs_mc_detail_by_source } %>
            <% end %>
          </ul>
        </details>
      <% end %>
    </details>
  <% end %>
</div>
