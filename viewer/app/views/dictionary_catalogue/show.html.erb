<% content_for :title, @work.title %>

<% content_for :rightbar do %>
  <h3><%= t("view_options.heading") %></h3>
  <%= render "shared/view_options_rightbar" %>
<% end %>

<%= render "styles" %>

<h1><%= @work.title %></h1>

<%= render "lookup_form", work: @work %>
<%= render "lookup_results" %>

<div class="dictionary-browser-columns">
  <div class="dictionary-browser-sidebar">
    <h2><%= t("dictionary.catalogue.about_work", default: "About this dictionary") %></h2>

    <dl class="dictionary-stat-list">
      <% if @work.edition_label.present? %>
        <dt><%= t("dictionary.catalogue.edition", default: "Edition") %></dt>
        <dd><%= @work.edition_label %></dd>
      <% end %>

      <dt><%= t("dictionary.catalogue.source", default: "Imported source") %></dt>
      <dd><%= @work.source_label %></dd>

      <dt><%= t("dictionary.catalogue.sections", default: "Sections") %></dt>
      <dd><%= number_with_delimiter(@work.section_count) %></dd>

      <dt><%= t("dictionary.catalogue.entries", default: "Entries") %></dt>
      <dd><%= number_with_delimiter(@work.entry_count) %></dd>

      <% if @work.group_count.to_i.positive? %>
        <dt><%= t("dictionary.catalogue.groups", default: "Pronunciation groups") %></dt>
        <dd><%= number_with_delimiter(@work.group_count) %></dd>
      <% end %>

      <% if @work.reading_count.to_i.positive? %>
        <dt><%= t("dictionary.catalogue.readings", default: "Explicit readings") %></dt>
        <dd><%= number_with_delimiter(@work.reading_count) %></dd>
      <% end %>
    </dl>

    <details style="margin-top: 14px;">
      <summary><strong><%= t("dictionary.catalogue.import_details", default: "Import details") %></strong></summary>
      <p><strong><%= t("dictionary.catalogue.corpus_work_id", default: "Corpus work ID") %>:</strong> <%= @work.corpus_work_id %></p>
      <p><strong><%= t("dictionary.catalogue.parser", default: "Parser") %>:</strong> <%= @work.parser_name %> <%= @work.parser_version %></p>
      <p><strong><%= t("dictionary.catalogue.imported_at", default: "Imported") %>:</strong> <%= l(@work.imported_at, format: :long) %></p>
    </details>

    <p style="margin-top: 18px;">
      <%= link_to t("dictionary.catalogue.back", default: "Back to historical dictionaries"), dictionary_catalogue_path, data: { turbo: false } %>
    </p>
  </div>

  <div class="dictionary-browser-main">
    <h2><%= t("dictionary.catalogue.sections", default: "Sections") %></h2>

    <% @section_groups.each do |group| %>
      <h3 class="dictionary-section-divider"><%= group.fetch(:label) %> (<%= group.fetch(:sections).length %>)</h3>
      <div class="dictionary-section-grid">
        <% group.fetch(:sections).each do |section| %>
          <%= link_to dictionary_catalogue_section_path(
                corpus_work_id: @work.corpus_work_id,
                section_sequence: section.sequence_number
              ),
              class: "dictionary-section-card",
              data: { turbo: false, turbo_prefetch: false } do %>
            <div class="dictionary-section-label"><%= section.label %></div>
            <div class="dictionary-card-meta">
              <% entry_count = section.metadata.to_h["entry_count"] %>
              <% group_count = section.metadata.to_h["group_count"] %>
              <div>#<%= section.sequence_number %></div>
              <% if entry_count.present? %>
                <div><%= number_with_delimiter(entry_count) %> <%= t("dictionary.catalogue.entries", default: "entries") %></div>
              <% end %>
              <% if group_count.to_i.positive? %>
                <div><%= number_with_delimiter(group_count) %> <%= t("dictionary.catalogue.groups", default: "groups") %></div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
