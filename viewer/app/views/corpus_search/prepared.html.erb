<h1><%= @prepared_search&.complete? ? t("corpus_search.analysis.title", default: "Corpus Search Analysis") : t("corpus_search.prepared.title", default: "Prepared Corpus Search") %></h1>

<% if @prepared_search %>
  <div data-prepared-search-id="<%= @prepared_search.id %>"></div>
  <% payload = @prepared_search.payload %>
  <% outputs = payload["outputs"] || {} %>
  <% progress = payload["progress"] || {} %>
  <% prepared_base = "/corpus/search/prepared/#{@prepared_search.id}?key=#{ERB::Util.url_encode(@prepared_search.key)}" %>
  <% if @full_search_progress_seed.present? %>
    <% content_for :full_search_progress_seed, @full_search_progress_seed.to_json %>
  <% end %>

  <section class="corpus-search-summary">
    <div>
      <p><%= t("corpus_search.prepared.status") %>: <strong data-prepared-status><%= t("corpus_search.statuses.#{payload["status"]}", default: payload["status"].to_s.humanize) %></strong></p>
      <p><%= t("corpus_search.prepared.query") %>: <strong><%= @prepared_search.query.display_label %></strong></p>
      <p>Stage: <span data-prepared-stage><%= t("corpus_search.stages.#{progress["stage"]}", default: progress["stage"].to_s.humanize) %></span>. Files: <span data-prepared-files><%= progress["files_scanned"] || 0 %> / <%= progress["files_total"] || 0 %></span>. Hits found: <span data-prepared-hits><%= progress["hits_found"] || 0 %></span>.</p>
      <% if payload["duration_seconds"].present? %>
        <p>Completed in <strong><%= number_with_precision(payload["duration_seconds"], precision: 2, strip_insignificant_zeros: true) %> seconds</strong>.</p>
        <% timings = outputs["stage_timings"] || {} %>
        <% if timings.any? %>
          <p class="corpus-search-hint">Dataset/search: <%= number_with_precision(timings["dataset_seconds"], precision: 2, strip_insignificant_zeros: true) %> s · Analysis: <%= number_with_precision(timings["analysis_seconds"], precision: 2, strip_insignificant_zeros: true) %> s · Packaging: <%= number_with_precision(timings["packaging_seconds"], precision: 2, strip_insignificant_zeros: true) %> s<% if outputs["documents_per_second"].present? %> · <%= number_with_delimiter(outputs["documents_per_second"]) %> documents/s<% end %></p>
        <% end %>
      <% elsif payload["started_at"].present? %>
        <p>Started at <%= payload["started_at"] %>.</p>
      <% end %>
      <p class="corpus-search-warning" data-worker-waiting hidden><%= t("corpus_search.prepared.worker_waiting", default: "This job has been queued but no worker has started it yet. In local development, run bin/corpus-search-worker in a second terminal.") %></p>
    </div>

    <div class="corpus-search-summary-actions">
      <span data-controller="copy-url" data-copy-url-url-value="<%= @frozen_result_url %>" data-copy-url-success-label-value="<%= t("corpus_search.actions.copied") %>">
        <button type="button" class="corpus-search-button corpus-search-button-secondary" data-copy-url-target="button" data-action="copy-url#copy">
          <%= t("corpus_search.actions.copy_frozen_url") %>
        </button>
      </span>

      <% if @prepared_search.complete? %>
        <%= link_to t("corpus_search.actions.download_zip"), "/corpus/search/prepared/#{@prepared_search.id}/download?key=#{ERB::Util.url_encode(@prepared_search.key)}", class: "corpus-search-button" %>
      <% elsif @prepared_search.full_search? && !@prepared_search.cancelled? && !@prepared_search.failed? %>
        <form action="/corpus/search/prepared/<%= @prepared_search.id %>/cancel?key=<%= ERB::Util.url_encode(@prepared_search.key) %>" method="post" class="corpus-search-inline-form">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <button type="submit" class="corpus-search-button corpus-search-button-secondary"><%= t("corpus_search.actions.cancel_full_search") %></button>
        </form>
      <% end %>
    </div>
  </section>

  <nav class="corpus-search-workspace-tabs" aria-label="<%= t("corpus_search.analysis.workspace", default: "Search workspace") %>">
    <%= link_to t("corpus_search.analysis.tabs.results", default: "Results"), @live_query_url, class: "corpus-search-workspace-tab" %>
    <% if @prepared_search.complete? %>
      <a href="#analysis" class="corpus-search-workspace-tab" aria-current="page"><%= t("corpus_search.analysis.tabs.analysis", default: "Analysis") %></a>
      <a href="#advanced-analysis" class="corpus-search-workspace-tab"><%= t("corpus_search.analysis.tabs.advanced", default: "Advanced analysis") %></a>
      <a href="#comparison" class="corpus-search-workspace-tab"><%= t("corpus_search.analysis.tabs.comparison", default: "Compare scopes") %></a>
    <% else %>
      <span class="corpus-search-workspace-tab is-disabled" aria-disabled="true"><%= t("corpus_search.analysis.tabs.analysis", default: "Analysis") %></span>
      <span class="corpus-search-workspace-tab is-disabled" aria-disabled="true"><%= t("corpus_search.analysis.tabs.advanced", default: "Advanced analysis") %></span>
      <span class="corpus-search-workspace-tab is-disabled" aria-disabled="true"><%= t("corpus_search.analysis.tabs.comparison", default: "Compare scopes") %></span>
    <% end %>
    <a href="#query-details" class="corpus-search-workspace-tab"><%= t("corpus_search.analysis.tabs.query_details", default: "Query details") %></a>
  </nav>

  <details id="query-details" class="corpus-search-query-details">
    <summary><%= t("corpus_search.query_details.heading") %></summary>
    <% query = @prepared_search.query %>
    <dl>
        <div><dt><%= t("corpus_search.query_details.mode") %></dt><dd><%= t("corpus_search.modes.#{query.mode}") %></dd></div>
        <div><dt><%= t("corpus_search.query_details.query") %></dt><dd><code><%= query.display_label %></code></dd></div>
        <div><dt><%= t("corpus_search.query_details.punctuation") %></dt><dd><%= t("corpus_search.punctuation.#{query.punctuation}") %></dd></div>
        <div><dt><%= t("corpus_search.query_details.character_matching") %></dt><dd><%= t("corpus_search.characters.#{query.character_equivalence}") %></dd></div>
        <div><dt><%= t("corpus_search.query_details.text_witnesses") %></dt><dd><%= query.document_roles.map { |role| t("corpus_search.roles.#{role}") }.join(", ") %></dd></div>
        <div><dt><%= t("corpus_search.query_details.folders") %></dt><dd><%= query.include_folders.presence&.join("; ") || t("corpus_search.query_details.all_selected_folders") %></dd></div>
        <% if query.exclude_folders.any? %>
          <div><dt><%= t("corpus_search.query_details.excluded_folders") %></dt><dd><%= query.exclude_folders.join("; ") %></dd></div>
        <% end %>
        <div><dt>Exact-body deduplication</dt><dd><%= query.deduplicate_exact_bodies? ? "Enabled" : "Disabled" %></dd></div>
        <div class="corpus-search-query-url"><dt><%= t("corpus_search.query_details.live_url") %></dt><dd><code><%= @live_query_url %></code></dd></div>
    </dl>
  </details>


  <% if @prepared_search.complete? %>
    <section id="analysis" class="corpus-search-analysis">
      <% if @analysis_report %>
        <% overall = @analysis_report.overall %>
        <header class="corpus-search-analysis-header">
          <div>
            <h2><%= t("corpus_search.analysis.overview", default: "Analysis overview") %></h2>
            <p><%= t("corpus_search.analysis.body_only_note", default: "All rates use searchable body characters. Metadata headers never contribute to matches or denominators.") %></p>
          </div>
          <p class="corpus-search-analysis-runtime">
            <%= t("corpus_search.analysis.runtime", default: "Analysis runtime") %>:
            <strong><%= outputs["analysis_status"].to_s.humanize %></strong>
          </p>
        </header>

        <div class="corpus-search-analysis-metrics">
          <% [
               ["occurrences", overall["occurrences"]],
               ["matching_documents", overall["matching_documents"]],
               ["documents", overall["documents"]],
               ["searchable_characters", overall["searchable_characters"]],
               ["document_prevalence", overall["document_prevalence"]],
               ["occurrences_per_million", overall["occurrences_per_million"]]
             ].each do |metric, value| %>
            <article class="corpus-search-analysis-metric">
              <span><%= t("corpus_search.analysis.metrics.#{metric}", default: metric.humanize) %></span>
              <strong><%= corpus_search_analysis_value(metric, value) %></strong>
            </article>
          <% end %>
        </div>

        <section class="corpus-search-analysis-measure" aria-labelledby="analysis-measure-heading">
          <h3 id="analysis-measure-heading"><%= t("corpus_search.analysis.measure", default: "Measure shown in grouped figures") %></h3>
          <div class="corpus-search-analysis-measure-options">
            <% CorpusSearch::AnalysisReport::METRICS.each do |metric| %>
              <% href = "#{prepared_base}&metric=#{ERB::Util.url_encode(metric)}#analysis" %>
              <%= link_to corpus_search_analysis_metric_label(metric),
                          href,
                          class: "corpus-search-analysis-measure-option",
                          aria: { current: (@analysis_metric == metric ? "true" : nil) } %>
            <% end %>
          </div>
        </section>

        <div class="corpus-search-analysis-chart-grid">
          <% CorpusSearch::AnalysisReport::DIMENSIONS.each do |dimension| %>
            <% chart = @analysis_report.chart(dimension: dimension, metric: @analysis_metric) %>
            <% svg = corpus_search_analysis_svg(@analysis_report, chart) %>
            <% next if svg.blank? %>
            <details class="corpus-search-analysis-chart" <%= "open" if %w[period nation].include?(dimension) %>>
              <summary>
                <span><%= corpus_search_analysis_dimension_label(dimension) %></span>
                <small><%= corpus_search_analysis_metric_label(@analysis_metric) %></small>
              </summary>
              <div class="corpus-search-analysis-figure"><%= svg %></div>
              <% if chart["omitted_groups"].to_i.positive? %>
                <p class="corpus-search-hint"><%= t("corpus_search.analysis.groups_omitted", default: "%{count} additional groups remain in the downloadable CSV table.", count: chart["omitted_groups"]) %></p>
              <% end %>
            </details>
          <% end %>
        </div>

        <section class="corpus-search-analysis-secondary">
          <% distribution_chart = @analysis_report.special_chart("matches_per_document") %>
          <% distribution_svg = corpus_search_analysis_svg(@analysis_report, distribution_chart) %>
          <% if distribution_svg.present? %>
            <article class="corpus-search-analysis-card">
              <h3><%= t("corpus_search.analysis.matches_per_document", default: "Matches per document") %></h3>
              <p><%= t("corpus_search.analysis.matches_per_document_note", default: "This shows whether the result is spread across the corpus or concentrated in a smaller set of documents.") %></p>
              <div class="corpus-search-analysis-figure"><%= distribution_svg %></div>
            </article>
          <% end %>

          <% proximity_chart = @analysis_report.special_chart("proximity_span_histogram") %>
          <% proximity_svg = corpus_search_analysis_svg(@analysis_report, proximity_chart) %>
          <% if proximity_svg.present? %>
            <article class="corpus-search-analysis-card">
              <h3><%= t("corpus_search.analysis.proximity_spans", default: "Proximity spans") %></h3>
              <p><%= t("corpus_search.analysis.proximity_note", default: "The span is the number of searchable characters from the first matched term to the end of the last matched term.") %></p>
              <div class="corpus-search-analysis-figure"><%= proximity_svg %></div>
            </article>
          <% end %>
        </section>

        <section id="advanced-analysis" class="corpus-search-advanced-analysis">
          <header>
            <h3><%= t("corpus_search.analysis.advanced.heading", default: "Advanced corpus analysis") %></h3>
            <p><%= t("corpus_search.analysis.advanced.introduction", default: "These analyses use only body-text occurrences, nearby body characters, document exposure, and recorded dates. They do not search metadata headers.") %></p>
          </header>

          <div class="corpus-search-analysis-secondary corpus-search-analysis-advanced-grid">
            <% neighbour_chart = @analysis_report.special_chart("neighbour_characters") %>
            <% neighbour_svg = corpus_search_analysis_svg(@analysis_report, neighbour_chart) %>
            <% if neighbour_svg.present? %>
              <article class="corpus-search-analysis-card">
                <h4><%= t("corpus_search.analysis.advanced.neighbours", default: "Neighbouring characters") %></h4>
                <p><%= t("corpus_search.analysis.advanced.neighbours_note", default: "Counts characters found within five body-text characters to the left or right of each matched passage. Punctuation, spacing, and control characters are excluded.") %></p>
                <div class="corpus-search-analysis-figure"><%= neighbour_svg %></div>
                <% neighbour_rows = @analysis_report.table("neighbour_window", limit: 20) %>
                <% if neighbour_rows.any? %>
                  <div class="corpus-search-analysis-table-wrap">
                    <table class="corpus-search-analysis-table corpus-search-analysis-compact-table">
                      <thead><tr>
                        <th><%= t("corpus_search.analysis.table.character", default: "Character") %></th>
                        <th><%= t("corpus_search.analysis.table.left", default: "Left") %></th>
                        <th><%= t("corpus_search.analysis.table.right", default: "Right") %></th>
                        <th><%= t("corpus_search.analysis.table.total", default: "Total") %></th>
                      </tr></thead>
                      <tbody>
                        <% neighbour_rows.each do |row| %>
                          <tr>
                            <td><strong><%= row["character"] %></strong></td>
                            <td><%= number_with_delimiter(row["left_occurrences"].to_i) %></td>
                            <td><%= number_with_delimiter(row["right_occurrences"].to_i) %></td>
                            <td><%= number_with_delimiter(row["total_occurrences"].to_i) %></td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                <% end %>
              </article>
            <% end %>

            <% forms_chart = @analysis_report.special_chart("character_forms") %>
            <% forms_svg = corpus_search_analysis_svg(@analysis_report, forms_chart) %>
            <% if forms_svg.present? %>
              <article class="corpus-search-analysis-card">
                <h4><%= t("corpus_search.analysis.advanced.character_forms", default: "Forms actually matched") %></h4>
                <p><%= t("corpus_search.analysis.advanced.character_forms_note", default: "Compares each entered term with the form actually present in the source. This makes common-variant and broad-equivalence searches auditable without converting the corpus text.") %></p>
                <div class="corpus-search-analysis-figure"><%= forms_svg %></div>
              </article>
            <% end %>

            <% keyness_chart = @analysis_report.special_chart("comparison_neighbour_keyness") %>
            <% keyness_svg = corpus_search_analysis_svg(@analysis_report, keyness_chart) %>
            <% if keyness_svg.present? %>
              <article class="corpus-search-analysis-card corpus-search-analysis-card-wide">
                <h4><%= t("corpus_search.analysis.advanced.neighbour_keyness", default: "Distinctive neighbouring characters between scopes") %></h4>
                <p><%= t("corpus_search.analysis.advanced.neighbour_keyness_note", default: "For a two-scope comparison, this contrasts characters in the five-character windows around the matches. G² ranks contextual differences; the log-ratio shows which selected scope favours the character. It is not general corpus-wide keyness.") %></p>
                <div class="corpus-search-analysis-figure"><%= keyness_svg %></div>
                <% keyness_rows = @analysis_report.table("comparison_neighbour_keyness", limit: 20) %>
                <% if keyness_rows.any? %>
                  <div class="corpus-search-analysis-table-wrap">
                    <table class="corpus-search-analysis-table corpus-search-analysis-compact-table">
                      <thead><tr>
                        <th><%= t("corpus_search.analysis.table.character", default: "Character") %></th>
                        <th><%= t("corpus_search.analysis.table.favoured_scope", default: "Favoured scope") %></th>
                        <th><%= t("corpus_search.analysis.table.log_ratio", default: "Log₂ ratio") %></th>
                        <th>G²</th>
                        <th><%= t("corpus_search.analysis.advanced.p_value", default: "p-value") %></th>
                      </tr></thead>
                      <tbody>
                        <% keyness_rows.each do |row| %>
                          <tr>
                            <td><strong><%= row["character"] %></strong></td>
                            <td><%= row["favoured_scope"] %></td>
                            <td><%= corpus_search_analysis_decimal(row["log2_rate_ratio"], precision: 3) %></td>
                            <td><%= corpus_search_analysis_decimal(row["log_likelihood_g2"], precision: 3) %></td>
                            <td><%= corpus_search_analysis_p_value(row["p_value"]) %></td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                <% end %>
              </article>
            <% end %>

            <% alternative_chart = @analysis_report.special_chart("alternative_terms") %>
            <% alternative_svg = corpus_search_analysis_svg(@analysis_report, alternative_chart) %>
            <% if alternative_svg.present? %>
              <article class="corpus-search-analysis-card">
                <h4><%= t("corpus_search.analysis.advanced.alternatives", default: "Alternative-term contributions") %></h4>
                <p><%= t("corpus_search.analysis.advanced.alternatives_note", default: "Shows which OR alternatives produced the results. One source occurrence may count for more than one alternative when their accepted character forms overlap.") %></p>
                <div class="corpus-search-analysis-figure"><%= alternative_svg %></div>
              </article>
            <% end %>

            <% order_chart = @analysis_report.special_chart("term_orders") %>
            <% order_svg = corpus_search_analysis_svg(@analysis_report, order_chart) %>
            <% if order_svg.present? %>
              <article class="corpus-search-analysis-card">
                <h4><%= t("corpus_search.analysis.advanced.term_orders", default: "Observed proximity orders") %></h4>
                <p><%= t("corpus_search.analysis.advanced.term_orders_note", default: "Groups proximity matches by the order in which the entered terms actually occur in the source passage.") %></p>
                <div class="corpus-search-analysis-figure"><%= order_svg %></div>
              </article>
            <% end %>

            <% time_chart = @analysis_report.special_chart("time_trend") %>
            <% time_svg = corpus_search_analysis_svg(@analysis_report, time_chart) %>
            <% if time_svg.present? %>
              <article class="corpus-search-analysis-card corpus-search-analysis-card-wide">
                <h4><%= t("corpus_search.analysis.advanced.time", default: "Frequency through dated centuries") %></h4>
                <p><%= t("corpus_search.analysis.advanced.time_note", default: "Documents with parseable dates are grouped into historical centuries. Points show occurrences per million searchable body characters; bars are approximate 95% Poisson intervals. Undated documents remain in the overall totals but not this chart.") %></p>
                <div class="corpus-search-analysis-figure corpus-search-analysis-scrollable-figure"><%= time_svg %></div>

                <% time_model = @analysis_report.table("time_trend_model").first %>
                <% if time_model %>
                  <dl class="corpus-search-advanced-stat-list">
                    <div><dt><%= t("corpus_search.analysis.advanced.model", default: "Exploratory count model") %></dt><dd><%= time_model["model_family"].to_s.humanize %></dd></div>
                    <div><dt><%= t("corpus_search.analysis.advanced.rate_ratio_century", default: "Rate ratio per century") %></dt><dd><%= corpus_search_analysis_decimal(time_model["rate_ratio_per_century"], precision: 4) %></dd></div>
                    <div><dt><%= t("corpus_search.analysis.advanced.rate_ratio_interval", default: "Approximate 95% interval") %></dt><dd><%= corpus_search_analysis_interval(time_model["rate_ratio_ci_low_95"], time_model["rate_ratio_ci_high_95"]) %></dd></div>
                    <div><dt><%= t("corpus_search.analysis.advanced.p_value", default: "Trend p-value") %></dt><dd><%= corpus_search_analysis_p_value(time_model["p_value"]) %></dd></div>
                    <div><dt><%= t("corpus_search.analysis.advanced.overdispersion", default: "Poisson overdispersion ratio") %></dt><dd><%= corpus_search_analysis_decimal(time_model["poisson_overdispersion_ratio"], precision: 3) %></dd></div>
                  </dl>
                  <p class="corpus-search-hint"><%= t("corpus_search.analysis.advanced.time_model_warning", default: "This is a descriptive document-level model with searchable body characters as exposure. It does not establish a causal historical trend.") %></p>
                <% end %>
              </article>
            <% end %>
          </div>

          <% dispersion_rows = @analysis_report.table("dispersion") %>
          <% if dispersion_rows.any? %>
            <% dispersion = dispersion_rows.to_h { |row| [row["measure"], row["value"]] } %>
            <article class="corpus-search-analysis-card corpus-search-advanced-summary-card">
              <h4><%= t("corpus_search.analysis.advanced.dispersion", default: "Dispersion across documents") %></h4>
              <p><%= t("corpus_search.analysis.advanced.dispersion_note", default: "Deviation of Proportions compares each document's share of occurrences with its share of searchable corpus size. DPnorm near 0 means the query follows corpus exposure relatively evenly; values near 1 mean strong concentration.") %></p>
              <div class="corpus-search-analysis-metrics corpus-search-analysis-metrics-small">
                <article class="corpus-search-analysis-metric"><span>DP</span><strong><%= corpus_search_analysis_decimal(dispersion["dp"], precision: 4) %></strong></article>
                <article class="corpus-search-analysis-metric"><span>DPnorm</span><strong><%= corpus_search_analysis_decimal(dispersion["dp_norm"], precision: 4) %></strong></article>
                <article class="corpus-search-analysis-metric"><span><%= t("corpus_search.analysis.advanced.evenness", default: "Evenness (1 − DPnorm)") %></span><strong><%= corpus_search_analysis_decimal(dispersion["evenness_one_minus_dp_norm"], precision: 4) %></strong></article>
                <article class="corpus-search-analysis-metric"><span><%= t("corpus_search.analysis.advanced.document_range", default: "Document range") %></span><strong><%= number_to_percentage(dispersion["document_range"].to_f * 100, precision: 2) %></strong></article>
              </div>
            </article>
          <% end %>

          <% sensitivity_rows = @analysis_report.table("exact_body_sensitivity") %>
          <% duplicate_groups = @analysis_report.table("duplicate_body_query_groups", limit: 20) %>
          <% if sensitivity_rows.any? %>
            <article class="corpus-search-analysis-table-section corpus-search-duplicate-audit">
              <h4><%= t("corpus_search.analysis.advanced.duplicates", default: "Exact-text duplication audit") %></h4>
              <p><%= t("corpus_search.analysis.advanced.duplicates_note", default: "This table shows exact-body groups that actually affect this query. Empty and unrelated duplicate groups are excluded. The sensitivity check treats each identical body as one unit; near-duplicate editions and quotations remain distinct.") %></p>
              <div class="corpus-search-analysis-table-wrap">
                <table class="corpus-search-analysis-table">
                  <thead><tr>
                    <th><%= t("corpus_search.analysis.table.basis", default: "Counting basis") %></th>
                    <th><%= t("corpus_search.analysis.metrics.documents", default: "Documents") %></th>
                    <th><%= t("corpus_search.analysis.metrics.occurrences", default: "Occurrences") %></th>
                    <th><%= t("corpus_search.analysis.metrics.occurrences_per_million", default: "Per million") %></th>
                    <th><%= t("corpus_search.analysis.metrics.document_prevalence", default: "Document prevalence") %></th>
                  </tr></thead>
                  <tbody>
                    <% sensitivity_rows.each do |row| %>
                      <tr>
                        <td><%= t("corpus_search.analysis.advanced.bases.#{row["basis"]}", default: row["basis"].to_s.humanize) %></td>
                        <td><%= number_with_delimiter(row["documents"].to_i) %></td>
                        <td><%= number_with_delimiter(row["occurrences"].to_i) %></td>
                        <td><%= corpus_search_analysis_decimal(row["occurrences_per_million"], precision: 2) %></td>
                        <td><%= number_to_percentage(row["document_prevalence"].to_f * 100, precision: 2) %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>

              <% if duplicate_groups.any? %>
                <details>
                  <summary><%= t("corpus_search.analysis.advanced.show_duplicate_groups", default: "Show exact-body groups affecting this query") %></summary>
                  <div class="corpus-search-analysis-table-wrap">
                    <table class="corpus-search-analysis-table">
                      <thead><tr>
                        <th><%= t("corpus_search.analysis.table.example", default: "Example") %></th>
                        <th><%= t("corpus_search.analysis.metrics.documents", default: "Documents") %></th>
                        <th>Body length</th>
                        <th>Matching documents</th>
                        <th><%= t("corpus_search.analysis.metrics.occurrences", default: "Occurrences") %></th>
                      </tr></thead>
                      <tbody>
                        <% duplicate_groups.each do |row| %>
                          <tr>
                            <td><strong><%= row["example_title"].presence || File.basename(row["example_path"].to_s, ".txt") %></strong><small><%= row["example_path"] %></small><%= link_to "Open example", CorpusSearch::SourceLink.relative_url(path: row["example_path"]), class: "corpus-search-analysis-row-link" %></td>
                            <td><%= number_with_delimiter(row["documents"].to_i) %></td>
                            <td><%= number_with_delimiter(row["body_length"].to_i) %></td>
                            <td><%= number_with_delimiter(row["matching_documents"].to_i) %></td>
                            <td><%= number_with_delimiter(row["occurrences"].to_i) %></td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                </details>
              <% end %>
            </article>
          <% end %>
        </section>

        <section id="comparison" class="corpus-search-comparison">
          <header>
            <h3><%= t("corpus_search.comparison.heading", default: "Compare two scopes") %></h3>
            <p><%= t("corpus_search.comparison.introduction", default: "Apply the same text query to two groups already present in this frozen analysis. The comparison reuses its body-only dataset and runs a new, reproducible analysis without rescanning the corpus.") %></p>
          </header>

          <% if @analysis_report.comparison? %>
            <% comparison = @analysis_report.comparison %>
            <% comparison_chart = @analysis_report.special_chart(comparison["chart_key"] || "scope_comparison") %>
            <% comparison_svg = corpus_search_analysis_svg(@analysis_report, comparison_chart) %>
            <article class="corpus-search-comparison-result">
              <h4><%= comparison["left_group"] %> <span aria-hidden="true">↔</span> <%= comparison["right_group"] %></h4>
              <p><%= t("corpus_search.comparison.dimension_note", default: "Compared by %{dimension}.", dimension: corpus_search_analysis_dimension_label(comparison["dimension"])) %></p>
              <% if comparison_svg.present? %>
                <div class="corpus-search-analysis-figure"><%= comparison_svg %></div>
              <% end %>

              <% comparison_rows = @analysis_report.comparison_summary %>
              <% if comparison_rows.any? %>
                <div class="corpus-search-analysis-table-wrap">
                  <table class="corpus-search-analysis-table corpus-search-comparison-table">
                    <thead>
                      <tr>
                        <th><%= t("corpus_search.comparison.table.scope", default: "Scope") %></th>
                        <th><%= t("corpus_search.analysis.metrics.occurrences", default: "Occurrences") %></th>
                        <th><%= t("corpus_search.analysis.metrics.searchable_characters", default: "Searchable characters") %></th>
                        <th><%= t("corpus_search.analysis.metrics.occurrences_per_million", default: "Per million") %></th>
                        <th><%= t("corpus_search.analysis.metrics.document_prevalence", default: "Document prevalence") %></th>
                      </tr>
                    </thead>
                    <tbody>
                      <% comparison_rows.each do |row| %>
                        <tr>
                          <td><strong><%= row["scope_label"] %></strong></td>
                          <td><%= number_with_delimiter(row["occurrences"].to_i) %></td>
                          <td><%= number_with_delimiter(row["searchable_characters"].to_i) %></td>
                          <td><%= number_with_precision(row["occurrences_per_million"].to_f, precision: 3, strip_insignificant_zeros: true) %></td>
                          <td><%= number_to_percentage(row["document_prevalence"].to_f * 100, precision: 2) %></td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% end %>

              <% effects = @analysis_report.comparison_effects %>
              <% if effects.any? %>
                <details class="corpus-search-comparison-effects" open>
                  <summary><%= t("corpus_search.comparison.effect_sizes", default: "Comparison statistics and effect sizes") %></summary>
                  <dl>
                    <% effects.each do |row| %>
                      <div>
                        <dt><%= corpus_search_comparison_effect_label(row["measure"]) %></dt>
                        <dd><%= corpus_search_comparison_effect_value(row["measure"], row["value"]) %></dd>
                      </div>
                    <% end %>
                  </dl>
                  <p class="corpus-search-hint"><%= t("corpus_search.comparison.statistics_note", default: "The left/right rate ratio uses searchable body characters as exposure. The likelihood statistic tests equality of the two occurrence rates; it does not establish historical causation.") %></p>
                </details>
              <% end %>
            </article>
          <% end %>

          <% comparison_dimensions = CorpusSearch::ComparisonDefinition::DIMENSIONS.select { |dimension| @analysis_report.comparison_options(dimension).length >= 2 } %>
          <% if comparison_dimensions.any? %>
            <%= form_with url: prepare_corpus_search_path,
                          method: :post,
                          local: true,
                          class: "corpus-search-comparison-form",
                          data: { controller: "corpus-search-comparison" } do %>
              <%= hidden_field_tag :source_prepared_id, @prepared_search.id %>
              <%= hidden_field_tag :source_prepared_key, @prepared_search.key %>

              <label>
                <span><%= t("corpus_search.comparison.dimension", default: "Compare by") %></span>
                <%= select_tag "comparison[dimension]",
                               options_for_select(comparison_dimensions.map { |dimension| [corpus_search_analysis_dimension_label(dimension), dimension] }, @comparison&.dimension),
                               class: "corpus-search-input",
                               data: {
                                 corpus_search_comparison_target: "dimension",
                                 action: "change->corpus-search-comparison#updateDimension"
                               } %>
              </label>

              <label>
                <span><%= t("corpus_search.comparison.left_scope", default: "Scope A") %></span>
                <%= select_tag "comparison[left_group]",
                               safe_join([
                                 tag.option(t("corpus_search.comparison.choose_group", default: "Choose a group"), value: ""),
                                 corpus_search_comparison_group_options(
                                   @analysis_report,
                                   selected_dimension: @comparison&.dimension,
                                   selected_group: @comparison&.left_group
                                 )
                               ]),
                               class: "corpus-search-input",
                               data: {
                                 corpus_search_comparison_target: "left",
                                 action: "change->corpus-search-comparison#keepDistinct"
                               } %>
              </label>

              <label>
                <span><%= t("corpus_search.comparison.right_scope", default: "Scope B") %></span>
                <%= select_tag "comparison[right_group]",
                               safe_join([
                                 tag.option(t("corpus_search.comparison.choose_group", default: "Choose a group"), value: ""),
                                 corpus_search_comparison_group_options(
                                   @analysis_report,
                                   selected_dimension: @comparison&.dimension,
                                   selected_group: @comparison&.right_group
                                 )
                               ]),
                               class: "corpus-search-input",
                               data: { corpus_search_comparison_target: "right" } %>
              </label>

              <%= submit_tag t("corpus_search.comparison.prepare", default: "Prepare comparison"), class: "corpus-search-button" %>
            <% end %>
          <% else %>
            <p class="corpus-search-hint"><%= t("corpus_search.comparison.not_enough_groups", default: "This analysis does not contain two groups in any supported comparison dimension.") %></p>
          <% end %>
        </section>

        <% top_documents = @analysis_report.table("top_documents", limit: 25) %>
        <% if top_documents.any? %>
          <section class="corpus-search-analysis-table-section">
            <h3><%= t("corpus_search.analysis.top_documents", default: "Documents contributing the most occurrences") %></h3>
            <div class="corpus-search-analysis-table-wrap">
              <table class="corpus-search-analysis-table">
                <thead>
                  <tr>
                    <th><%= t("corpus_search.analysis.table.document", default: "Document") %></th>
                    <th><%= t("corpus_search.analysis.table.layer", default: "Layer") %></th>
                    <th><%= t("corpus_search.analysis.table.occurrences", default: "Occurrences") %></th>
                    <th><%= t("corpus_search.analysis.table.share", default: "Share of all hits") %></th>
                    <th><%= t("corpus_search.analysis.table.per_million", default: "Per million") %></th>
                  </tr>
                </thead>
                <tbody>
                  <% top_documents.each do |row| %>
                    <tr>
                      <td>
                        <strong><%= row["title"].presence || File.basename(row["path"].to_s, ".txt") %></strong>
                        <% if row["author"].present? %><small><%= row["author"] %></small><% end %>
                        <small><%= row["path"] %></small>
                      </td>
                      <td><%= corpus_search_analysis_role_label(row["document_role"]) %></td>
                      <td><%= number_with_delimiter(row["occurrences"].to_i) %></td>
                      <td><%= number_to_percentage(row["occurrence_share"].to_f * 100, precision: 2) %></td>
                      <td><%= number_with_precision(row["occurrences_per_million"].to_f, precision: 2, strip_insignificant_zeros: true) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </section>
        <% end %>

        <% concentration = @analysis_report.table("concentration") %>
        <% if concentration.any? %>
          <% concentration_values = concentration.to_h { |row| [row["measure"], row["value"].to_f] } %>
          <section class="corpus-search-analysis-concentration">
            <h3><%= t("corpus_search.analysis.concentration", default: "Result concentration") %></h3>
            <p>
              <%= t(
                    "corpus_search.analysis.concentration_summary",
                    default: "Top document: %{top1}. Top five: %{top5}. Top ten: %{top10}.",
                    top1: number_to_percentage(concentration_values.fetch("top_1_share", 0) * 100, precision: 2),
                    top5: number_to_percentage(concentration_values.fetch("top_5_share", 0) * 100, precision: 2),
                    top10: number_to_percentage(concentration_values.fetch("top_10_share", 0) * 100, precision: 2)
                  ) %>
            </p>
          </section>
        <% end %>

        <% if @analysis_report.warnings.any? %>
          <details class="corpus-search-analysis-warnings">
            <summary><%= t("corpus_search.analysis.warnings", default: "Analysis notes and warnings") %></summary>
            <ul>
              <% @analysis_report.warnings.each do |warning| %>
                <li><%= warning %></li>
              <% end %>
            </ul>
          </details>
        <% end %>

        <section class="corpus-search-analysis-download-note">
          <h3><%= t("corpus_search.analysis.reproducibility", default: "Reproducibility files") %></h3>
          <p><%= t("corpus_search.analysis.reproducibility_note_phase9", default: "The frozen bundle includes the exact Ruby script, body-only input tables, grouped and advanced analysis tables, figures, exact-body sensitivity data, method text, citation text, a corpus snapshot identifier, SHA-256 checksums, warnings, timing, and runtime information.") %></p>
          <% if @frozen_record %>
            <dl class="corpus-search-reproducibility-record">
              <div><dt><%= t("corpus_search.analysis.snapshot_id", default: "Corpus snapshot") %></dt><dd><code><%= @frozen_record.dig("corpus_snapshot", "snapshot_id") %></code></dd></div>
              <div><dt><%= t("corpus_search.analysis.record_id", default: "Prepared record") %></dt><dd><code><%= @prepared_search.id %></code></dd></div>
              <div><dt><%= t("corpus_search.analysis.completed_at", default: "Completed") %></dt><dd><%= @frozen_record["completed_at"] %></dd></div>
              <div><dt><%= t("corpus_search.analysis.artifact_count", default: "Verified artifacts") %></dt><dd><%= Array(@frozen_record["artifacts"]).length %></dd></div>
            </dl>
          <% end %>
          <div class="corpus-search-summary-actions">
            <%= link_to t("corpus_search.actions.download_zip"), "/corpus/search/prepared/#{@prepared_search.id}/download?key=#{ERB::Util.url_encode(@prepared_search.key)}", class: "corpus-search-button" %>
          </div>

          <% if @methods_text.present? %>
            <details>
              <summary><%= t("corpus_search.analysis.methods_summary", default: "Citation-ready methods summary") %></summary>
              <pre class="corpus-search-research-text"><%= @methods_text %></pre>
            </details>
          <% end %>
          <% if @citation_text.present? %>
            <details>
              <summary><%= t("corpus_search.analysis.suggested_citation", default: "Suggested citation") %></summary>
              <pre class="corpus-search-research-text"><%= @citation_text %></pre>
            </details>
          <% end %>
        </section>
      <% else %>
        <div class="corpus-search-analysis-unavailable">
          <h2><%= t("corpus_search.analysis.unavailable", default: "Analysis is unavailable") %></h2>
          <p><%= t("corpus_search.analysis.unavailable_note", default: "The search export completed, but no analysis report was produced. The ZIP still contains the input data, exact Ruby script, warnings, and runtime metadata so the analysis can be run elsewhere.") %></p>
        </div>
      <% end %>
    </section>

  <% elsif @prepared_search.failed? %>
    <p class="corpus-search-error"><%= payload["error_message"] %></p>
  <% else %>
    <p><%= t("corpus_search.prepared.poll_notice", default: "Progress updates automatically while the background job is running. You may leave this page and return using the frozen URL.") %></p>
  <% end %>
<% end %>
