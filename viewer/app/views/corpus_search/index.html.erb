<h1><%= t("corpus_search.title") %></h1>

<p class="corpus-search-note"><%= t("corpus_search.introduction") %></p>

<nav class="corpus-search-scope-tabs" aria-label="<%= t("corpus_search.scope_tabs.aria_label") %>">
  <%= link_to t("corpus_search.scope_tabs.targeted"), corpus_search_path, class: "corpus-search-scope-tab", aria: { current: (@search_scope == "targeted" ? "page" : nil) } %>
  <%= link_to t("corpus_search.scope_tabs.full"), corpus_search_path(search_scope: "full"), class: "corpus-search-scope-tab", aria: { current: (@search_scope == "full" ? "page" : nil) } %>
</nav>

<% if @search_scope == "full" %>
  <section class="corpus-search-full-intro">
    <h2><%= t("corpus_search.full_search.heading") %></h2>
    <p><%= t("corpus_search.full_search.introduction") %></p>
    <p><%= t("corpus_search.full_search.github_html", url: "https://github.com/fanyahanwen") %></p>
  </section>
<% end %>

<% form_url = @search_scope == "full" ? prepare_corpus_search_path : corpus_search_path %>
<% form_method = @search_scope == "full" ? :post : :get %>

<%= form_with url: form_url,
              method: form_method,
              local: true,
              class: "corpus-search-form",
              data: {
                controller: "corpus-search-form",
                corpus_search_form_max_terms_value: CorpusSearch::SearchDefinition::MAX_MULTI_TERMS,
                corpus_search_form_term_placeholder_value: t("corpus_search.placeholders.term", number: "__NUMBER__")
              } do %>
  <%= hidden_field_tag :search_scope, @search_scope %>
  <%= hidden_field_tag :mode, @query.mode, data: { corpus_search_form_target: "mode" } %>

  <div class="corpus-search-mode-switch" role="group" aria-label="<%= t("corpus_search.form.mode") %>">
    <% ["exact", "proximity", "alternatives"].each do |mode| %>
      <button type="button"
              class="corpus-search-mode-button"
              data-corpus-search-form-target="modeButton"
              data-mode="<%= mode %>"
              data-action="corpus-search-form#selectMode"
              aria-pressed="<%= @query.mode == mode %>">
        <%= t("corpus_search.modes.#{mode}") %>
      </button>
    <% end %>
  </div>

  <section class="corpus-search-primary-panel"
           data-corpus-search-form-target="exactPanel"
           <%= "hidden" unless @query.exact? %>>
    <label class="corpus-search-wide-label">
      <span><%= t("corpus_search.form.search_text") %></span>
      <%= text_field_tag :q,
                         @query.query_text,
                         class: "corpus-search-input corpus-search-query-input",
                         maxlength: 80,
                         placeholder: t("corpus_search.placeholders.sequence"),
                         disabled: !@query.exact?,
                         data: { corpus_search_form_target: "exactInput" } %>
    </label>
  </section>

  <section class="corpus-search-primary-panel"
           data-corpus-search-form-target="termsPanel"
           <%= "hidden" if @query.exact? %>>
    <p class="corpus-search-field-heading"
       data-corpus-search-form-target="proximityHeading"
       <%= "hidden" unless @query.proximity? %>><%= t("corpus_search.form.find_all_terms") %></p>
    <p class="corpus-search-field-heading"
       data-corpus-search-form-target="alternativesHeading"
       <%= "hidden" unless @query.alternatives? %>><%= t("corpus_search.form.find_any_term") %></p>
    <p class="corpus-search-hint"
       data-corpus-search-form-target="alternativesHint"
       <%= "hidden" unless @query.alternatives? %>><%= t("corpus_search.form.alternatives_hint") %></p>

    <% multi_terms = @query.terms.dup %>
    <% multi_terms << "" while multi_terms.length < 2 %>
    <div class="corpus-search-term-list" data-corpus-search-form-target="termList">
      <% multi_terms.each_with_index do |term, index| %>
        <div class="corpus-search-term-row" data-corpus-search-term-row>
          <span class="corpus-search-term-number"><%= index + 1 %></span>
          <%= text_field_tag "terms[]",
                             term,
                             class: "corpus-search-input",
                             maxlength: 80,
                             placeholder: t("corpus_search.placeholders.term", number: index + 1),
                             disabled: @query.exact?,
                             data: { corpus_search_form_target: "multiTermInput", corpus_search_term_input: true } %>
          <button type="button"
                  class="corpus-search-icon-button"
                  data-action="corpus-search-form#removeTerm"
                  <%= "hidden" if multi_terms.length <= 2 %>
                  aria-label="<%= t("corpus_search.actions.remove_term", number: index + 1) %>">
            <%= t("corpus_search.actions.remove") %>
          </button>
        </div>
      <% end %>
    </div>

    <template data-corpus-search-form-target="termTemplate">
      <div class="corpus-search-term-row" data-corpus-search-term-row>
        <span class="corpus-search-term-number"></span>
        <input type="text"
               name="terms[]"
               maxlength="80"
               class="corpus-search-input"
               data-corpus-search-form-target="multiTermInput"
               data-corpus-search-term-input="true">
        <button type="button"
                class="corpus-search-icon-button"
                data-action="corpus-search-form#removeTerm">
          <%= t("corpus_search.actions.remove") %>
        </button>
      </div>
    </template>

    <div>
      <button type="button"
              class="corpus-search-button corpus-search-button-secondary"
              data-corpus-search-form-target="addTermButton"
              data-action="corpus-search-form#addTerm">
        <%= t("corpus_search.actions.add_term") %>
      </button>
      <span class="corpus-search-hint"><%= t("corpus_search.form.term_limit", max: CorpusSearch::SearchDefinition::MAX_MULTI_TERMS) %></span>
    </div>

    <div class="corpus-search-grid corpus-search-grid-compact"
         data-corpus-search-form-target="proximityOptions"
         <%= "hidden" unless @query.proximity? %>>
      <label>
        <%= t("corpus_search.form.maximum_span") %>
        <%= number_field_tag :span,
                             @query.maximum_span,
                             min: 1,
                             max: 5000,
                             class: "corpus-search-input",
                             disabled: !@query.proximity?,
                             data: { corpus_search_form_target: "proximityInput" } %>
      </label>

      <label>
        <%= t("corpus_search.form.order") %>
        <%= select_tag :order,
                       options_for_select([
                         [t("corpus_search.orders.any"), "any"],
                         [t("corpus_search.orders.entered"), "entered"]
                       ], @query.order),
                       class: "corpus-search-input",
                       disabled: !@query.proximity?,
                       data: { corpus_search_form_target: "proximityInput" } %>
      </label>
    </div>
  </section>

  <fieldset class="corpus-search-folder-fieldset">
    <legend><%= t("corpus_search.form.folder_scope") %></legend>
    <p class="corpus-search-hint"><%= t("corpus_search.form.folder_hint") %></p>

    <% if @folder_tree&.empty? %>
      <p class="corpus-search-folder-unavailable"><%= t("corpus_search.errors.folder_tree_unavailable") %></p>
    <% else %>
      <div class="corpus-search-folder-tree" role="tree">
        <%= corpus_search_folder_tree(@folder_tree, @query) %>
      </div>
    <% end %>
  </fieldset>

  <div class="corpus-search-core-options">
    <%= hidden_field_tag :punctuation, "respect" %>
    <label class="corpus-search-check">
      <%= check_box_tag :punctuation, "ignore", @query.ignore_punctuation? %>
      <span><%= t("corpus_search.form.ignore_punctuation") %></span>
    </label>

    <% character_options = CorpusSearch::SearchDefinition::CHARACTER_EQUIVALENCE_LEVELS.map do |level|
         [
           t("corpus_search.characters.#{level}"),
           level,
           { "data-hint" => t("corpus_search.character_hints.#{level}") }
         ]
       end %>
    <label class="corpus-search-character-control">
      <span><%= t("corpus_search.form.character_matching") %></span>
      <%= select_tag :characters,
                     options_for_select(character_options, @query.character_equivalence),
                     class: "corpus-search-input corpus-search-character-select",
                     data: {
                       corpus_search_form_target: "characterMatching",
                       action: "change->corpus-search-form#updateCharacterHint"
                     } %>
    </label>
    <span class="corpus-search-hint corpus-search-character-hint"
          data-corpus-search-form-target="characterHint"><%= t("corpus_search.character_hints.#{@query.character_equivalence}") %></span>
    <span class="corpus-search-rule"><%= t("corpus_search.form.body_only_rule") %></span>
    <label class="corpus-search-check">
      <%= check_box_tag :deduplicate, "1", @query.deduplicate_exact_bodies? %>
      <span>Count each exact body only once</span>
    </label>
    <span class="corpus-search-hint">Useful when exact copies would otherwise dominate results. Distinct editions with different text remain separate.</span>
  </div>

  <details class="corpus-search-filters" <%= "open" if @query.metadata_filters.values.any?(&:present?) || @query.document_roles != CorpusSearch::DocumentRole::DEFAULT_ROLES %>>
    <summary><%= t("corpus_search.form.additional_filters") %></summary>

    <div class="corpus-search-grid">
      <fieldset class="corpus-search-role-fieldset corpus-search-wide-label">
        <legend><%= t("corpus_search.form.text_witnesses") %></legend>
        <p class="corpus-search-hint"><%= t("corpus_search.form.text_witnesses_hint") %></p>
        <div class="corpus-search-role-options">
          <% CorpusSearch::DocumentRole::SEARCHABLE_ROLES.each do |role| %>
            <label class="corpus-search-check">
              <%= check_box_tag "roles[]", role, @query.document_roles.include?(role) %>
              <span><%= t("corpus_search.roles.#{role}") %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <label>
        <%= t("corpus_search.form.nation") %>
        <%= text_field_tag :nation, @query.metadata_filters["nation"], class: "corpus-search-input", placeholder: t("corpus_search.placeholders.nation") %>
      </label>

      <label>
        <%= t("corpus_search.form.polity", default: "Polity") %>
        <%= text_field_tag :polity, @query.metadata_filters["polity"], class: "corpus-search-input", placeholder: t("corpus_search.placeholders.polity", default: "商 / 周 / 大清...") %>
      </label>

      <label>
        <%= t("corpus_search.form.period") %>
        <%= text_field_tag :period, @query.metadata_filters["period"], class: "corpus-search-input", placeholder: t("corpus_search.placeholders.period") %>
      </label>

      <label>
        <%= t("corpus_search.form.region") %>
        <%= text_field_tag :region, @query.metadata_filters["region"], class: "corpus-search-input" %>
      </label>

      <label>
        <%= t("corpus_search.form.author") %>
        <%= text_field_tag :author, @query.metadata_filters["author"], class: "corpus-search-input" %>
      </label>

      <label>
        <%= t("corpus_search.form.year_from") %>
        <%= number_field_tag :year_start, @query.metadata_filters["year_start"], class: "corpus-search-input" %>
      </label>

      <label>
        <%= t("corpus_search.form.year_to") %>
        <%= number_field_tag :year_end, @query.metadata_filters["year_end"], class: "corpus-search-input" %>
      </label>

      <label>
        <%= t("corpus_search.form.context_characters") %>
        <%= number_field_tag :context, @query.context, min: 0, max: 200, class: "corpus-search-input" %>
      </label>

      <label>
        <%= t("corpus_search.form.results_per_page") %>
        <%= number_field_tag :per_page, @query.per_page, min: 1, max: 50, class: "corpus-search-input" %>
      </label>
    </div>
  </details>

  <% if @search_scope == "full" %>
    <section class="corpus-search-email-option">
      <label class="corpus-search-wide-label">
        <span><%= t("corpus_search.full_search.email_label") %></span>
        <%= email_field_tag :notification_email, nil, class: "corpus-search-input", autocomplete: "email", maxlength: 254, placeholder: t("corpus_search.full_search.email_placeholder") %>
      </label>
      <p class="corpus-search-hint"><%= t("corpus_search.full_search.email_hint") %></p>
    </section>
  <% end %>

  <div class="corpus-search-actions">
    <% submit_label = @search_scope == "full" ? t("corpus_search.actions.request_full_search") : t("corpus_search.actions.search") %>
    <%= button_tag submit_label, type: "submit", class: "corpus-search-button", name: "search", value: "1" %>
  </div>
<% end %>

<% if @search_error.present? %>
  <p class="corpus-search-error"><%= @search_error %></p>
<% end %>

<% if @searched && @query.errors.any? %>
  <div class="corpus-search-error">
    <% @query.errors.each do |error| %>
      <p><%= error %></p>
    <% end %>
  </div>
<% end %>

<% if @result_page %>
  <section class="corpus-search-summary">
    <div>
      <p><%= t("corpus_search.results.summary", visible: @result_page.hits.length, candidates: @result_page.candidate_files, scanned: @result_page.scanned_files) %></p>

      <% if @result_page.truncated %>
        <p><%= t("corpus_search.results.truncated", limit: CorpusSearchController::INTERACTIVE_LIMIT) %></p>
      <% elsif @result_page.complete %>
        <p><%= t("corpus_search.results.complete_count", count: @result_page.total) %></p>
      <% end %>
    </div>

    <% if @query.valid? %>
      <div class="corpus-search-summary-actions" data-controller="copy-url" data-copy-url-url-value="<%= @live_query_url %>" data-copy-url-success-label-value="<%= t("corpus_search.actions.copied") %>">
        <button type="button" class="corpus-search-button corpus-search-button-secondary" data-copy-url-target="button" data-action="copy-url#copy">
          <%= t("corpus_search.actions.copy_live_url") %>
        </button>

      </div>
    <% end %>
  </section>

  <% if @query.valid? %>
    <nav class="corpus-search-workspace-tabs" aria-label="<%= t("corpus_search.analysis.workspace", default: "Search workspace") %>">
      <a href="#results" class="corpus-search-workspace-tab" aria-current="page"><%= t("corpus_search.analysis.tabs.results", default: "Results") %></a>
      <%= form_with url: prepare_corpus_search_path, method: :post, local: true, class: "corpus-search-workspace-tab-form" do %>
        <%= hidden_field_tag :full_search, "1" %>
        <% @query.canonical_params(include_presentation: true).each do |key, value| %>
          <%= hidden_field_tag key, value %>
        <% end %>
        <%= submit_tag t("corpus_search.actions.prepare_analysis", default: "Prepare complete analysis in background"), class: "corpus-search-workspace-tab corpus-search-workspace-tab-button" %>
      <% end %>
      <a href="#query-details" class="corpus-search-workspace-tab"><%= t("corpus_search.analysis.tabs.query_details", default: "Query details") %></a>
    </nav>

    <details id="query-details" class="corpus-search-query-details">
      <summary><%= t("corpus_search.query_details.heading") %></summary>
      <dl>
        <div><dt><%= t("corpus_search.query_details.mode") %></dt><dd><%= t("corpus_search.modes.#{@query.mode}") %></dd></div>
        <div><dt><%= t("corpus_search.query_details.query") %></dt><dd><code><%= @query.display_label %></code></dd></div>
        <div><dt><%= t("corpus_search.query_details.punctuation") %></dt><dd><%= t("corpus_search.punctuation.#{@query.punctuation}") %></dd></div>
        <div><dt><%= t("corpus_search.query_details.character_matching") %></dt><dd><%= t("corpus_search.characters.#{@query.character_equivalence}") %></dd></div>
        <div><dt><%= t("corpus_search.query_details.equivalence_registry") %></dt><dd><code><%= @query.character_equivalence_version %></code></dd></div>
        <div><dt><%= t("corpus_search.query_details.text_witnesses") %></dt><dd><%= @query.document_roles.map { |role| t("corpus_search.roles.#{role}") }.join(", ") %></dd></div>
        <div><dt><%= t("corpus_search.query_details.folders") %></dt><dd><%= @query.include_folders.presence&.join("; ") || t("corpus_search.query_details.all_selected_folders") %></dd></div>
        <% if @query.exclude_folders.any? %>
          <div><dt><%= t("corpus_search.query_details.excluded_folders") %></dt><dd><%= @query.exclude_folders.join("; ") %></dd></div>
        <% end %>
        <div><dt><%= t("corpus_search.query_details.metadata") %></dt><dd><%= t("corpus_search.query_details.never_searched") %></dd></div>
        <div><dt><%= t("corpus_search.query_details.profile") %></dt><dd><%= @query.normalization_profile_version %></dd></div>
        <div class="corpus-search-query-url"><dt><%= t("corpus_search.query_details.live_url") %></dt><dd><code><%= @live_query_url %></code></dd></div>
      </dl>
    </details>
  <% end %>

  <% if @result_page.hits.any? %>
    <ol id="results" class="corpus-search-results" start="<%= ((@result_page.page - 1) * @result_page.per_page) + 1 %>">
      <% @result_page.hits.each do |hit| %>
        <% source_url = hit["source_url"].presence || CorpusSearch::SourceLink.relative_url(path: hit["path"], start_offset: hit["start_offset"], end_offset: hit["end_offset"]) %>
        <li class="corpus-search-result">
          <h2>
            <%= hit["title"].presence || File.basename(hit["path"].to_s, ".txt") %>
            <% unless hit["document_role"] == "canonical" %>
              <span class="corpus-search-role-badge"><%= t("corpus_search.roles.#{hit["document_role"]}") %></span>
            <% end %>
          </h2>
          <p class="corpus-search-meta">
            <% [hit["author"], hit["date_text"], hit["corpus_root"], hit["macro_region"], hit["polity"], hit["period"], hit["region"]].reject(&:blank?).uniq.each do |item| %>
              <span><%= item %></span>
            <% end %>
          </p>

          <% if @query.alternatives? %>
            <% matched_alternatives = Array(hit["term_matches"]).map { |match| match["term"].to_s }.reject(&:blank?).uniq %>
            <p class="corpus-search-matched-alternatives"><%= t("corpus_search.results.matched_alternatives", terms: matched_alternatives.join(" OR ")) %></p>
          <% end %>

          <p class="corpus-search-snippet"><%= corpus_search_snippet(hit) %></p>

          <% if Array(hit["equivalence_matches"]).any? %>
            <details class="corpus-search-equivalence-details">
              <summary><%= t("corpus_search.results.equivalent_forms_used", count: hit["equivalence_matches"].length) %></summary>
              <ul>
                <% corpus_search_unique_equivalence_matches(hit).each do |match| %>
                  <li><%= corpus_search_equivalence_explanation(match) %></li>
                <% end %>
              </ul>
            </details>
          <% end %>

          <p class="corpus-search-path">
            <%= link_to t("corpus_search.actions.open_source_text"), source_url %>
            <% if hit["document_role"] == "textual_variant" && hit["canonical_parent_path"].present? %>
              <%= link_to t("corpus_search.actions.open_received_text_folder"), corpus_viewer_path(hit["canonical_parent_path"].to_s.split("/"), format: nil) %>
            <% end %>
            <span><%= t("corpus_search.results.offset", start: hit["start_offset"], finish: hit["end_offset"]) %></span>
          </p>
        </li>
      <% end %>
    </ol>

    <nav class="corpus-search-pagination" aria-label="<%= t("corpus_search.pagination.aria_label") %>">
      <% if @result_page.previous_page %>
        <%= link_to t("corpus_search.pagination.previous"), @query.relative_url(page: @result_page.previous_page) %>
      <% end %>
      <span><%= t("corpus_search.pagination.page_of", page: @result_page.page, pages: @result_page.total_pages) %></span>
      <% if @result_page.next_page %>
        <%= link_to t("corpus_search.pagination.next"), @query.relative_url(page: @result_page.next_page) %>
      <% end %>
    </nav>
  <% elsif @searched && @query.valid? %>
    <p><%= t("corpus_search.results.none") %></p>
  <% end %>
<% end %>
