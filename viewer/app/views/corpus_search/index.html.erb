<h1><%= t("corpus_search.title") %></h1>

<p class="corpus-search-note">
  <%= t("corpus_search.introduction") %>
</p>

<%= form_with url: "/corpus/search", method: :get, local: true, class: "corpus-search-form" do %>
  <div class="corpus-search-grid">
    <label>
      <%= t("corpus_search.form.mode") %>
      <%= select_tag :mode,
        options_for_select([
          [t("corpus_search.modes.exact"), "exact"],
          [t("corpus_search.modes.proximity"), "proximity"]
        ], @query&.mode || "exact"),
        class: "corpus-search-input" %>
    </label>

    <label>
      <%= t("corpus_search.form.term_a") %>
      <%= text_field_tag :term_a, @query&.term_a, class: "corpus-search-input", maxlength: 80, placeholder: t("corpus_search.placeholders.term_a") %>
    </label>

    <label>
      <%= t("corpus_search.form.term_b") %>
      <%= text_field_tag :term_b, @query&.term_b, class: "corpus-search-input", maxlength: 80, placeholder: t("corpus_search.placeholders.term_b") %>
    </label>

    <label>
      <%= t("corpus_search.form.distance") %>
      <%= number_field_tag :distance, @query&.distance || 200, min: 1, max: 5000, class: "corpus-search-input" %>
    </label>

    <label>
      <%= t("corpus_search.form.order") %>
      <%= select_tag :order,
        options_for_select([
          [t("corpus_search.orders.either"), "either"],
          [t("corpus_search.orders.a_before_b"), "a_before_b"],
          [t("corpus_search.orders.b_before_a"), "b_before_a"]
        ], @query&.order || "either"),
        class: "corpus-search-input" %>
    </label>

    <label>
      <%= t("corpus_search.form.context_characters") %>
      <%= number_field_tag :context, @query&.context || 20, min: 0, max: 200, class: "corpus-search-input" %>
    </label>

    <label>
      <%= t("corpus_search.form.results_per_page") %>
      <%= number_field_tag :per_page, @query&.per_page || 20, min: 1, max: 50, class: "corpus-search-input" %>
    </label>
  </div>

  <details class="corpus-search-filters">
    <summary><%= t("corpus_search.form.metadata_filters") %></summary>
    <div class="corpus-search-grid">
      <label>
        <%= t("corpus_search.form.nation") %>
        <%= text_field_tag :nation, @query&.filters&.dig("nation"), class: "corpus-search-input", placeholder: t("corpus_search.placeholders.nation") %>
      </label>

      <label>
        <%= t("corpus_search.form.period") %>
        <%= text_field_tag :period, @query&.filters&.dig("period"), class: "corpus-search-input", placeholder: t("corpus_search.placeholders.period") %>
      </label>

      <label>
        <%= t("corpus_search.form.region") %>
        <%= text_field_tag :region, @query&.filters&.dig("region"), class: "corpus-search-input" %>
      </label>

      <label>
        <%= t("corpus_search.form.author") %>
        <%= text_field_tag :author, @query&.filters&.dig("author"), class: "corpus-search-input" %>
      </label>

      <label>
        <%= t("corpus_search.form.year_from") %>
        <%= number_field_tag :year_start, @query&.filters&.dig("year_start"), class: "corpus-search-input" %>
      </label>

      <label>
        <%= t("corpus_search.form.year_to") %>
        <%= number_field_tag :year_end, @query&.filters&.dig("year_end"), class: "corpus-search-input" %>
      </label>
    </div>
  </details>

  <div class="corpus-search-actions">
    <%= submit_tag t("corpus_search.actions.search"), class: "corpus-search-button" %>
  </div>
<% end %>

<% if @search_error.present? %>
  <p class="corpus-search-error"><%= @search_error %></p>
<% end %>

<% if @searched && @query.errors.any? %>
  <div class="corpus-search-error">
    <% @query.errors.each do |error| %>
      <p><%= error %></p>
    <% end %>
  </div>
<% end %>

<% if @result_page %>
  <section class="corpus-search-summary">
    <p>
      <%= t("corpus_search.results.summary",
            visible: @result_page.hits.length,
            candidates: @result_page.candidate_files,
            scanned: @result_page.scanned_files) %>
    </p>

    <% if @result_page.truncated %>
      <p>
        <%= t("corpus_search.results.truncated", limit: CorpusSearchController::INTERACTIVE_LIMIT) %>
      </p>
    <% elsif @result_page.complete %>
      <p><%= t("corpus_search.results.complete_count", count: @result_page.total) %></p>
    <% end %>

    <% if @query.valid? %>
      <%= form_with url: "/corpus/search/prepare", method: :post, local: true do %>
        <% @query.to_h.each do |key, value| %>
          <% if key == "filters" %>
            <% value.each do |filter_key, filter_value| %>
              <%= hidden_field_tag filter_key, filter_value %>
            <% end %>
          <% elsif value.is_a?(Array) %>
            <% value.each do |item| %>
              <%= hidden_field_tag "#{key}[]", item %>
            <% end %>
          <% else %>
            <%= hidden_field_tag key, value %>
          <% end %>
        <% end %>
        <%= submit_tag t("corpus_search.actions.prepare_export"), class: "corpus-search-button corpus-search-button-secondary" %>
      <% end %>
    <% end %>
  </section>

  <% if @result_page.hits.any? %>
    <ol class="corpus-search-results" start="<%= ((@result_page.page - 1) * @result_page.per_page) + 1 %>">
      <% @result_page.hits.each do |hit| %>
        <li class="corpus-search-result">
          <h2><%= hit["title"].presence || File.basename(hit["path"].to_s, ".txt") %></h2>
          <p class="corpus-search-meta">
            <% [hit["author"], hit["date_text"], hit["nation"], hit["period"], hit["region"]].reject(&:blank?).each do |item| %>
              <span><%= item %></span>
            <% end %>
          </p>

          <p class="corpus-search-snippet">
            <span class="corpus-search-context"><%= hit["left_context"] %></span><mark><%= hit["matched_text"] %></mark><span class="corpus-search-context"><%= hit["right_context"] %></span>
          </p>

          <p class="corpus-search-path">
            <%= link_to t("corpus_search.actions.open_source_text"), corpus_viewer_path(hit["path"].to_s.split("/"), format: nil) %>
            <span><%= t("corpus_search.results.offset", start: hit["start_offset"], finish: hit["end_offset"]) %></span>
          </p>
        </li>
      <% end %>
    </ol>

    <nav class="corpus-search-pagination" aria-label="<%= t("corpus_search.pagination.aria_label") %>">
      <% base_params = request.query_parameters.except("page") %>
      <% if @result_page.previous_page %>
        <%= link_to t("corpus_search.pagination.previous"), "/corpus/search?#{base_params.merge(page: @result_page.previous_page).to_query}" %>
      <% end %>
      <span><%= t("corpus_search.pagination.page_of", page: @result_page.page, pages: @result_page.total_pages) %></span>
      <% if @result_page.next_page %>
        <%= link_to t("corpus_search.pagination.next"), "/corpus/search?#{base_params.merge(page: @result_page.next_page).to_query}" %>
      <% end %>
    </nav>
  <% elsif @searched && @query.valid? %>
    <p><%= t("corpus_search.results.none") %></p>
  <% end %>
<% end %>
