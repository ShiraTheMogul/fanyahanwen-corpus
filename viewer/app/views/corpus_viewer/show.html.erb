<h1>Corpus Viewer</h1>

<p class="crumbs">
  <% if @rel_path.present? %>
    <% parts = @rel_path.to_s.split("/") %>
    <%= link_to "Root", corpus_viewer_path %>
    <% acc = [] %>
    <% parts.each do |part| %>
      <% acc << part %>
      <span class="crumb-sep">/</span>
      <%= link_to part, corpus_viewer_path(acc, format: nil) %>
    <% end %>
  <% end %>
</p>

<% if @kind == :dir %>
  <p><strong><%= @rel_path.present? ? @rel_path : "Root" %></strong></p>

  <% if @rel_path.to_s.split("/").include?("clean") %>
    <div class="corpus-dir-actions"
         data-controller="corpus-submission-ticket"
         data-corpus-submission-ticket-source-value="corpus_viewer"
         data-corpus-submission-ticket-parent-path-value="<%= @rel_path %>"
         data-corpus-submission-ticket-lock-parent-path-value="true">
      <button type="button"
              class="corpus-btn corpus-btn-editing"
              data-action="corpus-submission-ticket#toggle"
              title="Propose a new text for this folder">
        Submit text here
      </button>

      <div class="cv-text-edit-panel cv-submission-panel hidden" data-corpus-submission-ticket-target="panel">
        <h3 style="margin-top: 0;">Submit a new text (creates a ticket)</h3>
        <p class="cv-hint">This does <em>not</em> write into the corpus directly. It creates a review ticket with a diff for one new work folder and one or more new files inside it.</p>

        <form data-action="submit->corpus-submission-ticket#submit">
          <div class="cv-form-row">
            <label>Parent clean directory</label>
            <input type="text" class="cv-input cv-mono" data-corpus-submission-ticket-target="parentPath" />
          </div>
          <div class="cv-form-row">
            <label>Work folder</label>
            <input type="text" class="cv-input" placeholder="e.g. 皇黎一統志 or 在海牙府" data-corpus-submission-ticket-target="workFolder" />
          </div>
          <div class="cv-form-row">
            <label>Ticket title</label>
            <input type="text" class="cv-input" value="Corpus text submission" data-corpus-submission-ticket-target="title" />
          </div>
          <div class="cv-form-row">
            <label>Short summary</label>
            <input type="text" class="cv-input" placeholder="What is being submitted?" data-corpus-submission-ticket-target="summary" />
          </div>
          <div class="cv-form-row">
            <label>Content role</label>
            <select class="cv-input" data-corpus-submission-ticket-target="textType">
              <option value="source">Source text</option>
              <option value="kanbun">Kanbun annotation system</option>
              <option value="hanmun">Hanmun annotation system</option>
              <option value="hanvan">Hanvan annotation system</option>
            </select>
          </div>

          <div class="cv-form-row">
            <label>NATION</label>
            <input type="text" class="cv-input" data-corpus-submission-ticket-target="nation" />
          </div>
          <div class="cv-form-row">
            <label>WORK_TITLE</label>
            <input type="text" class="cv-input" data-corpus-submission-ticket-target="workTitle" />
          </div>
          <div class="cv-form-row">
            <label>AUTHOR</label>
            <input type="text" class="cv-input" data-corpus-submission-ticket-target="author" />
          </div>
          <div class="cv-form-row">
            <label>SOURCE</label>
            <input type="text" class="cv-input" placeholder="Write a reference here (ideally APA 7th)" data-corpus-submission-ticket-target="sourceCitation" />
          </div>
          <div class="cv-form-row">
            <label>URL</label>
            <input type="url" class="cv-input" placeholder="https://..." data-corpus-submission-ticket-target="url" />
          </div>
          <div class="cv-form-row">
            <label>Context and rights</label>
            <textarea class="cv-textarea" rows="4" placeholder="Explain where this text is from, whether it is public domain, what licence applies, and any context a reviewer should know." data-corpus-submission-ticket-target="contextDetails"></textarea>
          </div>
          <div class="cv-form-row">
            <label>Reference files</label>
            <input type="file" class="cv-input" multiple data-corpus-submission-ticket-target="uploads" />
            <div class="cv-hint">Optional: up to 10 files and 20 MB in total. HTML, XHTML, and SVG are rejected.</div>
          </div>
          <div class="cv-form-row">
            <label>Page setup</label>
            <select class="cv-input" data-corpus-submission-ticket-target="pageMode" data-action="change->corpus-submission-ticket#togglePageMode">
              <option value="single">Single text file</option>
              <option value="multi">Multiple page files</option>
            </select>
          </div>

          <div data-corpus-submission-ticket-target="singleFields">
            <div class="cv-form-row">
              <label>File name</label>
              <input type="text" class="cv-input" placeholder="Defaults to work_folder.txt" data-corpus-submission-ticket-target="fileName" />
            </div>
            <div class="cv-form-row">
              <label>PAGE_TITLE</label>
              <input type="text" class="cv-input" data-corpus-submission-ticket-target="pageTitle" />
            </div>
            <div class="cv-form-row">
              <label>Text body</label>
              <textarea class="cv-textarea cv-mono" rows="16" data-corpus-submission-ticket-target="body"></textarea>
            </div>
          </div>

          <div data-corpus-submission-ticket-target="multiFields" hidden>
            <div class="cv-form-row">
              <label>Pages</label>
              <div data-corpus-submission-ticket-target="pagesList"></div>
            </div>
            <div class="cv-form-actions">
              <button type="button" class="corpus-btn" data-action="corpus-submission-ticket#addPage">Add page</button>
            </div>
            <p class="cv-hint">Multiple pages create numbered files like <code>work_folder__juan_0001.txt</code> inside the work folder.</p>
          </div>

          <%= render "corpus_viewer/ticket_optional_fields",
                     stimulus_controller: "corpus-submission-ticket",
                     include_uploads: false %>

          <div class="cv-form-actions">
            <button type="submit" class="corpus-btn corpus-btn-primary">Submit ticket</button>
            <button type="button" class="corpus-btn" data-action="corpus-submission-ticket#toggle">Close</button>
          </div>
        </form>

        <div class="cv-ticket-result">
          <div class="cv-ticket-status" data-corpus-submission-ticket-target="status"></div>
          <div class="cv-ticket-kv">
            <div><strong>Ticket ID:</strong> <span data-corpus-submission-ticket-target="ticketId"></span></div>
            <div>
              <strong>Ticket key (save this):</strong>
              <code data-corpus-submission-ticket-target="ticketKey"></code>
              <button type="button" class="corpus-btn" data-corpus-submission-ticket-target="copyKeyBtn" data-action="corpus-submission-ticket#copyKey">Copy</button>
              <button type="button" class="corpus-btn" data-corpus-submission-ticket-target="downloadKeyBtn" data-action="corpus-submission-ticket#downloadKey" hidden>Download .txt</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <ul class="corpus-list">
    <% @children.each do |name| %>
      <% child_rel = @rel_path.present? ? "#{@rel_path}/#{name}" : name %>
      <li>
        <%= link_to name, corpus_viewer_path(child_rel.split("/"), format: nil) %>
      </li>
    <% end %>
  </ul>

<% elsif @kind == :file %>
  <%= render "rightbar" %>

<%
  meta_hash = (defined?(@meta) && @meta.respond_to?(:to_h)) ? @meta.to_h : {}

  meta_work       = meta_hash["Work"].to_s.strip
  meta_author     = meta_hash["Author"].to_s.strip
  meta_ws_cats    = meta_hash["Ws Categories"].to_s.strip
  meta_page_title = meta_hash["Page title"].to_s.strip # to derive wikisource links

  derived_work = begin
    File.basename(File.dirname(@source_rel_path.to_s))
  rescue
    ""
  end
  meta_work = derived_work if meta_work.blank? && derived_work.present?

  annotation_system_labels = {
    "kanbun" => "Kanbun",
    "hanmun" => "Hanmun",
    "hanvan" => "Hanvan"
  }
  translation_label_for = lambda do |translation|
    language = translation["language_name"].presence || translation["language_code"].to_s.upcase
    translator = translation["translator_name"].presence
    translator = "Author-provided" if translator.blank? && Array(translation["provenance"]).include?("author_provided")
    [language, translator].compact.join(" — ")
  end
  active_view_label = if @display_annotation_system.present?
    label = annotation_system_labels[@display_annotation_system]
    material = @annotation_system_materials[@display_annotation_system]
    material && material["ai_assisted"] == true ? "#{label} — AI-assisted" : label
  elsif @display_translation.present?
    translation_label = translation_label_for.call(@display_translation)
    ai_label = @display_translation["ai_assisted"] == true ? " — AI-assisted" : ""
    "Translation: #{translation_label}#{ai_label}"
  else
    "Source"
  end
  active_view_ai_assisted = if @display_translation.present?
    @display_translation["ai_assisted"] == true
  elsif @display_annotation_system.present?
    @annotation_system_materials.dig(@display_annotation_system, "ai_assisted") == true
  else
    false
  end
%>

  <div class="corpus-filebar">
    <div class="corpus-headmeta">
      <% if meta_work.present? %>
        <span class="corpus-headmeta-item"><strong>Work:</strong> <%= meta_work %></span>
      <% end %>
      <% if meta_author.present? %>
        <span class="corpus-headmeta-item"><strong>Author:</strong> <%= meta_author %></span>
      <% end %>
      <span class="corpus-headmeta-item"><strong>Viewing:</strong> <%= active_view_label %></span>
    </div>
  </div>


  <div class="corpus-reader <%= 'is-translation-view' if @display_translation.present? %>"
       data-controller="corpus-reader corpus-annotations companion-materials companion-material-ticket"
       data-companion-materials-source-url-value="<%= corpus_viewer_path(@source_rel_path.split("/"), format: nil) %>"
       data-companion-materials-active-ai-value="<%= active_view_ai_assisted %>"
       data-companion-material-ticket-source-value="corpus_viewer"
       data-companion-material-ticket-base-path-value="<%= @source_rel_path %>"
       data-corpus-reader-translation-mode-value="<%= @display_translation.present? %>"
       data-corpus-reader-translation-id-value="<%= @display_translation&.dig('id').to_s %>"
       data-corpus-annotations-translation-mode-value="<%= @display_translation.present? %>"
       data-corpus-annotations-path-value="<%= @active_text_target_path %>"
       data-corpus-annotations-source-path-value="<%= @source_rel_path %>"
       data-corpus-annotations-url-value="/corpus_annotations">
    <div class="corpus-toolbar" role="toolbar" aria-label="Corpus viewer tools">
      <button type="button"
              class="corpus-btn"
              data-action="corpus-reader#toggleVertical"
              data-corpus-reader-target="verticalBtn"
              aria-pressed="false">
        <%= @display_translation.present? ? "Orientation: Horizontal" : "Vertical" %>
      </button>

      <% unless @display_translation.present? %>
        <button type="button"
                class="corpus-btn"
                data-action="corpus-reader#cycleTheme"
                data-corpus-reader-target="themeBtn"
                aria-pressed="false">
          Theme
        </button>
        <button type="button"
                class="corpus-btn"
                data-action="corpus-reader#cyclePunctPreset"
                data-corpus-reader-target="punctPresetBtn"
                aria-pressed="false">
          Punct: Source
        </button>

        <button type="button"
                class="corpus-btn corpus-btn-split"
                title="Punctuation options"
                aria-label="Punctuation options"
                data-action="corpus-reader#togglePunctMenu"
                data-corpus-reader-target="punctMenuBtn">
          ▸
        </button>

        <button type="button"
                class="corpus-btn"
                data-action="corpus-reader#toggleJudou"
                data-corpus-reader-target="judouBtn"
                aria-pressed="true">
          Judou: On
        </button>
      <% end %>

      <button type="button"
              class="corpus-btn"
              data-action="corpus-annotations#toggleNotes"
              data-corpus-annotations-target="notesBtn"
              aria-pressed="false">
        <%= @display_translation.present? ? "Footnotes: Off" : "Notes: Off" %>
      </button>

      <% unless @display_translation.present? %>
        <button type="button"
                class="corpus-btn"
                data-action="corpus-annotations#openColorSettings"
                title="Colour settings"
                aria-label="Colour settings">
          Colour settings
        </button>
      <% end %>

      <div class="corpus-toolbar-spacer" aria-hidden="true"></div>

        <% if @available_translations.present? || @companion_submission_enabled %>
          <div class="corpus-toolbar-control-group <%= 'corpus-toolbar-control-group--single' unless @companion_submission_enabled %>"
               data-controller="toolbar-menu">
            <button type="button"
                    class="corpus-btn corpus-toolbar-control-group__trigger"
                    data-action="toolbar-menu#toggle"
                    data-toolbar-menu-target="button"
                    aria-expanded="false"
                    aria-haspopup="menu"
                    <%= "disabled" if @available_translations.blank? %>>
              <span>Translations (<%= @available_translations.length %>)</span>
              <% if @available_translations.present? %>
                <span class="corpus-toolbar-control-group__chevron" aria-hidden="true">▾</span>
              <% end %>
            </button>

            <% if @companion_submission_enabled %>
              <button type="button"
                      class="corpus-btn corpus-toolbar-control-group__add"
                      title="Add translation"
                      aria-label="Add translation"
                      data-action="companion-material-ticket#openForType"
                      data-companion-material-ticket-material-type-param="translation">+</button>
            <% end %>

            <% if @available_translations.present? %>
              <div class="cv-toolbar-menu"
                   data-toolbar-menu-target="menu"
                   role="menu"
                   hidden>
                <%= link_to "Source text",
                            corpus_viewer_path(@source_rel_path.split("/"), format: nil),
                            class: "corpus-btn #{@display_translation.blank? && @display_annotation_system.blank? ? 'is-active' : ''}",
                            role: "menuitem" %>
                <% @available_translations.each_value do |translation| %>
                  <% label = translation_label_for.call(translation) %>
                  <% label = "#{label} · AI-assisted" if translation["ai_assisted"] == true %>
                  <%= link_to label,
                              corpus_viewer_path(@source_rel_path.split("/"), format: nil, translation: translation["id"]),
                              class: "corpus-btn #{@display_translation && @display_translation['id'] == translation['id'] ? 'is-active' : ''}",
                              role: "menuitem",
                              data: {
                                companion_materials_target: "material",
                                ai_assisted: translation["ai_assisted"] == true,
                                active: @display_translation && @display_translation["id"] == translation["id"]
                              } %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if @variant_materials.present? %>
          <div class="corpus-toolbar-control-group corpus-toolbar-control-group--single"
               data-controller="toolbar-menu">
            <button type="button"
                    class="corpus-btn corpus-toolbar-control-group__trigger"
                    data-action="toolbar-menu#toggle"
                    data-toolbar-menu-target="button"
                    aria-expanded="false"
                    aria-haspopup="menu">
              <span>Variants (<%= @variant_materials.length %>)</span>
              <span class="corpus-toolbar-control-group__chevron" aria-hidden="true">▾</span>
            </button>

            <div class="cv-toolbar-menu"
                 data-toolbar-menu-target="menu"
                 role="menu"
                 hidden>
              <% @variant_materials.each do |variant| %>
                <% label = variant["title"].presence || (variant["related_path"].present? ? File.basename(variant["related_path"]) : "External variant") %>
                <% if variant["related_path"].present? %>
                  <%= link_to label,
                              corpus_viewer_path(variant["related_path"].split("/"), format: nil),
                              class: "corpus-btn",
                              role: "menuitem" %>
                <% elsif Array(variant["links"]).first.present? %>
                  <%= link_to label,
                              Array(variant["links"]).first,
                              class: "corpus-btn",
                              role: "menuitem",
                              target: "_blank",
                              rel: "noopener noreferrer" %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @annotation_system_editor_enabled || @available_annotation_systems.present? %>
          <span class="corpus-toolbar-traditions"
                data-controller="kanbun-ticket"
                data-kanbun-ticket-source-value="corpus_viewer"
                data-kanbun-ticket-target-path-value="<%= @source_rel_path %>">
            <span class="corpus-toolbar-control-group <%= 'corpus-toolbar-control-group--single' unless @annotation_system_editor_enabled %>"
                  data-controller="toolbar-menu">
              <button type="button"
                      class="corpus-btn corpus-toolbar-control-group__trigger"
                      data-action="toolbar-menu#toggle"
                      data-toolbar-menu-target="button"
                      aria-expanded="false"
                      aria-haspopup="menu"
                      <%= "disabled" if @available_annotation_systems.blank? %>>
                <span>Annotation systems (<%= @available_annotation_systems.length %>)</span>
                <% if @available_annotation_systems.present? %>
                  <span class="corpus-toolbar-control-group__chevron" aria-hidden="true">▾</span>
                <% end %>
              </button>

              <% if @annotation_system_editor_enabled %>
                <button type="button"
                        class="corpus-btn corpus-toolbar-control-group__add"
                        title="Create annotation system"
                        aria-label="Create annotation system"
                        data-action="kanbun-ticket#toggle">+</button>
              <% end %>

              <% if @available_annotation_systems.present? %>
                <div class="cv-toolbar-menu"
                     data-toolbar-menu-target="menu"
                     role="menu"
                     hidden>
                  <%= link_to "Source text",
                              corpus_viewer_path(@source_rel_path.split("/"), format: nil),
                              class: "corpus-btn #{@display_translation.blank? && @display_annotation_system.blank? ? 'is-active' : ''}",
                              role: "menuitem" %>
                  <% annotation_system_labels.each do |annotation_system, label| %>
                    <% next unless @available_annotation_systems[annotation_system].present? %>
                    <% material = @annotation_system_materials[annotation_system] %>
                    <% display_label = material && material["ai_assisted"] == true ? "#{label} · AI-assisted" : label %>
                    <%= link_to display_label,
                                corpus_viewer_path(@source_rel_path.split("/"), format: nil, annotation_system: annotation_system),
                                class: "corpus-btn #{@display_annotation_system == annotation_system ? 'is-active' : ''}",
                                role: "menuitem",
                                data: {
                                  companion_materials_target: material.present? ? "material" : nil,
                                  ai_assisted: material && material["ai_assisted"] == true,
                                  active: @display_annotation_system == annotation_system
                                } %>
                  <% end %>
                </div>
              <% end %>
            </span>

            <% if @annotation_system_editor_enabled %>
              <div class="cv-text-edit-panel cv-kanbun-panel hidden" data-kanbun-ticket-target="panel">
              <h3 style="margin-top: 0;">Create annotation system (creates a ticket)</h3>
              <p class="cv-hint">Manual annotation is the default. Approved files are written as sibling pages under <code>kanbun/</code>, <code>hanmun/</code>, or <code>hanvan/</code> with the same filename as this source page.</p>

              <form data-action="submit->kanbun-ticket#submit">
                <div class="cv-form-row">
                  <label>Annotation system</label>
                  <select class="cv-input" data-kanbun-ticket-target="annotationSystem" data-action="change->kanbun-ticket#annotationSystemChanged">
                    <option value="kanbun">Kanbun (Japanese reading/annotation system)</option>
                    <option value="hanmun">Hanmun (Korean reading/annotation system)</option>
                    <option value="hanvan">Hanvan (Vietnamese reading/annotation system)</option>
                  </select>
                </div>

                <div class="cv-form-row">
                  <label>Summary</label>
                  <input type="text" class="cv-input" placeholder="What was added or corrected?" data-kanbun-ticket-target="summary" />
                </div>

                <div class="cv-form-row">
                  <label>Reasoning</label>
                  <textarea class="cv-textarea" rows="3" placeholder="Explain any editorial choices a reviewer should know." data-kanbun-ticket-target="reasoning"></textarea>
                </div>

                <div class="cv-form-row">
                  <label>Digital keyboard</label>
                  <div class="cv-kanbun-keyboard">
                    <% ["㆐", "㆑", "㆒", "㆓", "㆔", "㆕", "㆖", "㆗", "㆘", "㆙", "㆚", "㆛", "㆜", "㆝", "㆞", "㆟"].each do |symbol| %>
                      <button type="button" class="corpus-btn cv-kanbun-key" data-symbol="<%= symbol %>" data-action="kanbun-ticket#insertSymbol"><%= symbol %></button>
                    <% end %>
                  </div>
                </div>

                <p class="cv-hint" data-kanbun-ticket-target="aiNotice" hidden>Kanbun-LM is not shown here because automatic generation is Japanese-only. This patch keeps the manual path as the default workflow.</p>

                <div class="cv-kanbun-side-by-side">
                  <div class="cv-kanbun-pane">
                    <label>Source page</label>
                    <textarea class="cv-textarea cv-mono" rows="24" readonly><%= @source_body %></textarea>
                  </div>
                  <div class="cv-kanbun-pane">
                    <label>Annotation-system text</label>
                    <textarea class="cv-textarea cv-mono" rows="24" data-kanbun-ticket-target="annotationText"><%= @source_body %></textarea>
                  </div>
                </div>

                <textarea class="hidden" data-kanbun-ticket-target="sourceSeed"><%= @source_body %></textarea>
                <textarea class="hidden" data-kanbun-ticket-target="kanbunSeed"><%= @annotation_system_bodies['kanbun'].to_s %></textarea>
                <textarea class="hidden" data-kanbun-ticket-target="hanmunSeed"><%= @annotation_system_bodies['hanmun'].to_s %></textarea>
                <textarea class="hidden" data-kanbun-ticket-target="hanvanSeed"><%= @annotation_system_bodies['hanvan'].to_s %></textarea>

                <%= render "corpus_viewer/material_metadata_fields",
                           stimulus_controller: "kanbun-ticket" %>

                <%= render "corpus_viewer/ticket_optional_fields",
                           stimulus_controller: "kanbun-ticket",
                           include_uploads: true %>

                <div class="cv-form-actions">
                  <button type="submit" class="corpus-btn corpus-btn-primary">Submit ticket</button>
                  <button type="button" class="corpus-btn" data-action="kanbun-ticket#toggle">Close</button>
                </div>
              </form>

              <div class="cv-ticket-result">
                <div class="cv-ticket-status" data-kanbun-ticket-target="status"></div>
                <div class="cv-ticket-kv">
                  <div><strong>Ticket ID:</strong> <span data-kanbun-ticket-target="ticketId"></span></div>
                  <div>
                    <strong>Ticket key (save this):</strong>
                    <code data-kanbun-ticket-target="ticketKey"></code>
                    <button type="button" class="corpus-btn" data-kanbun-ticket-target="copyKeyBtn" data-action="kanbun-ticket#copyKey">Copy</button>
                    <button type="button" class="corpus-btn" data-kanbun-ticket-target="downloadKeyBtn" data-action="kanbun-ticket#downloadKey" hidden>Download .txt</button>
                    <a href="#" class="corpus-btn" data-kanbun-ticket-target="openTicketLink" hidden>Open ticket</a>
                  </div>
                </div>
              </div>
            </div>
            <% end %>
          </span>
        <% end %>

        <% if @companion_submission_enabled %>
          <div class="corpus-toolbar-control-group corpus-toolbar-control-group--single"
               data-controller="toolbar-menu">
            <button type="button"
                    class="corpus-btn corpus-toolbar-control-group__trigger"
                    data-action="toolbar-menu#toggle"
                    data-toolbar-menu-target="button"
                    aria-expanded="false"
                    aria-haspopup="menu">
              <span>Other materials</span>
              <span class="corpus-toolbar-control-group__chevron" aria-hidden="true">▾</span>
            </button>

            <div class="cv-toolbar-menu"
                 data-toolbar-menu-target="menu"
                 role="menu"
                 hidden>
              <button type="button"
                      class="corpus-btn"
                      role="menuitem"
                      data-action="toolbar-menu#close companion-material-ticket#openForType"
                      data-companion-material-ticket-material-type-param="gallery_image">Add gallery images</button>
              <button type="button"
                      class="corpus-btn"
                      role="menuitem"
                      data-action="toolbar-menu#close companion-material-ticket#openForType"
                      data-companion-material-ticket-material-type-param="exemplar_manuscript">Add exemplar manuscript</button>
              <button type="button"
                      class="corpus-btn"
                      role="menuitem"
                      data-action="toolbar-menu#close companion-material-ticket#openForType"
                      data-companion-material-ticket-material-type-param="variant_text">Add variant connection</button>
            </div>
          </div>
        <% end %>

        <%= render "corpus_viewer/companion_submission" %>

      <% unless @display_translation.present? %>
      <div class="corpus-toolbar-editing">
        <button type="button"
                class="corpus-btn corpus-btn-editing"
                data-action="corpus-annotations#toggleAnnotate"
                data-corpus-annotations-target="annotateBtn"
                aria-pressed="false">
          Annotate: Off
        </button>

        <button type="button"
                class="corpus-btn corpus-btn-primary corpus-btn-review-submit"
                data-action="corpus-annotations#saveDraft"
                data-corpus-annotations-target="saveBtn"
                hidden>
          Review &amp; submit
        </button>

        <span
          data-controller="text-edit-ticket"
          data-text-edit-ticket-source-value="corpus_viewer"
          data-text-edit-ticket-target-path-value="<%= @active_text_target_path %>">
          <button type="button"
                  class="corpus-btn corpus-btn-editing"
                  data-action="text-edit-ticket#toggle"
                  title="Propose a text change (creates a ticket)">
            Text edit
          </button>

          <div class="cv-text-edit-panel hidden" data-text-edit-ticket-target="panel">
            <h3 style="margin-top: 0;">Propose a text edit (creates a ticket)</h3>
            <p class="cv-hint">This does <em>not</em> change the corpus directly. It creates a ticket with a unified diff attached.</p>

            <form data-action="submit->text-edit-ticket#submit">
              <div class="cv-form-row">
                <label>Title</label>
                <input type="text" class="cv-input" value="Text edit" data-text-edit-ticket-target="title" />
              </div>
              <div class="cv-form-row">
                <label>Summary</label>
                <input type="text" class="cv-input" placeholder="What changed?" data-text-edit-ticket-target="summary" />
              </div>
              <div class="cv-form-row">
                <label>Reasoning</label>
                <textarea class="cv-textarea" rows="3" placeholder="Why should this change be made?" data-text-edit-ticket-target="reasoning"></textarea>
              </div>

              <div class="cv-form-row">
                <label>Edited text</label>
                <textarea class="cv-textarea cv-mono" rows="18" data-text-edit-ticket-target="edited"></textarea>
              </div>

              <textarea class="hidden" data-text-edit-ticket-target="original"><%= @raw_body %></textarea>

              <%= render "corpus_viewer/ticket_optional_fields",
                         stimulus_controller: "text-edit-ticket",
                         include_uploads: true %>

              <div class="cv-form-actions">
                <button type="submit" class="corpus-btn corpus-btn-primary">Submit ticket</button>
                <button type="button" class="corpus-btn" data-action="text-edit-ticket#toggle">Close</button>
              </div>
            </form>

            <div class="cv-ticket-result">
              <div class="cv-ticket-status" data-text-edit-ticket-target="status"></div>
              <div class="cv-ticket-kv">
                <div><strong>Ticket ID:</strong> <span data-text-edit-ticket-target="ticketId"></span></div>
                <div>
                  <strong>Ticket key (save this):</strong>
                  <code data-text-edit-ticket-target="ticketKey"></code>
                  <button type="button" class="corpus-btn" data-text-edit-ticket-target="copyKeyBtn" data-action="text-edit-ticket#copyKey">Copy</button>
                  <button type="button" class="corpus-btn" data-text-edit-ticket-target="downloadKeyBtn" data-action="text-edit-ticket#downloadKey" hidden>Download .txt</button>
                </div>
              </div>
            </div>
          </div>
        </span>
      </div>
      <% end %>
    </div>

    <%# Metadata is parsed from leading "#" lines in the corpus file and is display-only. %>
    <% if (defined?(@meta) && @meta.present?) %>
      <details class="corpus-metabox"
               style="margin: 0 0 10px; border: 1px solid rgba(0,0,0,0.10); border-radius: 12px; padding: 10px; background: #fff;">
        <summary class="corpus-metabox-summary">
          <strong>Metadata</strong>
          <% if meta_page_title.present? && meta_ws_cats.present? %>
            <span style="margin-left: 10px;">
              <%= link_to "维基文库", "https://zh.wikisource.org/wiki/#{ERB::Util.url_encode(meta_page_title)}",
                          target: "_blank", rel: "noopener",
                          class: "corpus-btn corpus-btn-ghost",
                          style: "text-decoration: none;" %>
            </span>
          <% end %>
        </summary>
        <div class="corpus-metabox-scroll" role="region" aria-label="Text metadata"
             style="max-height: 160px; overflow: auto; padding-top: 8px;">
          <dl class="corpus-metabox-dl" style="margin: 0;">
            <% @meta.each do |(k, v)| %>
              <div class="corpus-metabox-row" style="display: grid; grid-template-columns: 180px 1fr; gap: 10px; padding: 4px 0;">
                <dt class="corpus-metabox-key" style="margin: 0; font-weight: 600;">
                  <%= k %>
                </dt>
                <dd class="corpus-metabox-val" style="margin: 0; opacity: 0.9;">
                  <%= v.present? ? v : "" %>
                </dd>
              </div>
            <% end %>
          </dl>
        </div>
      </details>
    <% end %>

    <div class="corpus-punct-overlay"
         data-corpus-reader-target="punctOverlay"
         data-action="click->corpus-reader#onPunctOverlayClick"
         hidden>
      <div class="corpus-punct-panel"
           data-corpus-reader-target="punctPanel"
           role="dialog"
           aria-label="Punctuation options">
        <div class="corpus-punct-header">
          <div class="corpus-punct-title">Punctuation options</div>
          <div class="corpus-punct-actions">
            <button type="button" class="corpus-btn corpus-btn-ghost" data-action="click->corpus-reader#okPunctMenu" data-corpus-reader-target="punctOkBtn">OK</button>
            <button type="button" class="corpus-btn corpus-btn-ghost" data-action="click->corpus-reader#closePunctMenu" data-corpus-reader-target="punctCloseBtn">✕</button>
          </div>
        </div>

        <div class="corpus-punct-grid">
          <fieldset class="corpus-fieldset preset-box">
            <legend>Preset</legend>
            <label><input type="radio" name="cv_preset" value="source" data-action="change->corpus-reader#setPunctPresetRadio"> Source</label>
            <label><input type="radio" name="cv_preset" value="modern_trad" data-action="change->corpus-reader#setPunctPresetRadio"> Modern CJK (Traditional)</label>
            <label><input type="radio" name="cv_preset" value="modern_prc" data-action="change->corpus-reader#setPunctPresetRadio"> Modern CJK (Simplified / PRC)</label>
            <label><input type="radio" name="cv_preset" value="pure" data-action="change->corpus-reader#setPunctPresetRadio"> Pure classical</label>
            <label><input type="radio" name="cv_preset" value="strip" data-action="change->corpus-reader#setPunctPresetRadio"> Strip</label>
            <label><input type="radio" name="cv_preset" value="custom" data-action="change->corpus-reader#setPunctPresetRadio"> Custom</label>
          </fieldset>

          <fieldset class="corpus-fieldset">
            <legend>Quotes</legend>
            <div class="corpus-subtitle">Family</div>
            <label><input type="radio" name="cv_quote_family" value="corner" data-action="change->corpus-reader#setPunctOptionRadio"> Chinese quotation marks 「」『』</label>
            <label><input type="radio" name="cv_quote_family" value="speech_curly" data-action="change->corpus-reader#setPunctOptionRadio"> Latin speech marks “ ” ‘ ’</label>
            <label><input type="radio" name="cv_quote_family" value="speech_fullwidth" data-action="change->corpus-reader#setPunctOptionRadio"> Chinese speech marks ＂ ＇</label>
            <label><input type="radio" name="cv_quote_family" value="off" data-action="change->corpus-reader#setPunctOptionRadio"> Off</label>

            <div class="corpus-subtitle">Ordering</div>
            <label><input type="radio" name="cv_quote_order" value="trad" data-action="change->corpus-reader#setPunctOptionRadio"> Traditional: 「甲『乙』丙」</label>
            <label><input type="radio" name="cv_quote_order" value="simp" data-action="change->corpus-reader#setPunctOptionRadio"> Simplified: 『甲「乙」丙』</label>

            <label class="corpus-check"><input type="checkbox" data-corpus-reader-target="verticalQuoteFormsChk" data-action="change->corpus-reader#toggleVerticalQuoteForms"> Vertical quote forms (﹁﹂﹃﹄)</label>
          </fieldset>

          <fieldset class="corpus-fieldset">
            <legend>Question / Exclamation</legend>
            <label><input type="radio" name="cv_q" value="keep" data-action="change->corpus-reader#setPunctOptionRadio"> Keep ？</label>
            <label><input type="radio" name="cv_q" value="collapse" data-action="change->corpus-reader#setPunctOptionRadio"> Collapse ? → 。</label>
            <div style="height:6px"></div>
            <label><input type="radio" name="cv_ex" value="keep" data-action="change->corpus-reader#setPunctOptionRadio"> Keep ！</label>
            <label><input type="radio" name="cv_ex" value="collapse" data-action="change->corpus-reader#setPunctOptionRadio"> Collapse ! → 。</label>
          </fieldset>

          <fieldset class="corpus-fieldset">
            <legend>Semicolon / Colon</legend>
            <label><input type="radio" name="cv_semi" value="keep" data-action="change->corpus-reader#setPunctOptionRadio"> Keep ；</label>
            <label><input type="radio" name="cv_semi" value="collapse" data-action="change->corpus-reader#setPunctOptionRadio"> Collapse ; → 。</label>
            <div style="height:6px"></div>
            <label><input type="radio" name="cv_colon" value="keep" data-action="change->corpus-reader#setPunctOptionRadio"> Keep ：</label>
            <label><input type="radio" name="cv_colon" value="collapse" data-action="change->corpus-reader#setPunctOptionRadio"> Collapse : → 。</label>
          </fieldset>

          <fieldset class="corpus-fieldset">
            <legend>Comma</legend>
            <label><input type="radio" name="cv_comma" value="keep" data-action="change->corpus-reader#setPunctOptionRadio"> Use ，</label>
            <label><input type="radio" name="cv_comma" value="dunhao" data-action="change->corpus-reader#setPunctOptionRadio"> Use 、</label>
          </fieldset>

          <fieldset class="corpus-fieldset">
            <legend>Repetition mark</legend>
            <label><input type="radio" name="cv_repeat_mark" value="none" data-action="change->corpus-reader#setRepeatMarkRadio"> No repetition mark (default)</label>
            <label><input type="radio" name="cv_repeat_mark" value="kanji" data-action="change->corpus-reader#setRepeatMarkRadio"> 々 (Horizontal)</label>
            <label><input type="radio" name="cv_repeat_mark" value="vertical" data-action="change->corpus-reader#setRepeatMarkRadio"> 〻 (Vertical)</label>
            <label><input type="radio" name="cv_repeat_mark" value="zhou" data-action="change->corpus-reader#setRepeatMarkRadio"> 二 (Western Zhou-style)</label>
          </fieldset>
        </div>
      </div>
    </div>

    <div class="corpus-viewbox" data-corpus-reader-target="viewbox">
      <div class="corpus-textflow"
           data-corpus-reader-target="content"
           data-action="contextmenu->corpus-reader#onContextMenu">
        <%# Ruby markup must be generated server-side so it can use session preferences.
            The helper returns an html_safe buffer, so do NOT escape it. %>
        <%= corpus_text_with_optional_ruby(@text, allow_ruby: @display_translation.blank?) %>
      </div>
    </div>

    <%= render "corpus_viewer/companion_materials" %>
  </div>

<% else %>
  <p>Minecraft How did we get here advancement</p>
<% end %>
