<h1><%= t("corpus_viewer.title") %></h1>

<p class="crumbs">
  <% if @rel_path.present? %>
    <% parts = @rel_path.to_s.split("/") %>
    <%= link_to t("corpus_viewer.root"), corpus_viewer_path %>
    <% acc = [] %>
    <% parts.each do |part| %>
      <% acc << part %>
      <span class="crumb-sep">/</span>
      <%= link_to part, corpus_viewer_path(acc, format: nil) %>
    <% end %>
  <% end %>
</p>

<% if @kind == :dir %>
  <p><strong><%= @rel_path.present? ? @rel_path : t("corpus_viewer.root") %></strong></p>

  <% if @rel_path.to_s.split("/").include?("clean") %>
    <div class="corpus-dir-actions"
         data-controller="corpus-submission-ticket"
         data-corpus-submission-ticket-source-value="corpus_viewer"
         data-corpus-submission-ticket-parent-path-value="<%= @rel_path %>"
         data-corpus-submission-ticket-lock-parent-path-value="true">
      <button type="button"
              class="corpus-btn corpus-btn-editing"
              data-action="corpus-submission-ticket#toggle"
              title="<%= t("corpus_viewer.directory_submission.button_title") %>">
        <%= t("corpus_viewer.directory_submission.button") %>
      </button>

      <div class="cv-text-edit-panel cv-submission-panel hidden" data-corpus-submission-ticket-target="panel">
        <h3 style="margin-top: 0;"><%= t("corpus_viewer.directory_submission.heading") %></h3>
        <p class="cv-hint"><%= t("corpus_viewer.directory_submission.explanation_html") %></p>

        <form data-action="submit->corpus-submission-ticket#submit">
          <div class="cv-form-row">
            <label><%= t("corpus_viewer.directory_submission.parent_directory") %></label>
            <input type="text" class="cv-input cv-mono" data-corpus-submission-ticket-target="parentPath" />
          </div>
          <div class="cv-form-row">
            <label><%= t("corpus_viewer.directory_submission.work_folder") %></label>
            <input type="text" class="cv-input" placeholder="<%= t("corpus_viewer.directory_submission.work_folder_placeholder") %>" data-corpus-submission-ticket-target="workFolder" />
          </div>
          <div class="cv-form-row">
            <label><%= t("corpus_viewer.directory_submission.ticket_title") %></label>
            <input type="text" class="cv-input" value="<%= t("corpus_viewer.directory_submission.default_ticket_title") %>" data-corpus-submission-ticket-target="title" />
          </div>
          <div class="cv-form-row">
            <label><%= t("corpus_viewer.directory_submission.short_summary") %></label>
            <input type="text" class="cv-input" placeholder="<%= t("corpus_viewer.directory_submission.short_summary_placeholder") %>" data-corpus-submission-ticket-target="summary" />
          </div>
          <div class="cv-form-row">
            <label><%= t("corpus_viewer.directory_submission.content_role") %></label>
            <select class="cv-input" data-corpus-submission-ticket-target="textType">
              <option value="source"><%= t("corpus_viewer.directory_submission.roles.source") %></option>
              <option value="kanbun"><%= t("corpus_viewer.directory_submission.roles.kanbun") %></option>
              <option value="hanmun"><%= t("corpus_viewer.directory_submission.roles.hanmun") %></option>
              <option value="hanvan"><%= t("corpus_viewer.directory_submission.roles.hanvan") %></option>
            </select>
          </div>

          <div class="cv-form-row">
            <label><%= t("corpus_viewer.directory_submission.metadata_fields.nation") %></label>
            <input type="text" class="cv-input" data-corpus-submission-ticket-target="nation" />
          </div>
          <div class="cv-form-row">
            <label><%= t("corpus_viewer.directory_submission.metadata_fields.work_title") %></label>
            <input type="text" class="cv-input" data-corpus-submission-ticket-target="workTitle" />
          </div>
          <div class="cv-form-row">
            <label><%= t("corpus_viewer.directory_submission.metadata_fields.author") %></label>
            <input type="text" class="cv-input" data-corpus-submission-ticket-target="author" />
          </div>
          <div class="cv-form-row">
            <label>Date / year label</label>
            <input type="text" class="cv-input" data-corpus-submission-ticket-target="dateLabel" />
          </div>
          <div class="cv-form-row">
            <label>Period</label>
            <input type="text" class="cv-input" data-corpus-submission-ticket-target="period" />
          </div>
          <div class="cv-form-row">
            <label>Polity</label>
            <input type="text" class="cv-input" data-corpus-submission-ticket-target="polity" />
          </div>
          <div class="cv-form-row">
            <label>Region</label>
            <input type="text" class="cv-input" data-corpus-submission-ticket-target="region" />
          </div>
          <div class="cv-form-row">
            <label>Categories</label>
            <textarea class="cv-textarea" rows="3" placeholder="One category per line, or separate with semicolons" data-corpus-submission-ticket-target="categories"></textarea>
          </div>
          <div class="cv-form-row">
            <label><%= t("corpus_viewer.directory_submission.metadata_fields.source") %></label>
            <input type="text" class="cv-input" placeholder="<%= t("corpus_viewer.directory_submission.source_placeholder") %>" data-corpus-submission-ticket-target="sourceCitation" />
          </div>
          <div class="cv-form-row">
            <label><%= t("corpus_viewer.directory_submission.metadata_fields.url") %></label>
            <input type="url" class="cv-input" placeholder="<%= t("corpus_viewer.directory_submission.url_placeholder") %>" data-corpus-submission-ticket-target="url" />
          </div>
          <div class="cv-form-row">
            <label><%= t("corpus_viewer.directory_submission.context_and_rights") %></label>
            <textarea class="cv-textarea" rows="4" placeholder="<%= t("corpus_viewer.directory_submission.context_placeholder") %>" data-corpus-submission-ticket-target="contextDetails"></textarea>
          </div>
          <div class="cv-form-row">
            <label><%= t("corpus_viewer.directory_submission.reference_files") %></label>
            <input type="file" class="cv-input" multiple data-corpus-submission-ticket-target="uploads" />
            <div class="cv-hint"><%= t("corpus_viewer.directory_submission.reference_files_hint") %></div>
          </div>
          <div class="cv-form-row">
            <label><%= t("corpus_viewer.directory_submission.page_setup") %></label>
            <select class="cv-input" data-corpus-submission-ticket-target="pageMode" data-action="change->corpus-submission-ticket#togglePageMode">
              <option value="single"><%= t("corpus_viewer.directory_submission.single_file") %></option>
              <option value="multi"><%= t("corpus_viewer.directory_submission.multiple_files") %></option>
            </select>
          </div>

          <div data-corpus-submission-ticket-target="singleFields">
            <div class="cv-form-row">
              <label><%= t("corpus_viewer.directory_submission.file_name") %></label>
              <input type="text" class="cv-input" placeholder="<%= t("corpus_viewer.directory_submission.file_name_placeholder") %>" data-corpus-submission-ticket-target="fileName" />
            </div>
            <div class="cv-form-row">
              <label><%= t("corpus_viewer.directory_submission.metadata_fields.page_title") %></label>
              <input type="text" class="cv-input" data-corpus-submission-ticket-target="pageTitle" />
            </div>
            <div class="cv-form-row">
              <label><%= t("corpus_viewer.directory_submission.text_body") %></label>
              <textarea class="cv-textarea cv-mono" rows="16" data-corpus-submission-ticket-target="body"></textarea>
            </div>
          </div>

          <div data-corpus-submission-ticket-target="multiFields" hidden>
            <div class="cv-form-row">
              <label><%= t("corpus_viewer.directory_submission.pages") %></label>
              <div data-corpus-submission-ticket-target="pagesList"></div>
            </div>
            <div class="cv-form-actions">
              <button type="button" class="corpus-btn" data-action="corpus-submission-ticket#addPage"><%= t("common.actions.add_page") %></button>
            </div>
            <p class="cv-hint"><%= t("corpus_viewer.directory_submission.pages_hint_html") %></p>
          </div>

          <%= render "corpus_viewer/ticket_optional_fields",
                     stimulus_controller: "corpus-submission-ticket",
                     include_uploads: false %>

          <div class="cv-form-actions">
            <button type="submit" class="corpus-btn corpus-btn-primary"><%= t("common.actions.submit_ticket") %></button>
            <button type="button" class="corpus-btn" data-action="corpus-submission-ticket#toggle"><%= t("common.actions.close") %></button>
          </div>
        </form>

        <div class="cv-ticket-result">
          <div class="cv-ticket-status" data-corpus-submission-ticket-target="status"></div>
          <div class="cv-ticket-kv">
            <div><strong><%= t("common.tickets.ticket_id") %></strong> <span data-corpus-submission-ticket-target="ticketId"></span></div>
            <div>
              <strong><%= t("common.tickets.ticket_key") %></strong>
              <code data-corpus-submission-ticket-target="ticketKey"></code>
              <button type="button" class="corpus-btn" data-corpus-submission-ticket-target="copyKeyBtn" data-action="corpus-submission-ticket#copyKey"><%= t("common.actions.copy") %></button>
              <button type="button" class="corpus-btn" data-corpus-submission-ticket-target="downloadKeyBtn" data-action="corpus-submission-ticket#downloadKey" hidden><%= t("common.actions.download_txt") %></button>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <% root_activity_available = @rel_path.blank? && @corpus_activity&.available? %>

  <% if root_activity_available %>
    <div class="corpus-root-layout">
      <details class="corpus-root-activity"
               data-controller="corpus-root-activity">
        <summary class="corpus-root-activity-summary"><%= t("corpus_viewer.recent_activity.summary") %></summary>
        <%= render "home/corpus_activity",
                   activity_id_prefix: "corpus-root",
                   activity_variant: "browser" %>
      </details>

      <div class="corpus-root-folder-list">
  <% end %>

  <ul class="corpus-list">
    <% @children.each do |name| %>
      <% child_rel = @rel_path.present? ? "#{@rel_path}/#{name}" : name %>
      <li>
        <%= link_to name, corpus_viewer_path(child_rel.split("/"), format: nil) %>
      </li>
    <% end %>
  </ul>

  <% if root_activity_available %>
      </div>
    </div>
  <% end %>

<% elsif @kind == :file %>
  <%= render "rightbar" %>

<%
  meta_hash = (defined?(@meta) && @meta.respond_to?(:to_h)) ? @meta.to_h : {}

  meta_work       = meta_hash["Work"].to_s.strip
  meta_author     = meta_hash["Author"].to_s.strip
  meta_ws_cats    = meta_hash["Ws Categories"].to_s.strip
  meta_page_title = meta_hash["Page title"].to_s.strip # to derive wikisource links

  derived_work = begin
    File.basename(File.dirname(@source_rel_path.to_s))
  rescue
    ""
  end
  meta_work = derived_work if meta_work.blank? && derived_work.present?

  annotation_system_labels = {
    "kanbun" => t("corpus_viewer.annotation_systems.names.kanbun"),
    "hanmun" => t("corpus_viewer.annotation_systems.names.hanmun"),
    "hanvan" => t("corpus_viewer.annotation_systems.names.hanvan")
  }
  translation_label_for = lambda do |translation|
    language = translation["language_name"].presence || translation["language_code"].to_s.upcase
    translator = translation["translator_name"].presence
    translator = t("corpus_viewer.header.author_provided") if translator.blank? && Array(translation["provenance"]).include?("author_provided")
    [language, translator].compact.join(" — ")
  end
  active_view_label = if @display_annotation_system.present?
    label = annotation_system_labels[@display_annotation_system]
    material = @annotation_system_materials[@display_annotation_system]
    material && material["ai_assisted"] == true ? "#{label}#{t("corpus_viewer.header.ai_assisted_suffix")}" : label
  elsif @display_translation.present?
    translation_label = translation_label_for.call(@display_translation)
    ai_label = @display_translation["ai_assisted"] == true ? t("corpus_viewer.header.ai_assisted_suffix") : ""
    t("corpus_viewer.header.translation", label: "#{translation_label}#{ai_label}")
  else
    t("corpus_viewer.header.source")
  end
  active_view_ai_assisted = if @display_translation.present?
    @display_translation["ai_assisted"] == true
  elsif @display_annotation_system.present?
    @annotation_system_materials.dig(@display_annotation_system, "ai_assisted") == true
  else
    false
  end
%>

  <div class="corpus-filebar">
    <div class="corpus-headmeta">
      <% if meta_work.present? %>
        <span class="corpus-headmeta-item"><strong><%= t("corpus_viewer.header.work") %></strong> <%= meta_work %></span>
      <% end %>
      <% if meta_author.present? %>
        <span class="corpus-headmeta-item"><strong><%= t("corpus_viewer.header.author") %></strong> <%= meta_author %></span>
      <% end %>
      <span class="corpus-headmeta-item"><strong><%= t("corpus_viewer.header.viewing") %></strong> <%= active_view_label %></span>
    </div>
  </div>


  <div class="corpus-reader <%= 'is-translation-view' if @display_translation.present? %>"
       data-controller="corpus-reader corpus-annotations companion-materials companion-material-ticket"
       data-companion-materials-source-url-value="<%= corpus_viewer_path(@source_rel_path.split("/"), format: nil) %>"
       data-companion-materials-active-ai-value="<%= active_view_ai_assisted %>"
       data-companion-material-ticket-source-value="corpus_viewer"
       data-companion-material-ticket-base-path-value="<%= @source_rel_path %>"
       data-corpus-reader-translation-mode-value="<%= @display_translation.present? %>"
       data-corpus-reader-translation-id-value="<%= @display_translation&.dig('id').to_s %>"
       data-corpus-annotations-translation-mode-value="<%= @display_translation.present? %>"
       data-corpus-annotations-path-value="<%= @active_text_target_path %>"
       data-corpus-annotations-source-path-value="<%= @source_rel_path %>"
       data-corpus-annotations-url-value="/corpus_annotations">
    <div class="corpus-toolbar" role="toolbar" aria-label="<%= t("corpus_viewer.toolbar.aria_label") %>">
      <button type="button"
              class="corpus-btn"
              data-action="corpus-reader#toggleVertical"
              data-corpus-reader-target="verticalBtn"
              aria-pressed="false">
        <%= @display_translation.present? ? t("corpus_viewer.toolbar.orientation_horizontal") : t("corpus_viewer.toolbar.vertical") %>
      </button>

      <% unless @display_translation.present? %>
        <button type="button"
                class="corpus-btn"
                data-action="corpus-reader#cycleTheme"
                data-corpus-reader-target="themeBtn"
                aria-pressed="false">
          <%= t("corpus_viewer.toolbar.theme") %>
        </button>
        <button type="button"
                class="corpus-btn"
                data-action="corpus-reader#cyclePunctPreset"
                data-corpus-reader-target="punctPresetBtn"
                aria-pressed="false">
          <%= t("corpus_viewer.toolbar.punctuation_source") %>
        </button>

        <button type="button"
                class="corpus-btn corpus-btn-split"
                title="<%= t("corpus_viewer.toolbar.punctuation_options") %>"
                aria-label="<%= t("corpus_viewer.toolbar.punctuation_options") %>"
                data-action="corpus-reader#togglePunctMenu"
                data-corpus-reader-target="punctMenuBtn">
          ▸
        </button>

        <button type="button"
                class="corpus-btn"
                data-action="corpus-reader#toggleJudou"
                data-corpus-reader-target="judouBtn"
                aria-pressed="true">
          <%= t("corpus_viewer.toolbar.judou_on") %>
        </button>
      <% end %>

      <button type="button"
              class="corpus-btn"
              data-action="corpus-annotations#toggleNotes"
              data-corpus-annotations-target="notesBtn"
              aria-pressed="false">
        <%= @display_translation.present? ? t("corpus_viewer.toolbar.footnotes_off") : t("corpus_viewer.toolbar.notes_off") %>
      </button>

      <% unless @display_translation.present? %>
        <button type="button"
                class="corpus-btn"
                data-action="corpus-annotations#openColorSettings"
                title="<%= t("corpus_viewer.toolbar.colour_settings") %>"
                aria-label="<%= t("corpus_viewer.toolbar.colour_settings") %>">
          <%= t("corpus_viewer.toolbar.colour_settings") %>
        </button>
      <% end %>

      <div class="corpus-toolbar-spacer" aria-hidden="true"></div>

        <% if @available_translations.present? || @companion_submission_enabled %>
          <div class="corpus-toolbar-control-group <%= 'corpus-toolbar-control-group--single' unless @companion_submission_enabled %>"
               data-controller="toolbar-menu">
            <button type="button"
                    class="corpus-btn corpus-toolbar-control-group__trigger"
                    data-action="toolbar-menu#toggle"
                    data-toolbar-menu-target="button"
                    aria-expanded="false"
                    aria-haspopup="menu"
                    <%= "disabled" if @available_translations.blank? %>>
              <span><%= t("corpus_viewer.toolbar.translations", count: @available_translations.length) %></span>
              <% if @available_translations.present? %>
                <span class="corpus-toolbar-control-group__chevron" aria-hidden="true">▾</span>
              <% end %>
            </button>

            <% if @companion_submission_enabled %>
              <button type="button"
                      class="corpus-btn corpus-toolbar-control-group__add"
                      title="<%= t("corpus_viewer.toolbar.add_translation") %>"
                      aria-label="<%= t("corpus_viewer.toolbar.add_translation") %>"
                      data-action="companion-material-ticket#openForType"
                      data-companion-material-ticket-material-type-param="translation">+</button>
            <% end %>

            <% if @available_translations.present? %>
              <div class="cv-toolbar-menu"
                   data-toolbar-menu-target="menu"
                   role="menu"
                   hidden>
                <%= link_to t("corpus_viewer.toolbar.source_text"),
                            corpus_viewer_path(@source_rel_path.split("/"), format: nil),
                            class: "corpus-btn #{@display_translation.blank? && @display_annotation_system.blank? ? 'is-active' : ''}",
                            role: "menuitem" %>
                <% @available_translations.each_value do |translation| %>
                  <% label = translation_label_for.call(translation) %>
                  <% label = "#{label}#{t("corpus_viewer.header.ai_assisted_menu_suffix")}" if translation["ai_assisted"] == true %>
                  <%= link_to label,
                              corpus_viewer_path(@source_rel_path.split("/"), format: nil, translation: translation["id"]),
                              class: "corpus-btn #{@display_translation && @display_translation['id'] == translation['id'] ? 'is-active' : ''}",
                              role: "menuitem",
                              data: {
                                companion_materials_target: "material",
                                ai_assisted: translation["ai_assisted"] == true,
                                active: @display_translation && @display_translation["id"] == translation["id"]
                              } %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if @variant_materials.present? %>
          <div class="corpus-toolbar-control-group corpus-toolbar-control-group--single"
               data-controller="toolbar-menu">
            <button type="button"
                    class="corpus-btn corpus-toolbar-control-group__trigger"
                    data-action="toolbar-menu#toggle"
                    data-toolbar-menu-target="button"
                    aria-expanded="false"
                    aria-haspopup="menu">
              <span><%= t("corpus_viewer.toolbar.variants", count: @variant_materials.length) %></span>
              <span class="corpus-toolbar-control-group__chevron" aria-hidden="true">▾</span>
            </button>

            <div class="cv-toolbar-menu"
                 data-toolbar-menu-target="menu"
                 role="menu"
                 hidden>
              <% @variant_materials.each do |variant| %>
                <% label = variant["title"].presence || (variant["related_path"].present? ? File.basename(variant["related_path"]) : t("corpus_viewer.toolbar.external_variant")) %>
                <% if variant["related_path"].present? %>
                  <%= link_to label,
                              corpus_viewer_path(variant["related_path"].split("/"), format: nil),
                              class: "corpus-btn",
                              role: "menuitem" %>
                <% elsif Array(variant["links"]).first.present? %>
                  <%= link_to label,
                              Array(variant["links"]).first,
                              class: "corpus-btn",
                              role: "menuitem",
                              target: "_blank",
                              rel: "noopener noreferrer" %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @annotation_system_editor_enabled || @available_annotation_systems.present? %>
          <span class="corpus-toolbar-traditions"
                data-controller="kanbun-ticket"
                data-kanbun-ticket-source-value="corpus_viewer"
                data-kanbun-ticket-target-path-value="<%= @source_rel_path %>">
            <span class="corpus-toolbar-control-group <%= 'corpus-toolbar-control-group--single' unless @annotation_system_editor_enabled %>"
                  data-controller="toolbar-menu">
              <button type="button"
                      class="corpus-btn corpus-toolbar-control-group__trigger"
                      data-action="toolbar-menu#toggle"
                      data-toolbar-menu-target="button"
                      aria-expanded="false"
                      aria-haspopup="menu"
                      <%= "disabled" if @available_annotation_systems.blank? %>>
                <span><%= t("corpus_viewer.toolbar.annotation_systems", count: @available_annotation_systems.length) %></span>
                <% if @available_annotation_systems.present? %>
                  <span class="corpus-toolbar-control-group__chevron" aria-hidden="true">▾</span>
                <% end %>
              </button>

              <% if @annotation_system_editor_enabled %>
                <button type="button"
                        class="corpus-btn corpus-toolbar-control-group__add"
                        title="<%= t("corpus_viewer.toolbar.create_annotation_system") %>"
                        aria-label="<%= t("corpus_viewer.toolbar.create_annotation_system") %>"
                        data-action="kanbun-ticket#toggle">+</button>
              <% end %>

              <% if @available_annotation_systems.present? %>
                <div class="cv-toolbar-menu"
                     data-toolbar-menu-target="menu"
                     role="menu"
                     hidden>
                  <%= link_to t("corpus_viewer.toolbar.source_text"),
                              corpus_viewer_path(@source_rel_path.split("/"), format: nil),
                              class: "corpus-btn #{@display_translation.blank? && @display_annotation_system.blank? ? 'is-active' : ''}",
                              role: "menuitem" %>
                  <% annotation_system_labels.each do |annotation_system, label| %>
                    <% next unless @available_annotation_systems[annotation_system].present? %>
                    <% material = @annotation_system_materials[annotation_system] %>
                    <% display_label = material && material["ai_assisted"] == true ? "#{label}#{t("corpus_viewer.header.ai_assisted_menu_suffix")}" : label %>
                    <%= link_to display_label,
                                corpus_viewer_path(@source_rel_path.split("/"), format: nil, annotation_system: annotation_system),
                                class: "corpus-btn #{@display_annotation_system == annotation_system ? 'is-active' : ''}",
                                role: "menuitem",
                                data: {
                                  companion_materials_target: material.present? ? "material" : nil,
                                  ai_assisted: material && material["ai_assisted"] == true,
                                  active: @display_annotation_system == annotation_system
                                } %>
                  <% end %>
                </div>
              <% end %>
            </span>

            <% if @annotation_system_editor_enabled %>
              <div class="cv-text-edit-panel cv-kanbun-panel hidden" data-kanbun-ticket-target="panel">
              <h3 style="margin-top: 0;"><%= t("corpus_viewer.annotation_systems.editor.heading") %></h3>
              <p class="cv-hint"><%= t("corpus_viewer.annotation_systems.editor.explanation_html") %></p>

              <form data-action="submit->kanbun-ticket#submit">
                <div class="cv-form-row">
                  <label><%= t("corpus_viewer.annotation_systems.editor.system") %></label>
                  <select class="cv-input" data-kanbun-ticket-target="annotationSystem" data-action="change->kanbun-ticket#annotationSystemChanged">
                    <option value="kanbun"><%= t("corpus_viewer.annotation_systems.editor.options.kanbun") %></option>
                    <option value="hanmun"><%= t("corpus_viewer.annotation_systems.editor.options.hanmun") %></option>
                    <option value="hanvan"><%= t("corpus_viewer.annotation_systems.editor.options.hanvan") %></option>
                  </select>
                </div>

                <div class="cv-form-row">
                  <label><%= t("common.forms.summary") %></label>
                  <input type="text" class="cv-input" placeholder="<%= t("corpus_viewer.annotation_systems.editor.summary_placeholder") %>" data-kanbun-ticket-target="summary" />
                </div>

                <div class="cv-form-row">
                  <label><%= t("common.forms.reasoning") %></label>
                  <textarea class="cv-textarea" rows="3" placeholder="<%= t("corpus_viewer.annotation_systems.editor.reasoning_placeholder") %>" data-kanbun-ticket-target="reasoning"></textarea>
                </div>

                <div class="cv-form-row">
                  <label><%= t("corpus_viewer.annotation_systems.editor.digital_keyboard") %></label>
                  <div class="cv-kanbun-keyboard">
                    <% ["㆐", "㆑", "㆒", "㆓", "㆔", "㆕", "㆖", "㆗", "㆘", "㆙", "㆚", "㆛", "㆜", "㆝", "㆞", "㆟"].each do |symbol| %>
                      <button type="button" class="corpus-btn cv-kanbun-key" data-symbol="<%= symbol %>" data-action="kanbun-ticket#insertSymbol"><%= symbol %></button>
                    <% end %>
                  </div>
                </div>

                <p class="cv-hint" data-kanbun-ticket-target="aiNotice" hidden><%= t("corpus_viewer.annotation_systems.editor.ai_notice") %></p>

                <div class="cv-kanbun-side-by-side">
                  <div class="cv-kanbun-pane">
                    <label><%= t("corpus_viewer.annotation_systems.editor.source_page") %></label>
                    <textarea class="cv-textarea cv-mono" rows="24" readonly><%= @source_body %></textarea>
                  </div>
                  <div class="cv-kanbun-pane">
                    <label><%= t("corpus_viewer.annotation_systems.editor.text") %></label>
                    <textarea class="cv-textarea cv-mono" rows="24" data-kanbun-ticket-target="annotationText"><%= @source_body %></textarea>
                  </div>
                </div>

                <textarea class="hidden" data-kanbun-ticket-target="sourceSeed"><%= @source_body %></textarea>
                <textarea class="hidden" data-kanbun-ticket-target="kanbunSeed"><%= @annotation_system_bodies['kanbun'].to_s %></textarea>
                <textarea class="hidden" data-kanbun-ticket-target="hanmunSeed"><%= @annotation_system_bodies['hanmun'].to_s %></textarea>
                <textarea class="hidden" data-kanbun-ticket-target="hanvanSeed"><%= @annotation_system_bodies['hanvan'].to_s %></textarea>

                <%= render "corpus_viewer/material_metadata_fields",
                           stimulus_controller: "kanbun-ticket" %>

                <%= render "corpus_viewer/ticket_optional_fields",
                           stimulus_controller: "kanbun-ticket",
                           include_uploads: true %>

                <div class="cv-form-actions">
                  <button type="submit" class="corpus-btn corpus-btn-primary"><%= t("common.actions.submit_ticket") %></button>
                  <button type="button" class="corpus-btn" data-action="kanbun-ticket#toggle"><%= t("common.actions.close") %></button>
                </div>
              </form>

              <div class="cv-ticket-result">
                <div class="cv-ticket-status" data-kanbun-ticket-target="status"></div>
                <div class="cv-ticket-kv">
                  <div><strong><%= t("common.tickets.ticket_id") %></strong> <span data-kanbun-ticket-target="ticketId"></span></div>
                  <div>
                    <strong><%= t("common.tickets.ticket_key") %></strong>
                    <code data-kanbun-ticket-target="ticketKey"></code>
                    <button type="button" class="corpus-btn" data-kanbun-ticket-target="copyKeyBtn" data-action="kanbun-ticket#copyKey"><%= t("common.actions.copy") %></button>
                    <button type="button" class="corpus-btn" data-kanbun-ticket-target="downloadKeyBtn" data-action="kanbun-ticket#downloadKey" hidden><%= t("common.actions.download_txt") %></button>
                    <a href="#" class="corpus-btn" data-kanbun-ticket-target="openTicketLink" hidden><%= t("common.actions.open_ticket") %></a>
                  </div>
                </div>
              </div>
            </div>
            <% end %>
          </span>
        <% end %>

        <% if @companion_submission_enabled %>
          <div class="corpus-toolbar-control-group corpus-toolbar-control-group--single"
               data-controller="toolbar-menu">
            <button type="button"
                    class="corpus-btn corpus-toolbar-control-group__trigger"
                    data-action="toolbar-menu#toggle"
                    data-toolbar-menu-target="button"
                    aria-expanded="false"
                    aria-haspopup="menu">
              <span><%= t("corpus_viewer.toolbar.other_materials") %></span>
              <span class="corpus-toolbar-control-group__chevron" aria-hidden="true">▾</span>
            </button>

            <div class="cv-toolbar-menu"
                 data-toolbar-menu-target="menu"
                 role="menu"
                 hidden>
              <button type="button"
                      class="corpus-btn"
                      role="menuitem"
                      data-action="toolbar-menu#close companion-material-ticket#openForType"
                      data-companion-material-ticket-material-type-param="gallery_image"><%= t("corpus_viewer.toolbar.add_gallery_images") %></button>
              <button type="button"
                      class="corpus-btn"
                      role="menuitem"
                      data-action="toolbar-menu#close companion-material-ticket#openForType"
                      data-companion-material-ticket-material-type-param="exemplar_manuscript"><%= t("corpus_viewer.toolbar.add_exemplar_manuscript") %></button>
              <button type="button"
                      class="corpus-btn"
                      role="menuitem"
                      data-action="toolbar-menu#close companion-material-ticket#openForType"
                      data-companion-material-ticket-material-type-param="variant_text"><%= t("corpus_viewer.toolbar.add_variant_connection") %></button>
            </div>
          </div>
        <% end %>

        <%= render "corpus_viewer/companion_submission" %>

      <% unless @display_translation.present? %>
      <div class="corpus-toolbar-editing">
        <button type="button"
                class="corpus-btn corpus-btn-editing"
                data-action="corpus-annotations#toggleAnnotate"
                data-corpus-annotations-target="annotateBtn"
                aria-pressed="false">
          <%= t("corpus_viewer.toolbar.annotate_off") %>
        </button>

        <button type="button"
                class="corpus-btn corpus-btn-primary corpus-btn-review-submit"
                data-action="corpus-annotations#saveDraft"
                data-corpus-annotations-target="saveBtn"
                hidden>
          <%= t("corpus_viewer.toolbar.review_submit") %>
        </button>

        <% if @text_edit_enabled %>
        <span
          data-controller="text-edit-ticket"
          data-text-edit-ticket-source-value="corpus_viewer"
          data-text-edit-ticket-target-path-value="<%= @active_text_target_path %>">
          <button type="button"
                  class="corpus-btn corpus-btn-editing"
                  data-action="text-edit-ticket#toggle"
                  title="<%= t("corpus_viewer.toolbar.text_edit_title") %>">
            <%= t("corpus_viewer.toolbar.text_edit") %>
          </button>

          <div class="cv-text-edit-panel hidden" data-text-edit-ticket-target="panel">
            <h3 style="margin-top: 0;"><%= t("corpus_viewer.text_edit.heading") %></h3>
            <p class="cv-hint"><%= t("corpus_viewer.text_edit.explanation_html") %></p>

            <form data-action="submit->text-edit-ticket#submit">
              <div class="cv-form-row">
                <label><%= t("common.forms.title") %></label>
                <input type="text" class="cv-input" value="<%= t("corpus_viewer.text_edit.default_title") %>" data-text-edit-ticket-target="title" />
              </div>
              <div class="cv-form-row">
                <label><%= t("common.forms.summary") %></label>
                <input type="text" class="cv-input" placeholder="<%= t("corpus_viewer.text_edit.summary_placeholder") %>" data-text-edit-ticket-target="summary" />
              </div>
              <div class="cv-form-row">
                <label><%= t("common.forms.reasoning") %></label>
                <textarea class="cv-textarea" rows="3" placeholder="<%= t("corpus_viewer.text_edit.reasoning_placeholder") %>" data-text-edit-ticket-target="reasoning"></textarea>
              </div>

              <div class="cv-form-row">
                <label><%= t("corpus_viewer.text_edit.edited_text") %></label>
                <textarea class="cv-textarea cv-mono" rows="18" data-text-edit-ticket-target="edited"></textarea>
              </div>

              <textarea class="hidden" data-text-edit-ticket-target="original"><%= @raw_body %></textarea>

              <%= render "corpus_viewer/ticket_optional_fields",
                         stimulus_controller: "text-edit-ticket",
                         include_uploads: true %>

              <div class="cv-form-actions">
                <button type="submit" class="corpus-btn corpus-btn-primary"><%= t("common.actions.submit_ticket") %></button>
                <button type="button" class="corpus-btn" data-action="text-edit-ticket#toggle"><%= t("common.actions.close") %></button>
              </div>
            </form>

            <div class="cv-ticket-result">
              <div class="cv-ticket-status" data-text-edit-ticket-target="status"></div>
              <div class="cv-ticket-kv">
                <div><strong><%= t("common.tickets.ticket_id") %></strong> <span data-text-edit-ticket-target="ticketId"></span></div>
                <div>
                  <strong><%= t("common.tickets.ticket_key") %></strong>
                  <code data-text-edit-ticket-target="ticketKey"></code>
                  <button type="button" class="corpus-btn" data-text-edit-ticket-target="copyKeyBtn" data-action="text-edit-ticket#copyKey"><%= t("common.actions.copy") %></button>
                  <button type="button" class="corpus-btn" data-text-edit-ticket-target="downloadKeyBtn" data-action="text-edit-ticket#downloadKey" hidden><%= t("common.actions.download_txt") %></button>
                </div>
              </div>
            </div>
          </div>
        </span>
        <% end %>

        <% if @metadata_rel_path.present? %>
          <% metadata_values = @metadata_edit_values || {} %>
          <span
            data-controller="text-edit-ticket"
            data-text-edit-ticket-source-value="metadata_edit"
            data-text-edit-ticket-target-path-value="<%= @metadata_rel_path %>">
            <button type="button"
                    class="corpus-btn corpus-btn-editing"
                    data-action="text-edit-ticket#toggle"
                    title="Propose a metadata edit">
              Metadata edit
            </button>

            <div class="cv-text-edit-panel hidden" data-text-edit-ticket-target="panel">
              <h3 style="margin-top: 0;">Propose a metadata edit</h3>
              <p class="cv-hint">Edit the fields below. The server will turn them into valid metadata.json and create a normal review ticket.</p>

              <form data-action="submit->text-edit-ticket#submit">
                <input type="hidden" value="metadata_fields" data-text-edit-ticket-target="editMode" />
                <div class="cv-form-row">
                  <label><%= t("common.forms.title") %></label>
                  <input type="text" class="cv-input" value="Metadata edit" data-text-edit-ticket-target="title" />
                </div>
                <div class="cv-form-row">
                  <label><%= t("common.forms.summary") %></label>
                  <input type="text" class="cv-input" placeholder="What metadata changed?" data-text-edit-ticket-target="summary" />
                </div>
                <div class="cv-form-row">
                  <label><%= t("common.forms.reasoning") %></label>
                  <textarea class="cv-textarea" rows="3" placeholder="Why should this metadata change be made?" data-text-edit-ticket-target="reasoning"></textarea>
                </div>

                <div class="cv-form-row">
                  <label>Work title</label>
                  <input type="text" class="cv-input" value="<%= metadata_values['title'] %>" data-text-edit-ticket-target="metadataTitle" />
                </div>
                <div class="cv-form-row">
                  <label>Author(s)</label>
                  <textarea class="cv-textarea" rows="2" placeholder="One author per line, or separate with semicolons" data-text-edit-ticket-target="metadataAuthors"><%= metadata_values['authors'] %></textarea>
                </div>
                <div class="cv-form-row">
                  <label>Date / year label</label>
                  <input type="text" class="cv-input" value="<%= metadata_values['date_label'] %>" data-text-edit-ticket-target="metadataDateLabel" />
                </div>
                <div class="cv-form-row">
                  <label>Corpus root / nation</label>
                  <input type="text" class="cv-input" value="<%= metadata_values['corpus_root'] %>" data-text-edit-ticket-target="metadataCorpusRoot" />
                </div>
                <div class="cv-form-row">
                  <label>Period</label>
                  <input type="text" class="cv-input" value="<%= metadata_values['period'] %>" data-text-edit-ticket-target="metadataPeriod" />
                </div>
                <div class="cv-form-row">
                  <label>Polity</label>
                  <input type="text" class="cv-input" value="<%= metadata_values['polity'] %>" data-text-edit-ticket-target="metadataPolity" />
                </div>
                <div class="cv-form-row">
                  <label>Region</label>
                  <input type="text" class="cv-input" value="<%= metadata_values['region'] %>" data-text-edit-ticket-target="metadataRegion" />
                </div>
                <div class="cv-form-row">
                  <label>Categories</label>
                  <textarea class="cv-textarea" rows="4" placeholder="One category per line, or separate with semicolons" data-text-edit-ticket-target="metadataCategories"><%= metadata_values['categories'] %></textarea>
                </div>
                <div class="cv-form-row">
                  <label>Sources / references</label>
                  <textarea class="cv-textarea" rows="4" placeholder="One source per line" data-text-edit-ticket-target="metadataSources"><%= metadata_values['sources'] %></textarea>
                </div>

                <%= render "corpus_viewer/ticket_optional_fields",
                           stimulus_controller: "text-edit-ticket",
                           include_uploads: true %>

                <div class="cv-form-actions">
                  <button type="submit" class="corpus-btn corpus-btn-primary"><%= t("common.actions.submit_ticket") %></button>
                  <button type="button" class="corpus-btn" data-action="text-edit-ticket#toggle"><%= t("common.actions.close") %></button>
                </div>
              </form>

              <div class="cv-ticket-result">
                <div class="cv-ticket-status" data-text-edit-ticket-target="status"></div>
                <div class="cv-ticket-kv">
                  <div><strong><%= t("common.tickets.ticket_id") %></strong> <span data-text-edit-ticket-target="ticketId"></span></div>
                  <div>
                    <strong><%= t("common.tickets.ticket_key") %></strong>
                    <code data-text-edit-ticket-target="ticketKey"></code>
                    <button type="button" class="corpus-btn" data-text-edit-ticket-target="copyKeyBtn" data-action="text-edit-ticket#copyKey"><%= t("common.actions.copy") %></button>
                    <button type="button" class="corpus-btn" data-text-edit-ticket-target="downloadKeyBtn" data-action="text-edit-ticket#downloadKey" hidden><%= t("common.actions.download_txt") %></button>
                  </div>
                </div>
              </div>
            </div>
          </span>
        <% end %>
      </div>
      <% end %>
    </div>

    <%# Metadata is loaded from metadata.json beside the work text and is display-only. %>
    <% if (defined?(@meta) && @meta.present?) %>
      <details class="corpus-metabox"
               style="margin: 0 0 10px; border: 1px solid rgba(0,0,0,0.10); border-radius: 12px; padding: 10px; background: #fff;">
        <summary class="corpus-metabox-summary">
          <strong><%= t("corpus_viewer.metadata.heading") %></strong>
          <% if meta_page_title.present? && meta_ws_cats.present? %>
            <span style="margin-left: 10px;">
              <%= link_to t("corpus_viewer.metadata.wikisource"), "https://zh.wikisource.org/wiki/#{ERB::Util.url_encode(meta_page_title)}",
                          target: "_blank", rel: "noopener",
                          class: "corpus-btn corpus-btn-ghost",
                          style: "text-decoration: none;" %>
            </span>
          <% end %>
        </summary>
        <div class="corpus-metabox-scroll" role="region" aria-label="<%= t("corpus_viewer.metadata.aria_label") %>"
             style="max-height: 160px; overflow: auto; padding-top: 8px;">
          <dl class="corpus-metabox-dl" style="margin: 0;">
            <% @meta.each do |(k, v)| %>
              <div class="corpus-metabox-row" style="display: grid; grid-template-columns: 180px 1fr; gap: 10px; padding: 4px 0;">
                <dt class="corpus-metabox-key" style="margin: 0; font-weight: 600;">
                  <%= k %>
                </dt>
                <dd class="corpus-metabox-val" style="margin: 0; opacity: 0.9;">
                  <%= v.present? ? v : "" %>
                </dd>
              </div>
            <% end %>
          </dl>
        </div>
      </details>
    <% end %>

    <div class="corpus-punct-overlay"
         data-corpus-reader-target="punctOverlay"
         data-action="click->corpus-reader#onPunctOverlayClick"
         hidden>
      <div class="corpus-punct-panel"
           data-corpus-reader-target="punctPanel"
           role="dialog"
           aria-label="<%= t("corpus_viewer.toolbar.punctuation_options") %>">
        <div class="corpus-punct-header">
          <div class="corpus-punct-title"><%= t("corpus_viewer.punctuation.heading") %></div>
          <div class="corpus-punct-actions">
            <button type="button" class="corpus-btn corpus-btn-ghost" data-action="click->corpus-reader#okPunctMenu" data-corpus-reader-target="punctOkBtn"><%= t("common.actions.ok") %></button>
            <button type="button" class="corpus-btn corpus-btn-ghost" data-action="click->corpus-reader#closePunctMenu" data-corpus-reader-target="punctCloseBtn">✕</button>
          </div>
        </div>

        <div class="corpus-punct-grid">
          <fieldset class="corpus-fieldset preset-box">
            <legend><%= t("corpus_viewer.punctuation.preset.heading") %></legend>
            <label><input type="radio" name="cv_preset" value="source" data-action="change->corpus-reader#setPunctPresetRadio"> <%= t("corpus_viewer.punctuation.preset.source") %></label>
            <label><input type="radio" name="cv_preset" value="modern_trad" data-action="change->corpus-reader#setPunctPresetRadio"> <%= t("corpus_viewer.punctuation.preset.modern_traditional") %></label>
            <label><input type="radio" name="cv_preset" value="modern_prc" data-action="change->corpus-reader#setPunctPresetRadio"> <%= t("corpus_viewer.punctuation.preset.modern_prc") %></label>
            <label><input type="radio" name="cv_preset" value="pure" data-action="change->corpus-reader#setPunctPresetRadio"> <%= t("corpus_viewer.punctuation.preset.pure_classical") %></label>
            <label><input type="radio" name="cv_preset" value="strip" data-action="change->corpus-reader#setPunctPresetRadio"> <%= t("corpus_viewer.punctuation.preset.strip") %></label>
            <label><input type="radio" name="cv_preset" value="custom" data-action="change->corpus-reader#setPunctPresetRadio"> <%= t("corpus_viewer.punctuation.preset.custom") %></label>
          </fieldset>

          <fieldset class="corpus-fieldset">
            <legend><%= t("corpus_viewer.punctuation.quotes.heading") %></legend>
            <div class="corpus-subtitle"><%= t("corpus_viewer.punctuation.quotes.family") %></div>
            <label><input type="radio" name="cv_quote_family" value="corner" data-action="change->corpus-reader#setPunctOptionRadio"> <%= t("corpus_viewer.punctuation.quotes.chinese_quotation_marks") %></label>
            <label><input type="radio" name="cv_quote_family" value="speech_curly" data-action="change->corpus-reader#setPunctOptionRadio"> <%= t("corpus_viewer.punctuation.quotes.latin_speech_marks") %></label>
            <label><input type="radio" name="cv_quote_family" value="speech_fullwidth" data-action="change->corpus-reader#setPunctOptionRadio"> <%= t("corpus_viewer.punctuation.quotes.chinese_speech_marks") %></label>
            <label><input type="radio" name="cv_quote_family" value="off" data-action="change->corpus-reader#setPunctOptionRadio"> <%= t("corpus_viewer.punctuation.quotes.disabled") %></label>

            <div class="corpus-subtitle"><%= t("corpus_viewer.punctuation.quotes.ordering") %></div>
            <label><input type="radio" name="cv_quote_order" value="trad" data-action="change->corpus-reader#setPunctOptionRadio"> <%= t("corpus_viewer.punctuation.quotes.traditional") %></label>
            <label><input type="radio" name="cv_quote_order" value="simp" data-action="change->corpus-reader#setPunctOptionRadio"> <%= t("corpus_viewer.punctuation.quotes.simplified") %></label>

            <label class="corpus-check"><input type="checkbox" data-corpus-reader-target="verticalQuoteFormsChk" data-action="change->corpus-reader#toggleVerticalQuoteForms"> <%= t("corpus_viewer.punctuation.quotes.vertical_forms") %></label>
          </fieldset>

          <fieldset class="corpus-fieldset">
            <legend><%= t("corpus_viewer.punctuation.question_exclamation.heading") %></legend>
            <label><input type="radio" name="cv_q" value="keep" data-action="change->corpus-reader#setPunctOptionRadio"> <%= t("corpus_viewer.punctuation.question_exclamation.keep_question") %></label>
            <label><input type="radio" name="cv_q" value="collapse" data-action="change->corpus-reader#setPunctOptionRadio"> <%= t("corpus_viewer.punctuation.question_exclamation.collapse_question") %></label>
            <div style="height:6px"></div>
            <label><input type="radio" name="cv_ex" value="keep" data-action="change->corpus-reader#setPunctOptionRadio"> <%= t("corpus_viewer.punctuation.question_exclamation.keep_exclamation") %></label>
            <label><input type="radio" name="cv_ex" value="collapse" data-action="change->corpus-reader#setPunctOptionRadio"> <%= t("corpus_viewer.punctuation.question_exclamation.collapse_exclamation") %></label>
          </fieldset>

          <fieldset class="corpus-fieldset">
            <legend><%= t("corpus_viewer.punctuation.semicolon_colon.heading") %></legend>
            <label><input type="radio" name="cv_semi" value="keep" data-action="change->corpus-reader#setPunctOptionRadio"> <%= t("corpus_viewer.punctuation.semicolon_colon.keep_semicolon") %></label>
            <label><input type="radio" name="cv_semi" value="collapse" data-action="change->corpus-reader#setPunctOptionRadio"> <%= t("corpus_viewer.punctuation.semicolon_colon.collapse_semicolon") %></label>
            <div style="height:6px"></div>
            <label><input type="radio" name="cv_colon" value="keep" data-action="change->corpus-reader#setPunctOptionRadio"> <%= t("corpus_viewer.punctuation.semicolon_colon.keep_colon") %></label>
            <label><input type="radio" name="cv_colon" value="collapse" data-action="change->corpus-reader#setPunctOptionRadio"> <%= t("corpus_viewer.punctuation.semicolon_colon.collapse_colon") %></label>
          </fieldset>

          <fieldset class="corpus-fieldset">
            <legend><%= t("corpus_viewer.punctuation.comma.heading") %></legend>
            <label><input type="radio" name="cv_comma" value="keep" data-action="change->corpus-reader#setPunctOptionRadio"> <%= t("corpus_viewer.punctuation.comma.comma") %></label>
            <label><input type="radio" name="cv_comma" value="dunhao" data-action="change->corpus-reader#setPunctOptionRadio"> <%= t("corpus_viewer.punctuation.comma.dunhao") %></label>
          </fieldset>

          <fieldset class="corpus-fieldset">
            <legend><%= t("corpus_viewer.punctuation.repetition.heading") %></legend>
            <label><input type="radio" name="cv_repeat_mark" value="none" data-action="change->corpus-reader#setRepeatMarkRadio"> <%= t("corpus_viewer.punctuation.repetition.none") %></label>
            <label><input type="radio" name="cv_repeat_mark" value="kanji" data-action="change->corpus-reader#setRepeatMarkRadio"> <%= t("corpus_viewer.punctuation.repetition.kanji") %></label>
            <label><input type="radio" name="cv_repeat_mark" value="vertical" data-action="change->corpus-reader#setRepeatMarkRadio"> <%= t("corpus_viewer.punctuation.repetition.vertical") %></label>
            <label><input type="radio" name="cv_repeat_mark" value="zhou" data-action="change->corpus-reader#setRepeatMarkRadio"> <%= t("corpus_viewer.punctuation.repetition.zhou") %></label>
          </fieldset>
        </div>
      </div>
    </div>

    <div class="corpus-viewbox" data-corpus-reader-target="viewbox">
      <div class="corpus-textflow"
           data-corpus-reader-target="content"
           data-action="contextmenu->corpus-reader#onContextMenu">
        <%# Ruby markup must be generated server-side so it can use session preferences.
            The helper returns an html_safe buffer, so do NOT escape it. %>
        <%= corpus_text_with_optional_ruby(@text, allow_ruby: @display_translation.blank?) %>
      </div>
    </div>

    <%= render "corpus_viewer/companion_materials" %>
  </div>

<% else %>
  <p><%= t("corpus_viewer.unexpected_state") %></p>
<% end %>
