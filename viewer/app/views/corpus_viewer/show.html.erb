<h1>Corpus Viewer</h1>

<p class="crumbs">
  <% if @rel_path.present? %>
    <% parts = @rel_path.to_s.split("/") %>
    <%= link_to "Root", corpus_viewer_path %>
    <% acc = [] %>
    <% parts.each do |part| %>
      <% acc << part %>
      <span class="crumb-sep">/</span>
      <%= link_to part, corpus_viewer_path(acc, format: nil) %>
    <% end %>
  <% end %>
</p>

<% if @kind == :dir %>
  <p><strong><%= @rel_path.present? ? @rel_path : "Root" %></strong></p>

  <ul class="corpus-list">
    <% @children.each do |name| %>
      <% child_rel = @rel_path.present? ? "#{@rel_path}/#{name}" : name %>
      <li>
        <%= link_to name, corpus_viewer_path(child_rel.split("/"), format: nil) %>
      </li>
    <% end %>
  </ul>

<% elsif @kind == :file %>
  <%= render "rightbar" %>

<%
  meta_hash = (defined?(@meta) && @meta.respond_to?(:to_h)) ? @meta.to_h : {}

  meta_work       = meta_hash["Work"].to_s.strip
  meta_author     = meta_hash["Author"].to_s.strip
  meta_ws_cats    = meta_hash["Ws Categories"].to_s.strip
  meta_page_title = meta_hash["Page title"].to_s.strip # to derive wikisource links

  derived_work = begin
    File.basename(File.dirname(@rel_path.to_s))
  rescue
    ""
  end
  meta_work = derived_work if meta_work.blank? && derived_work.present?
%>

  <div class="corpus-filebar">
    <div class="corpus-headmeta">
	  <% if meta_work.present? %>
        <span class="corpus-headmeta-item"><strong>Work:</strong> <%= meta_work %></span>
      <% end %>
      <% if meta_author.present? %>
        <span class="corpus-headmeta-item"><strong>Author:</strong> <%= meta_author %></span>
      <% end %>
    </div>
  </div>


  <div class="corpus-reader" data-controller="corpus-reader corpus-annotations"
       data-corpus-annotations-path-value="<%= @rel_path %>"
       data-corpus-annotations-url-value="/corpus_annotations">
    <div class="corpus-toolbar" role="toolbar" aria-label="Corpus viewer tools">
      <button type="button"
              class="corpus-btn"
              data-action="corpus-reader#toggleVertical"
              data-corpus-reader-target="verticalBtn"
              aria-pressed="false">
        Vertical
      </button>

      <button type="button"
              class="corpus-btn"
              data-action="corpus-reader#cycleTheme"
              data-corpus-reader-target="themeBtn"
              aria-pressed="false">
        Theme
      </button>
      <button type="button"
              class="corpus-btn"
              data-action="corpus-reader#cyclePunctPreset"
              data-corpus-reader-target="punctPresetBtn"
              aria-pressed="false">
        Punct: Source
      </button>

      <button type="button"
              class="corpus-btn corpus-btn-split"
              title="Punctuation options"
              aria-label="Punctuation options"
              data-action="corpus-reader#togglePunctMenu"
              data-corpus-reader-target="punctMenuBtn">
        ▸
      </button>

      <button type="button"
              class="corpus-btn"
              data-action="corpus-reader#toggleJudou"
              data-corpus-reader-target="judouBtn"
              aria-pressed="true">
        Judou: On
      </button>

      
      <button type="button"
              class="corpus-btn"
              data-action="corpus-annotations#toggleNotes"
              data-corpus-annotations-target="notesBtn"
              aria-pressed="false">
        Notes: Off
      </button>

      <button type="button"
              class="corpus-btn"
              data-action="corpus-annotations#openColorSettings"
              title="Colour settings"
              aria-label="Colour settings">
        Colour settings
      </button>

      <div class="corpus-toolbar-spacer" aria-hidden="true"></div>

      <div class="corpus-toolbar-editing">
        <button type="button"
                class="corpus-btn corpus-btn-editing"
                data-action="corpus-annotations#toggleAnnotate"
                data-corpus-annotations-target="annotateBtn"
                aria-pressed="false">
          Annotate: Off
        </button>

        <button type="button"
                class="corpus-btn corpus-btn-primary corpus-btn-review-submit"
                data-action="corpus-annotations#saveDraft"
                data-corpus-annotations-target="saveBtn"
                hidden>
          Review &amp; submit
        </button>

        <span
          data-controller="text-edit-ticket"
          data-text-edit-ticket-source-value="corpus_viewer"
          data-text-edit-ticket-target-path-value="<%= @rel_path %>">
          <button type="button"
                  class="corpus-btn corpus-btn-editing"
                  data-action="text-edit-ticket#toggle"
                  title="Propose a text change (creates a ticket)">
            Text edit
          </button>

          <div class="cv-text-edit-panel hidden" data-text-edit-ticket-target="panel">
            <h3 style="margin-top: 0;">Propose a text edit (creates a ticket)</h3>
            <p class="cv-hint">This does <em>not</em> change the corpus directly. It creates a ticket with a unified diff attached.</p>

            <form data-action="submit->text-edit-ticket#submit">
              <div class="cv-form-row">
                <label>Title</label>
                <input type="text" class="cv-input" value="Text edit" data-text-edit-ticket-target="title" />
              </div>
              <div class="cv-form-row">
                <label>Summary</label>
                <input type="text" class="cv-input" placeholder="What changed?" data-text-edit-ticket-target="summary" />
              </div>
              <div class="cv-form-row">
                <label>Reasoning</label>
                <textarea class="cv-textarea" rows="3" placeholder="Why should this change be made?" data-text-edit-ticket-target="reasoning"></textarea>
              </div>

              <div class="cv-form-row">
                <label>Edited text</label>
                <textarea class="cv-textarea cv-mono" rows="18" data-text-edit-ticket-target="edited"></textarea>
              </div>

              <textarea class="hidden" data-text-edit-ticket-target="original"><%= @raw_body %></textarea>

              <div class="cv-form-actions">
                <button type="submit" class="corpus-btn corpus-btn-primary">Submit ticket</button>
                <button type="button" class="corpus-btn" data-action="text-edit-ticket#toggle">Close</button>
              </div>
            </form>

            <div class="cv-ticket-result">
              <div class="cv-ticket-status" data-text-edit-ticket-target="status"></div>
              <div class="cv-ticket-kv">
                <div><strong>Ticket ID:</strong> <span data-text-edit-ticket-target="ticketId"></span></div>
                <div>
                  <strong>Ticket key (save this):</strong>
                  <code data-text-edit-ticket-target="ticketKey"></code>
                  <button type="button" class="corpus-btn" data-text-edit-ticket-target="copyKeyBtn" data-action="text-edit-ticket#copyKey">Copy</button>
                </div>
              </div>
            </div>
          </div>
        </span>
      </div>

    </div>

    <%# Metadata is parsed from leading "#" lines in the corpus file and is display-only. %>
    <% if (defined?(@meta) && @meta.present?) %>
      <details class="corpus-metabox"
               style="margin: 0 0 10px; border: 1px solid rgba(0,0,0,0.10); border-radius: 12px; padding: 10px; background: #fff;">
        <summary class="corpus-metabox-summary">
  <strong>Metadata</strong>
  <% if meta_page_title.present? && meta_ws_cats.present? %>
    <span style="margin-left: 10px;">
      <%= link_to "维基文库", "https://zh.wikisource.org/wiki/#{ERB::Util.url_encode(meta_page_title)}",
                  target: "_blank", rel: "noopener",
                  class: "corpus-btn corpus-btn-ghost",
                  style: "text-decoration: none;" %>
    </span>
  <% end %>
</summary>
        <div class="corpus-metabox-scroll" role="region" aria-label="Text metadata"
             style="max-height: 160px; overflow: auto; padding-top: 8px;">
          <dl class="corpus-metabox-dl" style="margin: 0;">
            <% @meta.each do |(k, v)| %>
              <div class="corpus-metabox-row" style="display: grid; grid-template-columns: 180px 1fr; gap: 10px; padding: 4px 0;">
                <dt class="corpus-metabox-key" style="margin: 0; font-weight: 600;">
                  <%= k %>
                </dt>
                <dd class="corpus-metabox-val" style="margin: 0; opacity: 0.9;">
                  <%= v.present? ? v : "" %>
                </dd>
              </div>
            <% end %>
          </dl>
        </div>
      </details>
    <% end %>

    
    <div class="corpus-punct-overlay"
         data-corpus-reader-target="punctOverlay"
         data-action="click->corpus-reader#onPunctOverlayClick"
         hidden>
      <div class="corpus-punct-panel"
           data-corpus-reader-target="punctPanel"
           role="dialog"
           aria-label="Punctuation options">
        <div class="corpus-punct-header">
          <div class="corpus-punct-title">Punctuation options</div>
          <div class="corpus-punct-actions">
            <button type="button" class="corpus-btn corpus-btn-ghost" data-action="click->corpus-reader#okPunctMenu" data-corpus-reader-target="punctOkBtn">OK</button>
            <button type="button" class="corpus-btn corpus-btn-ghost" data-action="click->corpus-reader#closePunctMenu" data-corpus-reader-target="punctCloseBtn">✕</button>
          </div>
        </div>

        <div class="corpus-punct-grid">
          <fieldset class="corpus-fieldset preset-box">
            <legend>Preset</legend>
            <label><input type="radio" name="cv_preset" value="source" data-action="change->corpus-reader#setPunctPresetRadio"> Source</label>
            <label><input type="radio" name="cv_preset" value="modern_trad" data-action="change->corpus-reader#setPunctPresetRadio"> Modern CJK (Traditional)</label>
            <label><input type="radio" name="cv_preset" value="modern_prc" data-action="change->corpus-reader#setPunctPresetRadio"> Modern CJK (Simplified / PRC)</label>
            <label><input type="radio" name="cv_preset" value="pure" data-action="change->corpus-reader#setPunctPresetRadio"> Pure classical</label>
            <label><input type="radio" name="cv_preset" value="strip" data-action="change->corpus-reader#setPunctPresetRadio"> Strip</label>
            <label><input type="radio" name="cv_preset" value="custom" data-action="change->corpus-reader#setPunctPresetRadio"> Custom</label>
          </fieldset>

          <fieldset class="corpus-fieldset">
            <legend>Quotes</legend>
            <div class="corpus-subtitle">Family</div>
            <label><input type="radio" name="cv_quote_family" value="corner" data-action="change->corpus-reader#setPunctOptionRadio"> Chinese quotation marks 「」『』</label>
            <label><input type="radio" name="cv_quote_family" value="speech_curly" data-action="change->corpus-reader#setPunctOptionRadio"> Latin speech marks “ ” ‘ ’</label>
            <label><input type="radio" name="cv_quote_family" value="speech_fullwidth" data-action="change->corpus-reader#setPunctOptionRadio"> Chinese speech marks ＂ ＇</label>
            <label><input type="radio" name="cv_quote_family" value="off" data-action="change->corpus-reader#setPunctOptionRadio"> Off</label>

            <div class="corpus-subtitle">Ordering</div>
            <label><input type="radio" name="cv_quote_order" value="trad" data-action="change->corpus-reader#setPunctOptionRadio"> Traditional: 「甲『乙』丙」</label>
            <label><input type="radio" name="cv_quote_order" value="simp" data-action="change->corpus-reader#setPunctOptionRadio"> Simplified: 『甲「乙」丙』</label>

            <label class="corpus-check"><input type="checkbox" data-corpus-reader-target="verticalQuoteFormsChk" data-action="change->corpus-reader#toggleVerticalQuoteForms"> Vertical quote forms (﹁﹂﹃﹄)</label>
          </fieldset>

          <fieldset class="corpus-fieldset">
            <legend>Question / Exclamation</legend>
            <label><input type="radio" name="cv_q" value="keep" data-action="change->corpus-reader#setPunctOptionRadio"> Keep ？</label>
            <label><input type="radio" name="cv_q" value="collapse" data-action="change->corpus-reader#setPunctOptionRadio"> Collapse ? → 。</label>
            <div style="height:6px"></div>
            <label><input type="radio" name="cv_ex" value="keep" data-action="change->corpus-reader#setPunctOptionRadio"> Keep ！</label>
            <label><input type="radio" name="cv_ex" value="collapse" data-action="change->corpus-reader#setPunctOptionRadio"> Collapse ! → 。</label>
          </fieldset>

          <fieldset class="corpus-fieldset">
            <legend>Semicolon / Colon</legend>
            <label><input type="radio" name="cv_semi" value="keep" data-action="change->corpus-reader#setPunctOptionRadio"> Keep ；</label>
            <label><input type="radio" name="cv_semi" value="collapse" data-action="change->corpus-reader#setPunctOptionRadio"> Collapse ; → 。</label>
            <div style="height:6px"></div>
            <label><input type="radio" name="cv_colon" value="keep" data-action="change->corpus-reader#setPunctOptionRadio"> Keep ：</label>
            <label><input type="radio" name="cv_colon" value="collapse" data-action="change->corpus-reader#setPunctOptionRadio"> Collapse : → 。</label>
          </fieldset>

          <fieldset class="corpus-fieldset">
            <legend>Comma</legend>
            <label><input type="radio" name="cv_comma" value="keep" data-action="change->corpus-reader#setPunctOptionRadio"> Use ，</label>
            <label><input type="radio" name="cv_comma" value="dunhao" data-action="change->corpus-reader#setPunctOptionRadio"> Use 、</label>
          </fieldset>

          <fieldset class="corpus-fieldset">
            <legend>Repetition mark</legend>
            <label><input type="radio" name="cv_repeat_mark" value="none" data-action="change->corpus-reader#setRepeatMarkRadio"> No repetition mark (default)</label>
            <label><input type="radio" name="cv_repeat_mark" value="kanji" data-action="change->corpus-reader#setRepeatMarkRadio"> 々 (Horizontal)</label>
            <label><input type="radio" name="cv_repeat_mark" value="vertical" data-action="change->corpus-reader#setRepeatMarkRadio"> 〻 (Vertical)</label>
            <label><input type="radio" name="cv_repeat_mark" value="zhou" data-action="change->corpus-reader#setRepeatMarkRadio"> 二 (Western Zhou-style)</label>
          </fieldset>

        </div>
      </div>
    </div>

<div class="corpus-viewbox" data-corpus-reader-target="viewbox">
      <div class="corpus-textflow"
           data-corpus-reader-target="content"
           data-action="contextmenu->corpus-reader#onContextMenu">
        <%# Ruby markup must be generated server-side so it can use session preferences.
            The helper returns an html_safe buffer, so do NOT escape it. %>
        <%= corpus_text_with_optional_ruby(@text) %>
      </div>
    </div>
  </div>

<% else %>
  <p>Minecraft How did we get here advancement</p>
<% end %>