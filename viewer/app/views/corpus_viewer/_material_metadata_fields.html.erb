<% stimulus_controller = local_assigns.fetch(:stimulus_controller) %>
<% include_author_provided = local_assigns.fetch(:include_author_provided, false) %>

<div class="cv-form-row">
  <label><%= t("corpus_viewer.material_metadata.note") %> <span aria-hidden="true">*</span></label>
  <textarea class="cv-textarea" rows="3" required
            placeholder="<%= t("corpus_viewer.material_metadata.note_placeholder") %>"
            data-<%= stimulus_controller %>-target="materialNote"></textarea>
</div>

<fieldset class="cv-form-row cv-material-provenance">
  <legend><%= t("corpus_viewer.material_metadata.provenance") %> <span aria-hidden="true">*</span></legend>
  <div class="cv-hint"><%= t("corpus_viewer.material_metadata.provenance_hint") %></div>
  <label><input type="checkbox" value="user_made" data-ticket-provenance /> <%= t("corpus_viewer.material_metadata.user_made") %></label>
  <label><input type="checkbox" value="public_domain" data-ticket-provenance /> <%= t("corpus_viewer.material_metadata.public_domain") %></label>
  <label><input type="checkbox" value="historical_source" data-ticket-provenance /> <%= t("corpus_viewer.material_metadata.historical_source") %></label>
  <% if include_author_provided %>
    <label data-companion-material-ticket-target="authorProvidedRow">
      <input type="checkbox" value="author_provided" data-ticket-provenance
             data-companion-material-ticket-target="authorProvided" />
      <%= t("corpus_viewer.material_metadata.author_provided") %>
    </label>
  <% end %>
</fieldset>

<div class="cv-form-row">
  <label><%= t("corpus_viewer.material_metadata.references") %></label>
  <textarea class="cv-textarea" rows="3"
            placeholder="<%= t("corpus_viewer.material_metadata.references_placeholder") %>"
            data-<%= stimulus_controller %>-target="references"></textarea>
  <div class="cv-hint"><%= t("corpus_viewer.material_metadata.references_hint") %></div>
</div>

<details class="cv-form-row">
  <summary><%= t("corpus_viewer.material_metadata.ai_disclosure") %></summary>
  <label><input type="checkbox" data-<%= stimulus_controller %>-target="aiAssisted" /> <%= t("corpus_viewer.material_metadata.ai_assisted") %></label>
  <label><%= t("corpus_viewer.material_metadata.what_assisted") %></label>
  <textarea class="cv-textarea" rows="2"
            placeholder="<%= t("corpus_viewer.material_metadata.ai_details_placeholder") %>"
            data-<%= stimulus_controller %>-target="aiDetails"></textarea>
</details>
