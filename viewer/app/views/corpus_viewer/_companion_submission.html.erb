<% if @companion_submission_enabled %>

  <div class="cv-text-edit-panel cv-companion-submission-panel hidden"
       data-companion-material-ticket-target="panel">
    <h3 style="margin-top:0;"><%= t("corpus_viewer.companion_submission.heading") %></h3>
    <p class="cv-hint"><%= t("corpus_viewer.companion_submission.explanation") %></p>

    <form data-action="submit->companion-material-ticket#submit">
      <div class="cv-form-row">
        <label><%= t("corpus_viewer.companion_submission.material_type") %></label>
        <select class="cv-input"
                data-companion-material-ticket-target="materialType"
                data-action="change->companion-material-ticket#materialTypeChanged">
          <option value="translation"><%= t("corpus_viewer.companion_submission.types.translation") %></option>
          <option value="gallery_image"><%= t("corpus_viewer.companion_submission.types.gallery_image") %></option>
          <option value="exemplar_manuscript"><%= t("corpus_viewer.companion_submission.types.exemplar_manuscript") %></option>
          <option value="variant_text"><%= t("corpus_viewer.companion_submission.types.variant_text") %></option>
        </select>
      </div>

      <div class="cv-form-row">
        <label><%= t("corpus_viewer.companion_submission.optional_label") %></label>
        <input type="text" class="cv-input"
               placeholder="<%= t("corpus_viewer.companion_submission.optional_label_placeholder") %>"
               data-companion-material-ticket-target="materialTitle" />
        <div class="cv-hint"><%= t("corpus_viewer.companion_submission.optional_label_hint") %></div>
      </div>

      <div data-companion-material-ticket-target="translationFields">
        <div class="cv-form-row">
          <label><%= t("corpus_viewer.companion_submission.language") %></label>
          <input type="search" class="cv-input" list="cv-iso-639-3-languages"
                 placeholder="<%= t("corpus_viewer.companion_submission.language_placeholder") %>"
                 autocomplete="off"
                 data-companion-material-ticket-target="languageSearch"
                 data-action="focus->companion-material-ticket#loadLanguages change->companion-material-ticket#languageChanged input->companion-material-ticket#languageChanged" />
          <input type="hidden" data-companion-material-ticket-target="languageCode" />
          <datalist id="cv-iso-639-3-languages" data-companion-material-ticket-target="languageList"></datalist>
          <div class="cv-hint"><%= t("corpus_viewer.companion_submission.language_hint") %></div>
        </div>
        <div class="cv-form-row">
          <label><%= t("corpus_viewer.companion_submission.translator") %></label>
          <input type="text" class="cv-input"
                 placeholder="<%= t("corpus_viewer.companion_submission.translator_placeholder") %>"
                 data-companion-material-ticket-target="translatorName" />
          <div class="cv-hint"><%= t("corpus_viewer.companion_submission.translator_hint") %></div>
        </div>
        <div class="cv-form-row">
          <label><%= t("corpus_viewer.companion_submission.translation_text") %></label>
          <textarea class="cv-textarea cv-mono" rows="18"
                    data-companion-material-ticket-target="bodyText"></textarea>
        </div>
      </div>

      <div data-companion-material-ticket-target="mediaFields" hidden>
        <div class="cv-form-row">
          <label><%= t("corpus_viewer.companion_submission.material_files") %></label>
          <input type="file" class="cv-input" multiple accept="image/png,image/jpeg,application/pdf"
                 data-companion-material-ticket-target="materialFiles" />
          <div class="cv-hint"><%= t("corpus_viewer.companion_submission.material_files_hint") %></div>
        </div>
      </div>

      <div data-companion-material-ticket-target="variantFields" hidden>
        <div class="cv-form-row">
          <label><%= t("corpus_viewer.companion_submission.related_path") %></label>
          <input type="text" class="cv-input cv-mono"
                 placeholder="<%= t("corpus_viewer.companion_submission.related_path_placeholder") %>"
                 data-companion-material-ticket-target="relatedPath" />
        </div>
      </div>

      <div class="cv-form-row">
        <label><%= t("corpus_viewer.companion_submission.material_links") %></label>
        <textarea class="cv-textarea" rows="3"
                  placeholder="<%= t("corpus_viewer.companion_submission.material_links_placeholder") %>"
                  data-companion-material-ticket-target="materialLinks"></textarea>
      </div>

      <div class="cv-form-row">
        <label><%= t("corpus_viewer.companion_submission.ticket_summary") %></label>
        <input type="text" class="cv-input" placeholder="<%= t("corpus_viewer.companion_submission.ticket_summary_placeholder") %>"
               data-companion-material-ticket-target="summary" />
      </div>
      <div class="cv-form-row">
        <label><%= t("corpus_viewer.companion_submission.reviewer_reasoning") %></label>
        <textarea class="cv-textarea" rows="3"
                  placeholder="<%= t("corpus_viewer.companion_submission.reviewer_reasoning_placeholder") %>"
                  data-companion-material-ticket-target="reasoning"></textarea>
      </div>

      <%= render "corpus_viewer/material_metadata_fields",
                 stimulus_controller: "companion-material-ticket",
                 include_author_provided: true %>

      <%= render "corpus_viewer/ticket_optional_fields",
                 stimulus_controller: "companion-material-ticket",
                 include_uploads: true %>

      <div class="cv-form-actions">
        <button type="submit" class="corpus-btn corpus-btn-primary"><%= t("common.actions.submit_ticket") %></button>
        <button type="button" class="corpus-btn" data-action="companion-material-ticket#toggle"><%= t("common.actions.close") %></button>
      </div>
    </form>

    <div class="cv-ticket-result">
      <div class="cv-ticket-status" data-companion-material-ticket-target="status"></div>
      <div class="cv-ticket-kv">
        <div><strong><%= t("common.tickets.ticket_id") %></strong> <span data-companion-material-ticket-target="ticketId"></span></div>
        <div>
          <strong><%= t("common.tickets.ticket_key") %></strong>
          <code data-companion-material-ticket-target="ticketKey"></code>
          <button type="button" class="corpus-btn" data-companion-material-ticket-target="copyKeyBtn" data-action="companion-material-ticket#copyKey"><%= t("common.actions.copy") %></button>
          <button type="button" class="corpus-btn" data-companion-material-ticket-target="downloadKeyBtn" data-action="companion-material-ticket#downloadKey" hidden><%= t("common.actions.download_txt") %></button>
        </div>
      </div>
    </div>
  </div>
<% end %>
