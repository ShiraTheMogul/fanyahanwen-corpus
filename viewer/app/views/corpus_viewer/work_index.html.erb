<h1><%= t("corpus_viewer.title") %></h1>

<p class="crumbs">
  <% if @rel_path.present? %>
    <% parts = @rel_path.to_s.split("/") %>
    <%= link_to t("corpus_viewer.root"), corpus_viewer_path %>
    <% acc = [] %>
    <% parts.each do |part| %>
      <% acc << part %>
      <span class="crumb-sep">/</span>
      <%= link_to part, corpus_viewer_path(acc, format: nil) %>
    <% end %>
  <% end %>
</p>

<% meta_hash = @meta.respond_to?(:to_h) ? @meta.to_h : {} %>
<section class="corpus-work-index">
  <h2><%= meta_hash["Work"].presence || meta_hash["Title"].presence || File.basename(@rel_path.to_s) %></h2>

  <% if @meta.present? %>
    <dl class="corpus-work-index__metadata">
      <% @meta.each do |label, value| %>
        <dt><%= label %></dt>
        <dd><%= value %></dd>
      <% end %>
    </dl>
  <% end %>


  <ul class="corpus-list">
    <% @work_documents.each do |document| %>
      <% label = document.label.presence || File.basename(document.path, ".txt") %>
      <li><%= link_to label, corpus_viewer_path(document.path.split("/"), format: nil) %></li>
    <% end %>
  </ul>

  <% if @work_page.total_pages > 1 %>
    <nav class="corpus-pagination" aria-label="<%= t("corpus_viewer.pagination.work_aria", default: "Work document pages") %>">
      <% if @work_page.page > 1 %>
        <%= link_to "←", corpus_viewer_path(@rel_path.split("/"), format: nil, page: @work_page.page - 1), aria: { label: t("corpus_search.pagination.previous") } %>
      <% end %>
      <span><%= t("corpus_search.pagination.page_of", page: @work_page.page, pages: @work_page.total_pages) %></span>
      <% if @work_page.page < @work_page.total_pages %>
        <%= link_to "→", corpus_viewer_path(@rel_path.split("/"), format: nil, page: @work_page.page + 1), aria: { label: t("corpus_search.pagination.next") } %>
      <% end %>
    </nav>
  <% end %>
</section>
