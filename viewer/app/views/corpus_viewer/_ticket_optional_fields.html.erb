<% stimulus_controller = local_assigns.fetch(:stimulus_controller) %>
<% include_uploads = local_assigns.fetch(:include_uploads, false) %>

<div class="cv-form-row">
  <label><%= t("corpus_viewer.optional_ticket_fields.evidence_links") %></label>
  <textarea class="cv-textarea" rows="3" placeholder="<%= t("corpus_viewer.optional_ticket_fields.evidence_links_placeholder") %>" data-<%= stimulus_controller %>-target="evidenceLinks"></textarea>
  <div class="cv-hint"><%= t("corpus_viewer.optional_ticket_fields.evidence_links_hint") %></div>
</div>

<% if include_uploads %>
  <div class="cv-form-row">
    <label><%= t("corpus_viewer.optional_ticket_fields.evidence_files") %></label>
    <input type="file" class="cv-input" multiple data-<%= stimulus_controller %>-target="uploads" />
    <div class="cv-hint"><%= t("corpus_viewer.optional_ticket_fields.evidence_files_hint") %></div>
  </div>
<% end %>

<details class="cv-form-row">
  <summary><%= t("corpus_viewer.optional_ticket_fields.contact_heading") %></summary>
  <p class="cv-hint"><%= t("corpus_viewer.optional_ticket_fields.contact_hint") %></p>
  <label><%= t("corpus_viewer.optional_ticket_fields.name") %></label>
  <input type="text" class="cv-input" autocomplete="name" data-<%= stimulus_controller %>-target="contactName" />
  <label><%= t("corpus_viewer.optional_ticket_fields.email") %></label>
  <input type="email" class="cv-input" autocomplete="email" data-<%= stimulus_controller %>-target="contactEmail" />
  <label><%= t("corpus_viewer.optional_ticket_fields.contact_note") %></label>
  <textarea class="cv-textarea" rows="2" data-<%= stimulus_controller %>-target="contactNotes"></textarea>
</details>

<div class="cv-form-row">
  <label><input type="checkbox" data-<%= stimulus_controller %>-target="storeOnDevice" /> <%= t("corpus_viewer.optional_ticket_fields.save_key") %></label>
  <div class="cv-hint"><%= t("corpus_viewer.optional_ticket_fields.save_key_hint") %></div>
</div>
