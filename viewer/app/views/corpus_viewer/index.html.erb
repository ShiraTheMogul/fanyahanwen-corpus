<h1><%= t("corpus_viewer.title") %></h1>

<% if @kind == :dir && @rel_path.to_s.split("/").include?("clean") %>
  <span
    data-controller="corpus-submission-ticket"
    data-corpus-submission-ticket-source-value="corpus_viewer"
    data-corpus-submission-ticket-parent-path-value="<%= @rel_path %>"
    data-corpus-submission-ticket-lock-parent-path-value="true">
    <button type="button"
            class="corpus-btn corpus-btn-editing"
            data-action="corpus-submission-ticket#toggle"
            title="<%= t("corpus_viewer.directory_submission.button_title") %>">
      <%= t("corpus_viewer.directory_submission.button") %>
    </button>

<p>
  Unused
</p>
