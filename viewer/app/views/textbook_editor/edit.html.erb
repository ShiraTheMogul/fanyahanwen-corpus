<% content_for :head do %>
  <%= stylesheet_link_tag "textbook" %>
  <%= stylesheet_link_tag "textbook_author" %>
<% end %>

<h1 class="tb-editor-title">Edit lesson: <%= (@lesson && @lesson["title"]).presence || @slug %></h1>

<%= render partial: "form",
           locals: {
             form_action: update_textbook_lesson_path(@slug),
             form_method: :patch,
             submit_label: "Save"
           } %>
