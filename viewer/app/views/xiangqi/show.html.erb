<h1>象棋 Xiangqi<%= image_tag("xiang.png") %></h1>

<% if flash[:alert] %>
  <div class="xq-alert"><%= flash[:alert] %></div>
<% end %>

<div
  class="xq-root"
  data-controller="xiangqi-board"
  data-xiangqi-board-theme-value="<%= @theme %>"
  data-xiangqi-board-side-value="<%= @side_to_move.to_s %>"
>
  <div class="xiangqi-toolbar">
    <button type="button" class="xq-btn <%= @theme == "colour" ? "is-active" : "" %>"
            data-action="click->xiangqi-board#pickTheme" data-theme="colour">
      Colour
    </button>
    <button type="button" class="xq-btn <%= @theme == "mono" ? "is-active" : "" %>"
            data-action="click->xiangqi-board#pickTheme" data-theme="mono">
      Mono
    </button>
    <button type="button" class="xq-btn <%= @theme == "grid" ? "is-active" : "" %>"
            data-action="click->xiangqi-board#pickTheme" data-theme="grid">
      Grid
    </button>

    <span class="xq-spacer"></span>

    <%= button_to "Undo", "/xiangqi/undo",
          form: { data: { turbo: false } },
          class: "xq-btn" %>

    <%= button_to "Reset", "/xiangqi/reset",
          form: { data: { turbo: false } },
          class: "xq-btn" %>
  </div>

  <div class="xq-layout">
    <div class="xq-boardcol">
      <div class="xq-turnbar">
        <% is_red = (@side_to_move.to_s == "red") %>
        <div class="xq-turnbadge <%= is_red ? "is-red" : "is-black" %>">
          <span class="xq-turndot" aria-hidden="true"></span>
          <span class="xq-turnhan"><%= is_red ? "红" : "黑" %></span>
          <span class="xq-turnen"><%= is_red ? "Red" : "Black" %></span>
          <span class="xq-turnsmall">to move</span>
        </div>

        <% if @status && @status != :ok %>
          <div class="xq-statusline">
            <% if @status == :check %><span class="xq-status xq-status-check">check</span><% end %>
            <% if @status == :checkmate %><span class="xq-status xq-status-mate">checkmate</span><% end %>
            <% if @status == :stalemate %><span class="xq-status xq-status-mate">stalemate</span><% end %>
          </div>
        <% end %>
      </div>

      <div class="xq-board-wrap">
        <!-- Pretty board (BabelStone font) -->
        <div class="xq-pretty-wrap <%= @theme == "grid" ? "is-hidden" : "" %>"
             data-xiangqi-board-target="prettyWrap"
             aria-label="Xiangqi board (pretty view)">
          <pre class="xiangqi-board <%= @theme == "mono" ? "theme-mono" : "theme-colour" %>"
               data-xiangqi-board-target="pretty"><%= @board_text %></pre>
          <div class="xq-pretty-overlay"
               data-xiangqi-board-target="overlay"
               aria-hidden="true"></div>
        </div>

        <!-- Grid board (fallback/debug) -->
        <div class="xq-grid <%= @theme == "grid" ? "" : "is-hidden" %>"
             data-xiangqi-board-target="gridWrap"
             aria-label="Xiangqi board (grid view)">
          <div class="xq-top-label"></div>
          <% ("a".."i").each do |file| %>
            <div class="xq-top-label"><%= file %></div>
          <% end %>

          <% 9.downto(0) do |y| %>
            <div class="xq-left-label"><%= y %></div>
            <% 0.upto(8) do |x| %>
              <button
                type="button"
                class="xq-cellbtn"
                data-action="click->xiangqi-board#squareClick"
                data-x="<%= x %>"
                data-y="<%= y %>"
              ><%= @pos.board[y][x] || "." %></button>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="xq-hintline">
        <div class="xq-hint" data-xiangqi-board-target="hint">
          Click a piece to see legal moves. Palace squares are shaded.
        </div>
      </div>
    </div>

    <aside class="xq-side">
      <% iccs_raw_line = session[:xiangqi_moves].to_s.strip %>
      <% iccs_display_line = @moves.map { |m| m["iccs"] }.join(" ") %>
      <% zh_line = @moves.map { |m| m["zh"] }.join(" ") %>

      <div class="xq-moveshead">
        <button type="button" class="xq-btn xq-btn-small"
                data-action="click->xiangqi-board#copy"
                data-copy-text="<%= iccs_raw_line %>">
          Copy ICCS (replay)
        </button>
        <button type="button" class="xq-btn xq-btn-small"
                data-action="click->xiangqi-board#copy"
                data-copy-text="<%= zh_line %>">
          Copy 中文
        </button>
        <button type="button" class="xq-btn xq-btn-small"
                data-action="click->xiangqi-board#copy"
                data-copy-text="<%= @fen %>">
          Copy current FEN
        </button>
      </div>

      <div class="xq-moves" aria-label="Move transcripts">
        <div class="xq-transcripts">
          <div class="xq-box xq-transcript-box">
            <div class="xq-box-head">
              <span class="xq-box-title">ICCS line (replay)</span>
              <button type="button" class="xq-copy"
                      data-action="click->xiangqi-board#copy"
                      data-copy-text="<%= iccs_raw_line %>">⧉</button>
            </div>
            <textarea class="xq-transcript" readonly><%= iccs_raw_line %></textarea>
            <% if iccs_display_line != iccs_raw_line && iccs_display_line.present? %>
              <div class="xq-transcript-sub">
                <button type="button" class="xq-copy"
                        data-action="click->xiangqi-board#copy"
                        data-copy-text="<%= iccs_display_line %>">⧉</button>
                <span class="xq-muted">Copy ICCS with check markers (+/#)</span>
              </div>
            <% end %>
          </div>

          <div class="xq-box xq-transcript-box">
            <div class="xq-box-head">
              <span class="xq-box-title">中文 line</span>
              <button type="button" class="xq-copy"
                      data-action="click->xiangqi-board#copy"
                      data-copy-text="<%= zh_line %>">⧉</button>
            </div>
            <textarea class="xq-transcript" readonly><%= zh_line %></textarea>
          </div>
        </div>

        <details class="xq-details">
          <summary>Detailed ply list</summary>
          <% if @moves.any? %>
            <% @moves.each_with_index do |m, idx| %>
              <div class="xq-move-row">
                <div class="xq-move-no"><%= idx + 1 %>.</div>
                <div class="xq-move-side <%= m["side"] == "red" ? "is-red" : "is-black" %>">
                  <%= m["side"] == "red" ? "红" : "黑" %>
                </div>

                <div class="xq-move-boxes">
                  <div class="xq-box">
                    <div class="xq-box-head">
                      <span class="xq-box-title">ICCS</span>
                      <button type="button" class="xq-copy"
                              data-action="click->xiangqi-board#copy"
                              data-copy-text="<%= m["iccs"] %>">⧉</button>
                    </div>
                    <code class="xq-code"><%= m["iccs"] %></code>
                  </div>

                  <div class="xq-box">
                    <div class="xq-box-head">
                      <span class="xq-box-title">中文</span>
                      <button type="button" class="xq-copy"
                              data-action="click->xiangqi-board#copy"
                              data-copy-text="<%= m["zh"] %>">⧉</button>
                    </div>
                    <code class="xq-code"><%= m["zh"] %></code>
                  </div>

                  <div class="xq-box xq-box-wide">
                    <div class="xq-box-head">
                      <span class="xq-box-title">FEN (after)</span>
                      <button type="button" class="xq-copy"
                              data-action="click->xiangqi-board#copy"
                              data-copy-text="<%= m["fen"] %>">⧉</button>
                    </div>
                    <code class="xq-code xq-code-ellip"><%= m["fen"] %></code>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="xq-muted" style="margin-top: 8px;">No moves yet.</div>
          <% end %>
        </details>
      </div>

      <div class="xq-compose">
        <%= form_with url: "/xiangqi/move", method: :post, data: { turbo: false }, html: { class: "xq-moveform", "data-xiangqi-board-target": "moveForm" } do %>
          <label class="xq-label" for="xq-move"><strong>Move:</strong></label>
          <input id="xq-move"
                 name="move"
                 type="text"
                 class="xq-input"
                 placeholder="h2e2 | 炮二平五 | C8=7 | 炮八平七 砲8平3"
                 data-xiangqi-board-target="moveInput">
          <button type="submit" class="xq-btn">Play</button>
        <% end %>
      </div>

      <div class="xq-meta">
        <div><strong>FEN:</strong> <code class="xq-code xq-code-ellip"><%= @fen %></code></div>

        <div>
          <strong>Last move:</strong>
          <% if @last_move %>
            ICCS <code><%= @last_move["iccs"] %></code>
            <span class="xq-muted">|</span>
            中文 <code><%= @last_move["zh"] %></code>
          <% else %>
            <span class="xq-muted">—</span>
          <% end %>
        </div>
      </div>
    </aside>
  </div>
  
