<h1>
  <% if show_han_ornament? %><%= t("fun.xiangqi.name_han") %> <% end %><%= translated_interface_label("fun.xiangqi.name", ornament_key: "fun.xiangqi.name_han") %><%= image_tag("xiang.png", alt: t("fun.xiangqi.icon_alt")) %>
</h1>

<% if flash[:alert] %>
  <div class="xq-alert"><%= flash[:alert] %></div>
<% end %>

<div
  class="xq-root"
  data-controller="xiangqi-board"
  data-xiangqi-board-theme-value="<%= @theme %>"
  data-xiangqi-board-side-value="<%= @side_to_move.to_s %>"
>
  <div class="xiangqi-toolbar">
    <button type="button" class="xq-btn <%= @theme == "colour" ? "is-active" : "" %>"
            data-action="click->xiangqi-board#pickTheme" data-theme="colour">
      <%= t("fun.xiangqi.themes.colour") %>
    </button>
    <button type="button" class="xq-btn <%= @theme == "mono" ? "is-active" : "" %>"
            data-action="click->xiangqi-board#pickTheme" data-theme="mono">
      <%= t("fun.xiangqi.themes.mono") %>
    </button>
    <button type="button" class="xq-btn <%= @theme == "grid" ? "is-active" : "" %>"
            data-action="click->xiangqi-board#pickTheme" data-theme="grid">
      <%= t("fun.xiangqi.themes.grid") %>
    </button>

    <span class="xq-spacer"></span>

    <%= button_to t("fun.actions.undo"), "/xiangqi/undo",
          form: { data: { turbo: false } },
          class: "xq-btn" %>

    <%= button_to t("fun.actions.reset"), "/xiangqi/reset",
          form: { data: { turbo: false } },
          class: "xq-btn" %>
  </div>

  <div class="xq-layout">
    <div class="xq-boardcol">
      <div class="xq-turnbar">
        <% is_red = (@side_to_move.to_s == "red") %>
        <div class="xq-turnbadge <%= is_red ? "is-red" : "is-black" %>">
          <span class="xq-turndot" aria-hidden="true"></span>
          <% if show_han_ornament? %>
            <span class="xq-turnhan"><%= is_red ? t("fun.xiangqi.sides.red_han") : t("fun.xiangqi.sides.black_han") %></span>
          <% end %>
          <span class="xq-turnen"><%= is_red ? t("fun.xiangqi.sides.red") : t("fun.xiangqi.sides.black") %></span>
          <span class="xq-turnsmall"><%= t("fun.xiangqi.to_move") %></span>
        </div>

        <% if @status && @status != :ok %>
          <div class="xq-statusline">
            <% if @status == :check %><span class="xq-status xq-status-check"><%= t("fun.xiangqi.status.check") %></span><% end %>
            <% if @status == :checkmate %><span class="xq-status xq-status-mate"><%= t("fun.xiangqi.status.checkmate") %></span><% end %>
            <% if @status == :stalemate %><span class="xq-status xq-status-mate"><%= t("fun.xiangqi.status.stalemate") %></span><% end %>
          </div>
        <% end %>
      </div>

      <div class="xq-board-wrap">
        <!-- Pretty board (BabelStone font) -->
        <div class="xq-pretty-wrap <%= @theme == "grid" ? "is-hidden" : "" %>"
             data-xiangqi-board-target="prettyWrap"
             aria-label="<%= t("fun.xiangqi.board.pretty_aria") %>">
          <pre class="xiangqi-board <%= @theme == "mono" ? "theme-mono" : "theme-colour" %>"
               data-xiangqi-board-target="pretty"><%= @board_text %></pre>
          <div class="xq-pretty-overlay"
               data-xiangqi-board-target="overlay"
               aria-hidden="true"></div>
        </div>

        <!-- Grid board (fallback/debug) -->
        <div class="xq-grid <%= @theme == "grid" ? "" : "is-hidden" %>"
             data-xiangqi-board-target="gridWrap"
             aria-label="<%= t("fun.xiangqi.board.grid_aria") %>">
          <div class="xq-top-label"></div>
          <% ("a".."i").each do |file| %>
            <div class="xq-top-label"><%= file %></div>
          <% end %>

          <% 9.downto(0) do |y| %>
            <div class="xq-left-label"><%= y %></div>
            <% 0.upto(8) do |x| %>
              <button
                type="button"
                class="xq-cellbtn"
                data-action="click->xiangqi-board#squareClick"
                data-x="<%= x %>"
                data-y="<%= y %>"
              ><%= @pos.board[y][x] || "." %></button>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="xq-hintline">
        <div class="xq-hint" data-xiangqi-board-target="hint">
          <%= t("fun.xiangqi.board.hint") %>
        </div>
      </div>
    </div>

    <aside class="xq-side">
      <% iccs_raw_line = session[:xiangqi_moves].to_s.strip %>
      <% iccs_display_line = @moves.map { |m| m["iccs"] }.join(" ") %>
      <% zh_line = @moves.map { |m| m["zh"] }.join(" ") %>

      <div class="xq-moveshead">
        <button type="button" class="xq-btn xq-btn-small"
                data-action="click->xiangqi-board#copy"
                data-copy-text="<%= iccs_raw_line %>">
          <%= t("fun.xiangqi.actions.copy_iccs_replay") %>
        </button>
        <button type="button" class="xq-btn xq-btn-small"
                data-action="click->xiangqi-board#copy"
                data-copy-text="<%= zh_line %>">
          <%= t("fun.xiangqi.actions.copy_chinese") %>
        </button>
        <button type="button" class="xq-btn xq-btn-small"
                data-action="click->xiangqi-board#copy"
                data-copy-text="<%= @fen %>">
          <%= t("fun.xiangqi.actions.copy_current_fen") %>
        </button>
      </div>

      <div class="xq-moves" aria-label="<%= t("fun.xiangqi.transcripts.aria_label") %>">
        <div class="xq-transcripts">
          <div class="xq-box xq-transcript-box">
            <div class="xq-box-head">
              <span class="xq-box-title"><%= t("fun.xiangqi.transcripts.iccs_replay") %></span>
              <button type="button" class="xq-copy"
                      aria-label="<%= t("common.actions.copy") %>"
                      data-action="click->xiangqi-board#copy"
                      data-copy-text="<%= iccs_raw_line %>">⧉</button>
            </div>
            <textarea class="xq-transcript" readonly><%= iccs_raw_line %></textarea>
            <% if iccs_display_line != iccs_raw_line && iccs_display_line.present? %>
              <div class="xq-transcript-sub">
                <button type="button" class="xq-copy"
                        aria-label="<%= t("common.actions.copy") %>"
                        data-action="click->xiangqi-board#copy"
                        data-copy-text="<%= iccs_display_line %>">⧉</button>
                <span class="xq-muted"><%= t("fun.xiangqi.transcripts.copy_iccs_markers") %></span>
              </div>
            <% end %>
          </div>

          <div class="xq-box xq-transcript-box">
            <div class="xq-box-head">
              <span class="xq-box-title"><%= t("fun.xiangqi.transcripts.chinese_line") %></span>
              <button type="button" class="xq-copy"
                      aria-label="<%= t("common.actions.copy") %>"
                      data-action="click->xiangqi-board#copy"
                      data-copy-text="<%= zh_line %>">⧉</button>
            </div>
            <textarea class="xq-transcript" readonly><%= zh_line %></textarea>
          </div>
        </div>

        <details class="xq-details">
          <summary><%= t("fun.xiangqi.transcripts.detailed_ply_list") %></summary>
          <% if @moves.any? %>
            <% @moves.each_with_index do |m, idx| %>
              <div class="xq-move-row">
                <div class="xq-move-no"><%= idx + 1 %>.</div>
                <div class="xq-move-side <%= m["side"] == "red" ? "is-red" : "is-black" %>">
                  <%= m["side"] == "red" ? t("fun.xiangqi.sides.red_han") : t("fun.xiangqi.sides.black_han") %>
                </div>

                <div class="xq-move-boxes">
                  <div class="xq-box">
                    <div class="xq-box-head">
                      <span class="xq-box-title">ICCS</span>
                      <button type="button" class="xq-copy"
                              aria-label="<%= t("common.actions.copy") %>"
                              data-action="click->xiangqi-board#copy"
                              data-copy-text="<%= m["iccs"] %>">⧉</button>
                    </div>
                    <code class="xq-code"><%= m["iccs"] %></code>
                  </div>

                  <div class="xq-box">
                    <div class="xq-box-head">
                      <span class="xq-box-title"><%= t("fun.xiangqi.transcripts.chinese_label") %></span>
                      <button type="button" class="xq-copy"
                              aria-label="<%= t("common.actions.copy") %>"
                              data-action="click->xiangqi-board#copy"
                              data-copy-text="<%= m["zh"] %>">⧉</button>
                    </div>
                    <code class="xq-code"><%= m["zh"] %></code>
                  </div>

                  <div class="xq-box xq-box-wide">
                    <div class="xq-box-head">
                      <span class="xq-box-title"><%= t("fun.xiangqi.transcripts.fen_after") %></span>
                      <button type="button" class="xq-copy"
                              aria-label="<%= t("common.actions.copy") %>"
                              data-action="click->xiangqi-board#copy"
                              data-copy-text="<%= m["fen"] %>">⧉</button>
                    </div>
                    <code class="xq-code xq-code-ellip"><%= m["fen"] %></code>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="xq-muted" style="margin-top: 8px;"><%= t("fun.xiangqi.transcripts.no_moves") %></div>
          <% end %>
        </details>
      </div>

      <div class="xq-compose">
        <%= form_with url: "/xiangqi/move", method: :post, data: { turbo: false }, html: { class: "xq-moveform", "data-xiangqi-board-target": "moveForm" } do %>
          <label class="xq-label" for="xq-move"><strong><%= t("fun.xiangqi.move.label") %>:</strong></label>
          <input id="xq-move"
                 name="move"
                 type="text"
                 class="xq-input"
                 placeholder="<%= t("fun.xiangqi.move.placeholder") %>"
                 data-xiangqi-board-target="moveInput">
          <button type="submit" class="xq-btn"><%= t("fun.xiangqi.actions.play_move") %></button>
        <% end %>
      </div>

      <div class="xq-meta">
        <div><strong><%= t("fun.xiangqi.fen") %>:</strong> <code class="xq-code xq-code-ellip"><%= @fen %></code></div>

        <div>
          <strong><%= t("fun.xiangqi.last_move") %>:</strong>
          <% if @last_move %>
            ICCS <code><%= @last_move["iccs"] %></code>
            <span class="xq-muted">|</span>
            <%= t("fun.xiangqi.transcripts.chinese_label") %> <code><%= @last_move["zh"] %></code>
          <% else %>
            <span class="xq-muted">—</span>
          <% end %>
        </div>
      </div>
    </aside>
  </div>
  
  <h2><%= t("fun.xiangqi.font_information") %></h2>
  <p><%= t("fun.xiangqi.font.license_summary") %></p>
  <p>
    <%= link_to "BabelStone Xiangqi", "https://www.babelstone.co.uk/Fonts/Xiangqi.html" %><br>
    <%= link_to t("fun.xiangqi.font.license_link"), "https://www.babelstone.co.uk/Fonts/BabelStoneOFL.txt" %>
  </p>
  <p><%= t("fun.xiangqi.font.copyright") %></p>
  <p><%= t("fun.xiangqi.font.license_notice_html", faq_link: link_to("SIL Open Font License 1.1", "http://scripts.sil.org/OFL")).html_safe %></p>
</div>
