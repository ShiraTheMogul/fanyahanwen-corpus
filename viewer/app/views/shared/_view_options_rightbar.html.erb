<%#
  Shared right sidebar: view options form.

  This partial renders the <form> only; it does NOT call content_for.
  It is used by:
    - app/views/characters/_rightbar.html.erb
    - app/views/corpus_viewer/_rightbar.html.erb

  Corpus Viewer has some specific options relating to text formatting, whilst the dict limits it a bit. 
%>

<%= form_with url: preferences_path, method: :post, local: true,
      data: {
        controller: "preferences",
        action: "submit->preferences#submit change->preferences#autosubmit",
        preferences_current_mandarin_scheme_value: current_mandarin_scheme.to_s,
        preferences_current_cantonese_scheme_value: current_cantonese_scheme.to_s,
        preferences_current_laoguoyin_scheme_value: (respond_to?(:current_laoguoyin_scheme) ? current_laoguoyin_scheme.to_s : "original"),
        preferences_current_ruby_enabled_value: (session[:ruby_enabled] == true ? "1" : "0"),
        preferences_current_ruby_source_value: (session[:ruby_source] || :mandarin).to_s,
        preferences_current_ruby_orientation_value: (session[:ruby_orientation] || :horizontal).to_s,
        preferences_current_ruby_side_value: (session[:ruby_side] || :right).to_s,
        preferences_current_ruby_token_value: (session[:ruby_token] || "").to_s,
        preferences_current_script_mode_value: (session[:script_mode] || :original).to_s,
        preferences_current_han_font_value: (session[:han_font] || HanFonts.default_key).to_s,
        preferences_current_han_font_scope_value: (session[:han_font_scope] || :all).to_s,
        preferences_current_han_font_warn_missing_value: ((session.key?(:han_font_warn_missing) ? session[:han_font_warn_missing] : true) ? "1" : "0")
      } do %>
  <%= hidden_field_tag :return_to, request.fullpath %>

  <details class="rightbar-section rightbar-group" open>
    <summary class="rightbar-summary"><strong><%= t("view_options.phoneticization.heading") %></strong></summary>

    <div class="rightbar-row">
      <label for="mandarin_scheme"><%= t("view_options.phoneticization.mandarin") %></label>
      <%= select_tag :mandarin_scheme,
            options_for_select(
              [
                [t("view_options.phoneticization.original_unihan"), :original],
                *Phoneticization::Converters::MANDARIN_SCHEMES.keys.map do |k|
                  label =
                case k
                when :fanqie
                  t("view_options.phoneticization.fanqie_chinese")
                when :tang
                  t("view_options.phoneticization.tang_pronunciation")
                else
                  k.to_s.tr("_", " ").split.map(&:capitalize).join(" ")
                end
                  [label, k]
                end
              ],
              current_mandarin_scheme
            ),
            class: "rightbar-select" %>
    </div>

    <div class="rightbar-row">
      <label for="cantonese_scheme"><%= t("view_options.phoneticization.cantonese") %></label>
      <%= select_tag :cantonese_scheme,
            options_for_select(
              [
                [t("view_options.phoneticization.original_unihan"), :original],
                *Phoneticization::Converters::CANTONESE_SCHEMES.keys.map do |k|
                  label =
                case k
                when :fanqie
                  t("view_options.phoneticization.fanqie_chinese")
                when :tang
                  t("view_options.phoneticization.tang_pronunciation")
                else
                  k.to_s.tr("_", " ").split.map(&:capitalize).join(" ")
                end
                  [label, k]
                end
              ],
              current_cantonese_scheme
            ),
            class: "rightbar-select" %>
    </div>

    <div class="rightbar-row">
      <label for="laoguoyin_scheme"><%= t("view_options.phoneticization.old_national_pronunciation") %></label>
      <%= select_tag :laoguoyin_scheme,
            options_for_select(
              [
                [t("view_options.phoneticization.original"), :original],
                [t("view_options.phoneticization.latin"), :latin],
                [t("view_options.phoneticization.zhuyin"), :zhuyin],
                [t("view_options.phoneticization.ipa"), :ipa]
              ],
              (respond_to?(:current_laoguoyin_scheme) ? current_laoguoyin_scheme : :original)
            ),
            class: "rightbar-select" %>
    </div>

  </details>

  <details class="rightbar-section rightbar-group" open>
    <summary class="rightbar-summary"><strong><%= t("view_options.ruby.heading") %></strong></summary>

    <% ruby_groups = ViewOptions.ruby_source_groups %>
    <% current_ruby_key = (session[:ruby_source] || :mandarin).to_s %>
    <% current_ruby_family = PronunciationRegistry.ruby_family_for_source(current_ruby_key) || ruby_groups.first&.dig(:key) %>

    <div id="ruby_section"
         data-controller="ruby-source"
         data-ruby-source-groups-value="<%= h(ruby_groups.to_json) %>"
         data-ruby-source-current-value="<%= h(current_ruby_key) %>">
      <div class="rightbar-row">
        <label for="ruby_family"><%= t("view_options.ruby.reading_family") %></label>
        <%= select_tag :ruby_family,
              options_for_select(
                ruby_groups.map { |group| [group[:label], group[:key]] },
                current_ruby_family
              ),
              class: "rightbar-select",
              data: {
                ruby_source_target: "family",
                action: "change->ruby-source#changeFamily"
              } %>
      </div>

      <div class="rightbar-row">
        <label for="ruby_source_choice"><%= t("view_options.ruby.variety_system") %></label>
        <%= select_tag :ruby_source_choice,
              "".html_safe,
              class: "rightbar-select",
              data: {
                ruby_source_target: "source",
                action: "change->ruby-source#changeSource"
              } %>
      </div>

      <%= hidden_field_tag :ruby_source,
            current_ruby_key,
            data: { ruby_source_target: "hidden" } %>
    </div>

    <p class="rightbar-note"><%= t("view_options.ruby.explanation_html") %></p>

    <div class="rightbar-row">
      <label for="ruby_enabled"><%= t("view_options.ruby.show_all") %></label>
      <%= hidden_field_tag :ruby_enabled, "0", id: "ruby_enabled_hidden" %>
      <%= check_box_tag :ruby_enabled, "1",
            (session[:ruby_enabled] == true || session[:ruby_enabled].to_s == "1" || session[:ruby_enabled].to_s == "true") %>
    </div>

    <% _ruby_tokens = (ruby_reading_tokens_for(current_ruby_source) rescue []) %>
    <% if _ruby_tokens.size > 1 %>
      <div class="rightbar-row">
        <label for="ruby_token"><%= t("view_options.ruby.token") %></label>
        <%= select_tag :ruby_token,
              options_for_select(
                [[t("view_options.ruby.auto_first"), ""]] + _ruby_tokens.map { |t| [t, t] },
                (session[:ruby_token] || "").to_s
              ),
              class: "rightbar-select" %>
      </div>
    <% else %>
      <%= hidden_field_tag :ruby_token, "" %>
    <% end %>

    <div class="rightbar-row">
      <label for="ruby_orientation"><%= t("view_options.ruby.layout") %></label>
      <%= select_tag :ruby_orientation,
            options_for_select(
              [[t("view_options.ruby.horizontal"), "horizontal"], [t("view_options.ruby.vertical_side"), "verticalside"]],
              (session[:ruby_orientation] || :horizontal).to_s
            ),
            class: "rightbar-select" %>
    </div>

    <div class="rightbar-row">
      <label for="ruby_side"><%= t("view_options.ruby.side") %></label>
      <%= select_tag :ruby_side,
            options_for_select(
              [[t("view_options.ruby.right"), "right"], [t("view_options.ruby.left"), "left"]],
              (session[:ruby_side] || :right).to_s
            ),
            class: "rightbar-select" %>
    </div>
  </details>

  <details class="rightbar-section rightbar-group" open>
    <summary class="rightbar-summary"><strong><%= t("view_options.script.heading") %></strong></summary>

    <div class="rightbar-row">
      <label for="script_mode"><%= t("view_options.script.convert_text") %></label>
      <%= select_tag :script_mode,
            options_for_select(
              [[t("view_options.script.original"), "original"], [t("view_options.script.traditional"), "traditional"], [t("view_options.script.simplified"), "simplified"]],
              (session[:script_mode] || :original).to_s
            ),
            class: "rightbar-select" %>
    </div>
  </details>

  <details class="rightbar-section rightbar-group" open>
    <summary class="rightbar-summary"><strong><%= t("view_options.font.heading") %></strong></summary>

    <div class="rightbar-row">
      <label for="han_font"><%= t("view_options.font.han_font") %></label>
      <%= select_tag :han_font,
            options_for_select(
              HanFonts.choices,
              (session[:han_font] || HanFonts.default_key).to_s
            ),
            class: "rightbar-select" %>
    </div>

    <div class="rightbar-row">
      <label for="han_font_scope"><%= t("view_options.font.apply_to") %></label>
      <%= select_tag :han_font_scope,
            options_for_select(
              [[t("view_options.font.all_han_text"), "all"], [t("view_options.font.headwords_only"), "headwords"]],
              (session[:han_font_scope] || :all).to_s
            ),
            class: "rightbar-select" %>
    </div>

    <div class="rightbar-row">
      <label for="han_font_warn_missing"><%= t("view_options.font.warn_missing_glyph") %></label>
      <%= hidden_field_tag :han_font_warn_missing, "0", id: "han_font_warn_missing_hidden" %>
      <%= check_box_tag :han_font_warn_missing, "1", (session.key?(:han_font_warn_missing) ? session[:han_font_warn_missing] : true) == true %>
    </div>

    <% font_info = HanFonts.information_for((session[:han_font] || HanFonts.default_key).to_s) %>
    <details class="rightbar-credits">
      <summary><%= t("view_options.font.information") %></summary>
      <pre><%= font_info.presence || t("view_options.font.information_not_found") %></pre>
    </details>

    <div id="han-font-message" class="rightbar-note" aria-live="polite"></div>
  </details>

  <div class="rightbar-section">
    <%= submit_tag t("common.actions.apply"), class: "rightbar-apply" %>
  </div>
<% end %>
