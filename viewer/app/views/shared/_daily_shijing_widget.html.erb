<%# Home-page widget for 今日誦詩 (Daily Shijing). %>
<% payload = daily_shijing_payload %>

<% if payload[:reading].present? %>
  <% reading = payload[:reading] %>

  <section class="daily-shijing-card" aria-label="<%= t("home.daily_shijing.aria_label") %>">
    <div class="daily-shijing-card-header">
      <div class="daily-shijing-card-name"><%= t("home.daily_shijing.name") %></div>
      <% if payload[:display_period].present? %>
        <div class="daily-shijing-card-phase"><%= payload[:display_period] %></div>
      <% end %>
    </div>

    <div class="daily-shijing-card-meta">
      <div class="daily-shijing-card-mao"><%= t("home.daily_shijing.mao_prefix") %><%= reading.order_index %></div>
      <div class="daily-shijing-card-title"><%= reading.title %></div>
    </div>

    <div class="daily-shijing-card-cats">
      <span class="daily-shijing-card-mother"><%= reading.mother %></span>
      <% if reading.subgroup.present? %>
        <span class="daily-shijing-card-sep">·</span>
        <span class="daily-shijing-card-subgroup"><%= reading.subgroup %></span>
      <% end %>
    </div>

    <div class="daily-shijing-card-text"
         data-controller="han-tooltip"
         data-action="click->han-tooltip#click dblclick->han-tooltip#dblclick">
      <pre><%= payload[:text].to_s %></pre>
    </div>

    <div class="daily-shijing-card-footer">
      <%= link_to t("home.daily_shijing.open_in_corpus"),
                  corpus_viewer_path(path: payload[:viewer_path]),
                  class: "daily-shijing-card-link" %>
    </div>
  </section>
<% else %>
  <section class="daily-shijing-card" aria-label="<%= t("home.daily_shijing.aria_label") %>">
    <div class="daily-shijing-card-header">
      <div class="daily-shijing-card-name"><%= t("home.daily_shijing.name") %></div>
    </div>
    <div class="daily-shijing-card-empty"><%= t("home.daily_shijing.unavailable") %></div>
  </section>
<% end %>
