<div class="grammar-page grammar-index">
  <header class="grammar-page-header">
    <div>
      <h1><%= t("grammar.title") %></h1>
      <p><%= t("grammar.index.introduction") %></p>
    </div>

    <div class="grammar-submission-actions">
      <%= link_to t("grammar.index.articles_needed"), "/grammar?needed=1", class: "grammar-btn grammar-btn-secondary" %>
      <%= link_to t("grammar.index.suggest_unlisted"), "/grammar?unlisted=1#suggest-unlisted-article", class: "grammar-btn grammar-btn-secondary" %>
    </div>
  </header>

  <%= form_with url: "/grammar", method: :get, local: true, class: "grammar-filter-form" do %>
    <label>
      <span><%= t("grammar.index.arrange_by") %></span>
      <%= select_tag :sort,
                     options_for_select(Grammar::IndexBuilder::SORTS.map { |value| [t("grammar.sorts.#{value}"), value] }, @sort) %>
    </label>

    <label>
      <span><%= t("grammar.index.entry_type") %></span>
      <%= select_tag :kind,
                     options_for_select([[t("grammar.index.all"), ""]] + Grammar::Entry::KINDS.map { |value| [grammar_kind_label(value), value] }, @kind.to_s) %>
    </label>

    <label>
      <span><%= t("grammar.index.importance") %></span>
      <%= select_tag :importance,
                     options_for_select([[t("grammar.index.all"), ""]] + Grammar::Entry::IMPORTANCE.map { |value| [grammar_importance_label(value), value] }, @importance.to_s) %>
    </label>

    <label>
      <span><%= t("grammar.index.category") %></span>
      <%= select_tag :category,
                     options_for_select([[t("grammar.index.all"), ""]] + @categories.map { |value| [grammar_category_label(value), value] }, @category.to_s) %>
    </label>

    <label class="grammar-checkbox">
      <%= check_box_tag :needed, "1", @needed %>
      <span><%= t("grammar.index.only_needed") %></span>
    </label>

    <%= submit_tag t("grammar.index.apply"), class: "grammar-btn" %>
    <%= link_to t("grammar.index.clear"), "/grammar", class: "grammar-btn grammar-btn-secondary" %>
  <% end %>

  <% if @rows.empty? %>
    <p class="grammar-empty"><%= t("grammar.index.no_entries") %></p>
  <% else %>
    <div class="grammar-index-groups grammar-index-groups--<%= @sort %>">
      <% @groups.each do |group| %>
        <section class="grammar-index-group grammar-index-group--<%= group.type %>">
          <% heading = grammar_index_group_heading(group) %>
          <% if heading.present? %>
            <h2 class="grammar-index-group-heading grammar-index-group-heading--<%= group.type %>"><%= heading %></h2>
          <% end %>

          <div class="grammar-entry-grid">
            <% group.rows.each do |row| %>
              <%= render "entry_card", row: row, sort: @sort %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% end %>

  <% if @show_unlisted_submission %>
    <div id="suggest-unlisted-article">
      <%= render "submission_form", entry: nil, article: nil, unlisted: true %>
    </div>
  <% end %>
</div>
