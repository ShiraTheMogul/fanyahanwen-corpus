<% headword_tile = row.entry.character_hub? %>
<% expandable = headword_tile && row.children.any? %>
<% panel_id = "grammar-use-cases-#{row.entry.id.gsub(/[^a-zA-Z0-9_-]/, "-")}" %>
<% cluster_classes = ["grammar-entry-cluster"] %>
<% cluster_classes << (headword_tile ? "grammar-entry-cluster--headword" : "grammar-entry-cluster--article") %>
<% cluster_classes << "grammar-entry-cluster--expandable" if expandable %>
<% tile_classes = ["grammar-entry-tile"] %>
<% tile_classes << (headword_tile ? "grammar-entry-tile--headword" : "grammar-entry-tile--article") %>
<% tile_classes << "grammar-entry-tile--#{row.entry.kind.tr("_", "-")}" %>

<article class="<%= cluster_classes.join(" ") %>"
         <% if expandable %>data-controller="grammar-entry-expander"<% end %>>
  <% if expandable %>
    <button type="button"
            class="<%= (tile_classes + ["grammar-entry-tile--button"]).join(" ") %>"
            aria-expanded="false"
            aria-controls="<%= panel_id %>"
            data-action="grammar-entry-expander#toggle"
            data-grammar-entry-expander-target="trigger">
      <span class="grammar-entry-tile-primary">
        <span class="grammar-entry-tile-title grammar-entry-tile-title--headword"><%= row.entry.title %></span>
        <% if sort == "pronunciation" && row.pronunciation.present? %>
          <span class="grammar-entry-tile-pronunciation"><%= row.pronunciation %></span>
        <% end %>
      </span>

      <% if sort == "frequency" && !row.corpus_frequency.nil? %>
        <span class="grammar-entry-tile-emphasis"><%= t("grammar.index.corpus_frequency", count: number_with_delimiter(row.corpus_frequency)) %></span>
      <% end %>

      <span class="grammar-entry-tile-footer">
        <span class="grammar-status grammar-status--<%= row.status %>"><%= grammar_status_label(row.status) %></span>
        <span class="grammar-entry-expand-cue">
          <span class="grammar-entry-expand-cue-closed"><%= t("grammar.functions.use_count", count: row.children.length) %></span>
          <span class="grammar-entry-expand-cue-open"><%= t("grammar.functions.hide_uses") %></span>
          <span class="grammar-entry-expand-icon" aria-hidden="true"></span>
        </span>
      </span>
    </button>

    <div id="<%= panel_id %>"
         class="grammar-entry-expansion"
         aria-hidden="true"
         data-grammar-entry-expander-target="panel">
      <div class="grammar-entry-expansion-inner">
        <div class="grammar-use-panel-grid">
          <%= link_to grammar_entry_path_for(row.entry), class: "grammar-use-panel grammar-use-panel--overview" do %>
            <span class="grammar-use-panel-kicker"><%= t("grammar.functions.overview_label") %></span>
            <span class="grammar-use-panel-title"><%= t("grammar.functions.overview", headword: row.entry.headword) %></span>
            <span class="grammar-status grammar-status--<%= row.status %>"><%= grammar_status_label(row.status) %></span>
          <% end %>

          <% row.children.each do |child_row| %>
            <%= link_to grammar_entry_path_for(child_row.entry), class: "grammar-use-panel" do %>
              <span class="grammar-use-panel-kicker"><%= t("grammar.functions.use_label") %></span>
              <span class="grammar-use-panel-title"><%= child_row.entry.title %></span>
              <span class="grammar-status grammar-status--<%= child_row.status %>"><%= grammar_status_label(child_row.status) %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <%= link_to grammar_entry_path_for(row.entry), class: tile_classes.join(" ") do %>
      <span class="grammar-entry-tile-primary">
        <% if headword_tile %>
          <span class="grammar-entry-tile-title grammar-entry-tile-title--headword"><%= row.entry.title %></span>
        <% else %>
          <% if row.entry.kind == "function" && row.entry.headword.present? %>
            <span class="grammar-entry-tile-context"><%= row.entry.headword %></span>
          <% end %>
          <span class="grammar-entry-tile-title grammar-entry-tile-title--article"><%= row.entry.title %></span>
        <% end %>

        <% if sort == "pronunciation" && row.pronunciation.present? %>
          <span class="grammar-entry-tile-pronunciation"><%= row.pronunciation %></span>
        <% end %>
      </span>

      <% if sort == "frequency" && !row.corpus_frequency.nil? %>
        <span class="grammar-entry-tile-emphasis"><%= t("grammar.index.corpus_frequency", count: number_with_delimiter(row.corpus_frequency)) %></span>
      <% end %>

      <span class="grammar-entry-tile-footer">
        <span class="grammar-status grammar-status--<%= row.status %>"><%= grammar_status_label(row.status) %></span>
      </span>
    <% end %>
  <% end %>
</article>
