<% unlisted = local_assigns.fetch(:unlisted, false) %>
<% entry_id = entry&.id.to_s %>
<% published = article&.published? %>
<% show_heading = local_assigns.fetch(:show_heading, true) %>
<% embedded = local_assigns.fetch(:embedded, false) %>
<% snippet_headword = entry&.headword.presence || t("grammar.submission.snippets.search_term_placeholder") %>
<% snippets = {
     quote: "<!-- #{t("grammar.submission.snippets.quote_comment")} -->\n{% corpus_quote path=\"#{t("grammar.submission.snippets.path_placeholder")}\" text=\"#{t("grammar.submission.snippets.text_placeholder")}\" highlight=\"#{t("grammar.submission.snippets.highlight_placeholder")}\" source=\"#{t("grammar.submission.snippets.source_placeholder")}\" %}",
     exact_search: "  # #{t("grammar.submission.snippets.exact_comment")}\n  - mode: exact\n    term_a: \"#{snippet_headword}\"",
     proximity_search: "  # #{t("grammar.submission.snippets.proximity_comment")}\n  - mode: proximity\n    term_a: \"#{snippet_headword}\"\n    term_b: \"#{t("grammar.submission.snippets.second_term_placeholder")}\"\n    distance: 200\n    order: either\n    context: 20"
   } %>
<section class="<%= class_names("grammar-submission", "grammar-submission--embedded": embedded) %>"
         data-controller="grammar-submission"
         data-grammar-submission-entry-id-value="<%= entry_id %>"
         data-grammar-submission-unlisted-value="<%= unlisted %>"
         data-grammar-submission-existing-ids-value="<%= (unlisted ? @unlisted_existing_ids : []).to_json %>"
         data-grammar-submission-templates-value="<%= (unlisted ? @unlisted_templates : {}).to_json %>"
         data-grammar-submission-published-locales-value="<%= @published_locales.to_json %>"
         data-grammar-submission-source-locale-value="<%= Grammar::EntryStore::SOURCE_LOCALE %>"
         data-grammar-submission-submitting-message-value="<%= t("grammar.submission.submitting") %>"
         data-grammar-submission-success-message-value="<%= t("grammar.submission.success") %>"
         data-grammar-submission-error-prefix-value="<%= t("grammar.submission.error_prefix") %>"
         data-grammar-submission-change-language-warning-value="<%= t("grammar.submission.change_language_warning") %>"
         data-grammar-submission-id-available-message-value="<%= t("grammar.submission.unlisted_id_available") %>"
         data-grammar-submission-id-collision-message-value="<%= t("grammar.submission.unlisted_id_collision") %>"
         data-grammar-submission-id-incomplete-message-value="<%= t("grammar.submission.unlisted_id_incomplete") %>"
         data-grammar-submission-snippets-value="<%= snippets.to_json %>">
  <% if show_heading %>
    <h2><%= unlisted ? t("grammar.submission.unlisted_heading") : (published ? t("grammar.submission.edit_heading") : t("grammar.submission.create_heading")) %></h2>
  <% end %>
  <p><%= unlisted ? t("grammar.submission.unlisted_explanation") : t("grammar.submission.explanation") %></p>

  <form action="/grammar/preview"
        method="post"
        target="_blank"
        id="grammar-preview-form-<%= entry_id.presence || "unlisted" %>"
        data-grammar-submission-target="previewForm">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <%= hidden_field_tag :entry_id, entry_id, data: { grammar_submission_target: "previewEntryId" } %>
    <%= hidden_field_tag :unlisted_entry, unlisted ? "1" : "0" %>
    <%= hidden_field_tag :entry_kind, "", data: { grammar_submission_target: "previewEntryKind" } if unlisted %>
    <%= hidden_field_tag :entry_headword, "", data: { grammar_submission_target: "previewEntryHeadword" } if unlisted %>
    <%= hidden_field_tag :entry_title, "", data: { grammar_submission_target: "previewEntryTitle" } if unlisted %>
    <%= hidden_field_tag :entry_parent_id, "", data: { grammar_submission_target: "previewEntryParent" } if unlisted %>
    <%= hidden_field_tag :entry_label, "", data: { grammar_submission_target: "previewEntryLabel" } if unlisted %>
    <%= hidden_field_tag :locale, @submission_locale, data: { grammar_submission_target: "previewLocale" } %>
    <%= hidden_field_tag :raw_markdown, "", data: { grammar_submission_target: "previewMarkdown" } %>
  </form>

  <form data-action="submit->grammar-submission#submit">
    <% if unlisted %>
      <fieldset class="grammar-submission-entry-details">
        <legend><%= t("grammar.submission.unlisted_details") %></legend>
        <div class="grammar-submission-grid">
          <label>
            <span><%= t("grammar.ids.kind") %></span>
            <select data-grammar-submission-target="entryKind"
                    data-action="change->grammar-submission#entryDetailsChanged">
              <% Grammar::Entry::KINDS.each do |kind| %>
                <option value="<%= kind %>"><%= grammar_kind_label(kind) %></option>
              <% end %>
            </select>
          </label>

          <label>
            <span><%= t("grammar.ids.headword") %></span>
            <input type="text"
                   required
                   data-grammar-submission-target="entryHeadword"
                   data-action="input->grammar-submission#entryDetailsChanged">
          </label>

          <label>
            <span><%= t("grammar.submission.unlisted_title") %></span>
            <input type="text"
                   data-grammar-submission-target="entryTitle"
                   data-action="input->grammar-submission#entryDetailsChanged">
          </label>

          <label hidden data-grammar-submission-target="functionParentField">
            <span><%= t("grammar.ids.parent") %></span>
            <select data-grammar-submission-target="entryParent"
                    data-action="change->grammar-submission#entryDetailsChanged">
              <option value=""><%= t("grammar.submission.unlisted_choose_parent") %></option>
              <% @unlisted_parent_options.each do |parent| %>
                <option value="<%= parent.id %>"><%= parent.title %> — <%= parent.id %></option>
              <% end %>
            </select>
          </label>

          <label hidden data-grammar-submission-target="functionLabelField">
            <span><%= t("grammar.ids.label") %></span>
            <input type="text"
                   placeholder="attributive"
                   data-grammar-submission-target="entryLabel"
                   data-action="input->grammar-submission#entryDetailsChanged">
          </label>

          <label>
            <span><%= t("grammar.submission.unlisted_generated_id") %></span>
            <input type="text" readonly data-grammar-submission-target="entryId">
          </label>
        </div>
        <p class="grammar-muted" data-grammar-submission-target="idStatus"></p>
      </fieldset>
    <% end %>

    <div class="grammar-submission-grid">
      <label>
        <span><%= t("grammar.submission.language") %></span>
        <select data-grammar-submission-target="locale"
                data-action="change->grammar-submission#localeChanged">
          <% locales = unlisted ? [Grammar::EntryStore::SOURCE_LOCALE] : InterfaceLocales::ALL %>
          <% locales.each do |locale| %>
            <option value="<%= locale %>" <%= "selected" if locale.to_s == @submission_locale %>>
              <%= InterfaceLocales.native_name(locale) %> [<%= locale %>]
            </option>
          <% end %>
        </select>
      </label>

      <label>
        <span><%= t("grammar.submission.action") %></span>
        <input type="text"
               value="<%= t("grammar.submission.actions.#{@submission_action}") %>"
               readonly
               data-create-label="<%= t("grammar.submission.actions.create") %>"
               data-edit-label="<%= t("grammar.submission.actions.edit") %>"
               data-translate-label="<%= t("grammar.submission.actions.translate") %>"
               data-grammar-submission-target="actionLabel">
        <input type="hidden"
               value="<%= @submission_action %>"
               data-grammar-submission-target="submissionAction">
      </label>

      <label>
        <span><%= t("grammar.submission.public_name") %></span>
        <input type="text" data-grammar-submission-target="publicName">
      </label>

      <label>
        <span><%= t("grammar.submission.orcid") %></span>
        <input type="text"
               placeholder="0000-0002-1825-0097"
               data-grammar-submission-target="orcid">
      </label>

      <label>
        <span><%= t("grammar.submission.credit_role") %></span>
        <select data-grammar-submission-target="creditRole">
          <option value="author"><%= t("grammar.credits.roles.author") %></option>
          <option value="contributor"><%= t("grammar.credits.roles.contributor") %></option>
          <option value="translator"><%= t("grammar.credits.roles.translator") %></option>
          <option value="anonymous"><%= t("grammar.credits.anonymous") %></option>
        </select>
      </label>
    </div>

    <div class="grammar-snippet-tools">
      <div>
        <strong><%= t("grammar.submission.snippets.heading") %></strong>
        <p><%= t("grammar.submission.snippets.explanation") %></p>
      </div>
      <div class="grammar-submission-actions">
        <button type="button"
                class="grammar-btn grammar-btn-secondary"
                data-action="grammar-submission#insertCorpusQuote">
          <%= t("grammar.submission.snippets.quote_button") %>
        </button>
        <button type="button"
                class="grammar-btn grammar-btn-secondary"
                data-action="grammar-submission#insertExactSearch">
          <%= t("grammar.submission.snippets.exact_button") %>
        </button>
        <button type="button"
                class="grammar-btn grammar-btn-secondary"
                data-action="grammar-submission#insertProximitySearch">
          <%= t("grammar.submission.snippets.proximity_button") %>
        </button>
      </div>
      <details class="grammar-snippet-guide">
        <summary><%= t("grammar.submission.snippets.guide_heading") %></summary>
        <dl>
          <div><dt><code>path</code></dt><dd><%= t("grammar.submission.snippets.path_help") %></dd></div>
          <div><dt><code>text</code></dt><dd><%= t("grammar.submission.snippets.text_help") %></dd></div>
          <div><dt><code>highlight</code></dt><dd><%= t("grammar.submission.snippets.highlight_help") %></dd></div>
          <div><dt><code>source</code></dt><dd><%= t("grammar.submission.snippets.source_help") %></dd></div>
          <div><dt><code>term_a</code></dt><dd><%= t("grammar.submission.snippets.term_a_help") %></dd></div>
          <div><dt><code>term_b</code></dt><dd><%= t("grammar.submission.snippets.term_b_help") %></dd></div>
          <div><dt><code>distance</code></dt><dd><%= t("grammar.submission.snippets.distance_help") %></dd></div>
          <div><dt><code>order</code></dt><dd><%= t("grammar.submission.snippets.order_help") %></dd></div>
          <div><dt><code>context</code></dt><dd><%= t("grammar.submission.snippets.context_help") %></dd></div>
        </dl>
      </details>
    </div>

    <label class="grammar-submission-markdown">
      <span><%= t("grammar.submission.markdown") %></span>
      <textarea rows="28"
                spellcheck="true"
                data-grammar-submission-target="rawMarkdown"><%= @submission_markdown %></textarea>
    </label>

    <div class="grammar-submission-actions">
      <button type="button"
              class="grammar-btn grammar-btn-secondary"
              data-action="grammar-submission#preview">
        <%= t("grammar.submission.preview") %>
      </button>
      <% unless unlisted %>
        <%= link_to t("grammar.submission.download_template"),
                    grammar_template_path_for(entry, locale: @submission_locale),
                    class: "grammar-btn grammar-btn-secondary",
                    data: { grammar_submission_target: "downloadTemplate" } %>
      <% end %>
    </div>

    <label>
      <span><%= t("grammar.submission.summary") %></span>
      <input type="text" data-grammar-submission-target="summary">
    </label>

    <label>
      <span><%= t("grammar.submission.reasoning") %></span>
      <textarea rows="4" data-grammar-submission-target="reasoning"></textarea>
    </label>

    <label>
      <span><%= t("grammar.submission.evidence_links") %></span>
      <textarea rows="3"
                placeholder="https://..."
                data-grammar-submission-target="evidenceLinks"></textarea>
    </label>

    <label>
      <span><%= t("grammar.submission.evidence_files") %></span>
      <input type="file" multiple data-grammar-submission-target="uploads">
    </label>

    <details class="grammar-submission-contact">
      <summary><%= t("grammar.submission.contact_heading") %></summary>
      <p><%= t("grammar.submission.contact_explanation") %></p>
      <div class="grammar-submission-grid">
        <label>
          <span><%= t("grammar.submission.contact_name") %></span>
          <input type="text" data-grammar-submission-target="contactName">
        </label>
        <label>
          <span><%= t("grammar.submission.contact_email") %></span>
          <input type="email" data-grammar-submission-target="contactEmail">
        </label>
      </div>
      <label>
        <span><%= t("grammar.submission.contact_notes") %></span>
        <textarea rows="3" data-grammar-submission-target="contactNotes"></textarea>
      </label>
    </details>

    <label class="grammar-checkbox grammar-licence">
      <input type="checkbox" required data-grammar-submission-target="licence">
      <span><%= t("grammar.submission.cc_by_agreement") %></span>
    </label>

    <label class="grammar-checkbox">
      <input type="checkbox" checked data-grammar-submission-target="storeOnDevice">
      <span><%= t("grammar.submission.store_key") %></span>
    </label>

    <button type="submit" class="grammar-btn" data-grammar-submission-target="submit">
      <%= t("grammar.submission.submit") %>
    </button>
  </form>

  <div class="grammar-ticket-result" aria-live="polite">
    <p data-grammar-submission-target="status"></p>
    <dl hidden data-grammar-submission-target="ticketResult">
      <div>
        <dt><%= t("grammar.submission.ticket_id") %></dt>
        <dd><code data-grammar-submission-target="ticketId"></code></dd>
      </div>
      <div>
        <dt><%= t("grammar.submission.ticket_key") %></dt>
        <dd><code data-grammar-submission-target="ticketKey"></code></dd>
      </div>
    </dl>
    <div class="grammar-submission-actions">
      <button type="button"
              class="grammar-btn grammar-btn-secondary"
              hidden
              data-grammar-submission-target="copyKeyBtn"
              data-action="grammar-submission#copyKey">
        <%= t("grammar.submission.copy_key") %>
      </button>
      <button type="button"
              class="grammar-btn grammar-btn-secondary"
              hidden
              data-grammar-submission-target="downloadKeyBtn"
              data-action="grammar-submission#downloadKey">
        <%= t("grammar.submission.download_key") %>
      </button>
    </div>
  </div>
</section>
