<aside class="grammar-character-frame">
  <div class="grammar-character-display">
    <div class="grammar-character-regular"><%= frame.glyph %></div>
    <div class="grammar-character-seal"
         style='font-family:"<%= HanFonts.family_for(:chongxi_seal) %>", serif;'>
      <%= frame.glyph %>
    </div>
  </div>

  <div class="grammar-hanzi-writer"
       data-controller="grammar-hanzi-writer"
       data-grammar-hanzi-writer-glyph-value="<%= frame.glyph %>">
    <div class="grammar-hanzi-writer-canvas"
         data-grammar-hanzi-writer-target="canvas"></div>
    <div class="grammar-hanzi-fallback"
         data-grammar-hanzi-writer-target="fallback"
         hidden>
      <%= t("grammar.character.stroke_unavailable") %>
    </div>
  </div>

  <dl class="grammar-character-facts">
    <div>
      <dt><%= t("grammar.character.codepoint") %></dt>
      <dd><%= frame.codepoint_label %></dd>
    </div>
    <% if frame.radical_membership %>
      <div>
        <dt><%= t("grammar.character.radical") %></dt>
        <dd>
          <%= frame.radical&.radical %>
          <%= frame.radical_membership.radical_number %>
          · <%= t("grammar.index.additional_strokes", count: frame.radical_membership.additional_strokes) %>
        </dd>
      </div>
    <% end %>
  </dl>

  <% if frame.pronunciation_sections.any? %>
    <details class="grammar-frame-section" open>
      <summary><%= t("grammar.character.pronunciations") %></summary>
      <% frame.pronunciation_sections.each do |section| %>
        <details class="grammar-pronunciation-family">
          <summary><%= section[:label] %> (<%= section[:count] %>)</summary>

          <% Array(section[:props]).each do |prop| %>
            <ul class="pronun-section-list">
              <%= render "characters/pronunciation_property", prop: prop, bs_mc_detail_by_source: {} %>
            </ul>
          <% end %>

          <% Array(section[:varieties]).each do |variety| %>
            <details class="grammar-pronunciation-variety">
              <summary><%= variety[:label] %></summary>
              <ul class="pronun-section-list">
                <% Array(variety[:props]).each do |prop| %>
                  <%= render "characters/pronunciation_property", prop: prop, bs_mc_detail_by_source: {} %>
                <% end %>
              </ul>
            </details>
          <% end %>
        </details>
      <% end %>
    </details>
  <% end %>

  <% if frame.variants.any? %>
    <details class="grammar-frame-section">
      <summary><%= t("grammar.character.variants") %></summary>
      <ul>
        <% frame.variants.each do |variant| %>
          <li>
            <%= link_to variant[:label], "/characters/#{ERB::Util.url_encode(variant[:glyph])}" %>
            <small><%= variant[:source] %></small>
          </li>
        <% end %>
      </ul>
    </details>
  <% end %>

  <% if frame.shuowen_entry.present? %>
    <details class="grammar-frame-section">
      <summary><%= t("grammar.character.shuowen") %></summary>
      <%= simple_format(h(view_text(frame.shuowen_entry))) %>
    </details>
  <% end %>

  <% if frame.kangxi_entry.present? %>
    <details class="grammar-frame-section">
      <summary><%= t("grammar.character.kangxi") %></summary>
      <%= simple_format(h(view_text(FieldLens.format_kangxi(frame.kangxi_entry)))) %>
    </details>
  <% end %>

  <%= link_to t("grammar.character.open_dictionary"), frame.dictionary_path, class: "grammar-btn grammar-btn-secondary grammar-dictionary-link" %>
</aside>
