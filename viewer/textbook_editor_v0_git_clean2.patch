@@ -0,0 +1,87 @@
+import { Controller } from "@hotwired/stimulus";
+
+// Authoring UI helpers.
+//
+// This controller is intentionally small:
+// - it adds/removes blocks client-side (so you don't fight YAML)
+// - it can add/remove reveal cards
+// - everything is still submitted as normal HTML form params
+export default class extends Controller {
+  static targets = ["blockList", "newBlockType", "blockTemplate"];
+
+  addBlock() {
+    const type = this.newBlockTypeTarget.value;
+    const index = this._nextBlockIndex();
+    const template = this.blockTemplateTarget.innerHTML
+      .replaceAll("__INDEX__", String(index))
+      .replaceAll("__TYPE__", type);
+
+    this.blockListTarget.insertAdjacentHTML("beforeend", template);
+  }
+
+  removeBlock(event) {
+    const blockEl = event.target.closest(".tb-editor-block");
+    if (!blockEl) return;
+    blockEl.remove();
+  }
+
+  changeType(event) {
+    // For v0, we keep this simple:
+    // type changes require re-adding the block so the right fields appear.
+    // This avoids the UI getting desynchronised from what will be saved.
+    const select = event.target;
+    const blockEl = select.closest(".tb-editor-block");
+    if (!blockEl) return;
+    const index = this._blockIndexFromNames(blockEl) || this._nextBlockIndex();
+    const newType = select.value;
+
+    const template = this.blockTemplateTarget.innerHTML
+      .replaceAll("__INDEX__", String(index))
+      .replaceAll("__TYPE__", newType);
+
+    blockEl.outerHTML = template;
+  }
+
+  addCard(event) {
+    const blockIndex = event.target.getAttribute("data-block-index");
+    if (blockIndex == null) return;
+
+    const blockEl = event.target.closest(".tb-editor-block");
+    if (!blockEl) return;
+    const cardsEl = blockEl.querySelector(".tb-cards");
+    if (!cardsEl) return;
+
+    const next = cardsEl.querySelectorAll(".tb-card").length;
+    const titleName = `lesson[blocks][${blockIndex}][cards][${next}][title]`;
+    const bodyName = `lesson[blocks][${blockIndex}][cards][${next}][body]`;
+
+    cardsEl.insertAdjacentHTML(
+      "beforeend",
+      `
+      <div class="tb-card">
+        <input class="tb-input" type="text" name="${titleName}" placeholder="Card title" />
+        <textarea class="tb-textarea" rows="4" name="${bodyName}" placeholder="Card body"></textarea>
+        <button type="button" class="tb-btn tb-btn-secondary" data-action="textbook-editor#removeCard">Remove card</button>
+      </div>
+      `
+    );
+  }
+
+  removeCard(event) {
+    const cardEl = event.target.closest(".tb-card");
+    if (!cardEl) return;
+    cardEl.remove();
+  }
+
+  _nextBlockIndex() {
+    const blocks = this.blockListTarget.querySelectorAll(".tb-editor-block");
+    return blocks.length;
+  }
+
+  _blockIndexFromNames(blockEl) {
+    const input = blockEl.querySelector("[name^='lesson[blocks]']");
+    if (!input) return null;
+    const m = input.getAttribute("name").match(/lesson\[blocks\]\[(\d+)\]/);
+    return m ? Number.parseInt(m[1], 10) : null;
+  }
+}
