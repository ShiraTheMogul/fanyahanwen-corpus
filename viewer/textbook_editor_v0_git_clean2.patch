+        <option value="text" <%= "selected" if type == "text" %>>text</option>
+        <option value="diagram" <%= "selected" if type == "diagram" %>>diagram</option>
+        <option value="noticing" <%= "selected" if type == "noticing" %>>noticing</option>
+        <option value="reveal" <%= "selected" if type == "reveal" %>>reveal</option>
+        <option value="convert" <%= "selected" if type == "convert" %>>convert</option>
+        <option value="sandbox" <%= "selected" if type == "sandbox" %>>sandbox</option>
+      </select>
