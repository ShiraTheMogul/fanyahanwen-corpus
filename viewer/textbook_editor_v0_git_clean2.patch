+    </div>
+
+    <% if type == "context" %>
+      <div class="tb-form-row">
+        <label class="tb-label">Body</label>
+        <textarea class="tb-textarea" rows="6" name="lesson[blocks][<%= index %>][body]"><%= block["body"].to_s %></textarea>
+        <div class="tb-muted">World-building first. No target-language required here.</div>
