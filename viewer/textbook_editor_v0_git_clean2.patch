diff --git a/app/controllers/textbook_editor_controller.rb b/app/controllers/textbook_editor_controller.rb
new file mode 100644
index 0000000..4a89a81
--- /dev/null
+++ b/app/controllers/textbook_editor_controller.rb
@@ -0,0 +1,132 @@
+class TextbookEditorController < ApplicationController
+  # Minimal authoring UI for textbook lessons.
+  #
+  # Design goal: no YAML editing, no assumed linguistics.
+  # You assemble lessons from reusable blocks (context, text, diagram, convert...).
+
+  def index
+    @lessons = Textbook::LessonStore.all
+  end
+
+  def new
+    @lesson = default_lesson
+    render :edit
+  end
+
+  def edit
+    @lesson = Textbook::LessonStore.find!(params[:slug])
+  end
+
+  def create
+    @lesson = build_lesson_from_params
+    Textbook::LessonStore.write!(@lesson)
+    redirect_to edit_textbook_lesson_path(@lesson["slug"]), notice: "Lesson created."
+  rescue => e
+    flash.now[:alert] = e.message
+    render :edit, status: :unprocessable_entity
+  end
+
+  def update
+    @lesson = build_lesson_from_params
+    @lesson["slug"] = params[:slug]
+    Textbook::LessonStore.write!(@lesson)
+    redirect_to edit_textbook_lesson_path(@lesson["slug"]), notice: "Lesson saved."
+  rescue => e
+    flash.now[:alert] = e.message
+    render :edit, status: :unprocessable_entity
+  end
+
+  # Renders a preview without saving.
+  def preview
+    @lesson = build_lesson_from_params
+    @preview = true
+    render :edit
+  rescue => e
+    flash.now[:alert] = e.message
+    @lesson ||= default_lesson
+    render :edit, status: :unprocessable_entity
+  end
+
+  private
+
+  def default_lesson
+    {
+      "schema_version" => 1,
+      "title" => "Untitled lesson",
+      "slug" => "",
+      "summary" => "",
+      "blocks" => [
+        {
+          "type" => "context",
+          "title" => "Context",
+          "body" => "",
+        }
+      ]
+    }
+  end
+
+  def build_lesson_from_params
+    lp = params.fetch(:lesson, {}).to_unsafe_h
+
+    lesson = {
+      "schema_version" => (lp["schema_version"].presence || 1).to_i,
+      "title" => lp["title"].to_s,
+      "slug" => lp["slug"].to_s,
+      "summary" => lp["summary"].to_s,
+      "blocks" => build_blocks(lp["blocks"])
+    }
+
+    lesson.delete("summary") if lesson["summary"].blank?
+    lesson
+  end
+
+  def build_blocks(blocks_param)
+    blocks_hash = blocks_param.is_a?(Hash) ? blocks_param : {}
+    blocks = blocks_hash.keys.sort_by { |k| k.to_i }.map do |idx|
+      b = blocks_hash[idx].is_a?(Hash) ? blocks_hash[idx] : {}
+      type = b["type"].to_s
+      next if type.blank?
+
+      out = { "type" => type }
+      %w[title prompt body text grid_tsv explain text_ref target_chars].each do |k|
+        out[k] = b[k].to_s if b[k].present?
+      end
+
+      if type == "convert"
+        out["show_profile_picker"] = (b["show_profile_picker"] == "1" || b["show_profile_picker"] == true)
+        out["profiles"] = {
+          "format" => b.dig("profiles", "format").to_s.presence || "arabic_to_han_basic",
+          "parse" => b.dig("profiles", "parse").to_s.presence || "han_to_arabic_basic",
+        }
+        if b["pseudo_keyboard"].present?
+          out["pseudo_keyboard"] = b["pseudo_keyboard"].to_s.split(//).uniq
+        end
+      end
+
+      if type == "sandbox"
+        out["min"] = (b["min"].presence || 1).to_i
+        out["max"] = (b["max"].presence || 99).to_i
+        out["profile"] = b["profile"].to_s.presence || "arabic_to_han_basic"
+        out["parse_profile"] = b["parse_profile"].to_s.presence || "han_to_arabic_basic"
+        out["variants"] = (b["variants"] == "1" || b["variants"] == true)
+        out["allow_you"] = (b["allow_you"] == "1" || b["allow_you"] == true)
+      end
+
+      if type == "reveal"
+        cards = b["cards"].is_a?(Hash) ? b["cards"] : {}
+        out["cards"] = cards.keys.sort_by { |k| k.to_i }.map do |ck|
+          c = cards[ck].is_a?(Hash) ? cards[ck] : {}
+          next if c["body"].to_s.strip.blank?
+          {
+            "title" => c["title"].to_s,
+            "body" => c["body"].to_s,
+          }.compact
+        end.compact
+      end
+
+      out
+    end
+
+    blocks.compact
+  end
+end
diff --git a/app/javascript/controllers/textbook_editor_controller.js b/app/javascript/controllers/textbook_editor_controller.js
