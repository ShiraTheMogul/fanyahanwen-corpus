+  background: rgba(200, 0, 0, 0.08);
+  border-radius: 12px;
+  padding: 0.7rem 0.9rem;
+  margin: 0.8rem 0;
+}
+
+.tb-notice {
+  border: 1px solid rgba(0, 120, 60, 0.28);
+  background: rgba(0, 120, 60, 0.08);
