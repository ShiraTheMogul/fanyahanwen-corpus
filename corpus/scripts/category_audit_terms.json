  "source_category_review_rules": [
    {
      "name": "completion_percentage",
      "classification": "maintenance",
      "action": "review_remove",
      "pattern": "^\\d{1,3}%$",
      "note": "Source-wiki completion percentages such as 25%, 50%, and 75% describe transcription maintenance, not a work subject or genre."
    },
    {
      "name": "public_domain_or_licence_status",
      "classification": "maintenance",
      "action": "review_remove",
      "pattern": "^(?:PD-old(?:-.+)?|.*公有領域.*|.*公共領域.*)$",
      "note": "Copyright/public-domain state belongs in provenance or rights metadata, not a browsable content category."
    },
    {
      "name": "date_or_date_mention",
      "classification": "metadata_redundant",
      "action": "review_remove_if_date_metadata_confirmed",
      "pattern": "^(?:\\d{3,4}年(?:\\s*[（(]提及[)）])?|中華民國.+年(?:.*)?|民國.+年(?:.*)?|宣統.+年(?:.*)?)$",
      "note": "Date-like source categories can be checked against canonical date metadata and removed from category assignments once that metadata is confirmed."
    },
    {
      "name": "category_namespace_leak",
      "classification": "normalization",
      "action": "normalize_then_review",
      "pattern": "^(?:分類|分类|Category):",
      "note": "The MediaWiki category namespace has leaked into the stored label. The audit exposes the suffix separately as a possible normalized category candidate."
    },
    {
      "name": "wiki_maintenance_state",
      "classification": "maintenance",
      "action": "review_remove",
      "pattern": "^(?:(?:分類|分类|Category):)?(?:待完之篇|待譯之篇|待译之篇|求驗|求验|求詳|求详|待新之篇|未用之事|既失之版|未廣佈之版|未广布之版|空商賈之錄|空商贾之录|闕段之文|缺段之文|闕實體棨信|缺实体.*|闕.*|缺.*)$",
      "note": "Source-wiki workflow or missing-content state. Keep for audit provenance if useful, but review for removal from corpus content categorisation."
    },
    {
      "name": "software_or_version_technical",
      "classification": "maintenance",
      "action": "review_remove",
      "pattern": "^(?:(?:分類|分类|Category):)?.*(?:爪哇版|基石版|啟者|启者|快照|測版|测版|伺服端|服务器|教育版|攜帶版|携带版|資囊|资囊|數錄|数录|History模|Al version).*$",
      "note": "Technical/version category inherited from a software-oriented source. Review before treating it as literary subject metadata."
    }
  ]
}
