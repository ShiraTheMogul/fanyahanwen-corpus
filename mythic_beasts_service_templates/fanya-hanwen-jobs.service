[Unit]
Description=Fanya Hanwen Corpus background jobs
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/apps/fanyahanwen-corpus/viewer
EnvironmentFile=%h/.config/fanya-hanwen.env
ExecStart=%h/.local/share/gem/ruby/3.3.0/bin/bundle exec bin/jobs --mode async
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
