[Unit]
Description=Fanya Hanwen Corpus Rails web application
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/apps/fanyahanwen-corpus/viewer
EnvironmentFile=%h/.config/fanya-hanwen.env
ExecStartPre=/usr/bin/rm -f %h/www/www.fanyahanwen-corpus.cn/proxy.sock
ExecStart=%h/.local/share/gem/ruby/3.3.0/bin/bundle exec puma -C config/puma.rb
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
